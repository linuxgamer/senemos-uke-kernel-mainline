From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] usb: dwc3: give Uke gadget budget retries a generation and deadline

Every gadget budget callback creates a generation even if its current equals
the previous value. Serialize replacement with retry scheduling, and use an
absolute deadline including firmware waits rather than counting sleeps alone.
Invalidate pending work for system sleep and removal. Resume requires a new
gadget callback. Keep supplier lifetime links and the existing 500 mA SDP gate.

This is a local gadget-request generation, not proof of an atomic remote
attach/PD contract. Firmware lacks such a token; the hardware race and USB
suspend power behavior remain separate acceptance requirements.
Use the explicit per-CPU workqueue for the current upstream API.

--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -2185,30 +2185,64 @@
 {
 	struct dwc3 *dwc = container_of(to_delayed_work(work), struct dwc3, vbus_draw_work);
 	union power_supply_propval val = {0};
-	unsigned int current_limit = READ_ONCE(dwc->current_limit);
-	unsigned int retries = READ_ONCE(dwc->vbus_draw_retries);
+	unsigned int current_limit, retries;
+	unsigned long flags, deadline;
+	u32 generation;
+	bool uke = of_machine_is_compatible("xiaomi,uke");
 	int ret;
 
+	spin_lock_irqsave(&dwc->vbus_draw_lock, flags);
+	current_limit = dwc->current_limit;
+	retries = dwc->vbus_draw_retries;
+	generation = dwc->vbus_draw_generation;
+	deadline = dwc->vbus_draw_deadline;
+	if (uke && (dwc->vbus_draw_paused || time_after_eq(jiffies, deadline))) {
+		spin_unlock_irqrestore(&dwc->vbus_draw_lock, flags);
+		return;
+	}
+	spin_unlock_irqrestore(&dwc->vbus_draw_lock, flags);
+
+	if (current_limit > INT_MAX / 1000)
+		return;
 	val.intval = 1000 * current_limit;
 	ret = power_supply_set_property(dwc->usb_psy, POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &val);
-	/*
-	 * Enumeration can precede the remote charger. Revalidate every retry in
-	 * the battery driver; never turn an expired SDP budget into a PD request.
-	 * A newer gadget request queues immediate work and must not be delayed.
-	 */
-	if (ret == -EAGAIN && of_machine_is_compatible("xiaomi,uke") &&
-	    current_limit == READ_ONCE(dwc->current_limit) &&
-	    retries < 50) {
-		WRITE_ONCE(dwc->vbus_draw_retries, retries + 1);
+	spin_lock_irqsave(&dwc->vbus_draw_lock, flags);
+	/* A new gadget request is a new generation even at the same current. */
+	if (generation == dwc->vbus_draw_generation && !dwc->vbus_draw_paused &&
+	    ret == -EAGAIN && uke && retries < 50 && time_before(jiffies, deadline)) {
+		dwc->vbus_draw_retries = retries + 1;
 		schedule_delayed_work(&dwc->vbus_draw_work, msecs_to_jiffies(100));
-	} else if (of_machine_is_compatible("xiaomi,uke")) {
-		dev_info(dwc->dev, "USB budget: request=%u mA result=%d retries=%u\n",
-			 current_limit, ret, retries);
+	} else if (uke) {
+		dev_info_ratelimited(dwc->dev,
+			"USB budget: generation=%u request=%u mA result=%d retries=%u\n",
+			generation, current_limit, ret, retries);
 	}
+	spin_unlock_irqrestore(&dwc->vbus_draw_lock, flags);
+}
 
-	if (ret < 0)
-		dev_dbg(dwc->dev, "Error (%d) setting vbus draw (%d mA)\n",
-			ret, current_limit);
+static void dwc3_vbus_draw_pause(struct dwc3 *dwc)
+{
+	unsigned long flags;
+
+	if (!dwc->usb_psy || !of_machine_is_compatible("xiaomi,uke"))
+		return;
+	spin_lock_irqsave(&dwc->vbus_draw_lock, flags);
+	dwc->vbus_draw_paused = true;
+	dwc->vbus_draw_generation++;
+	spin_unlock_irqrestore(&dwc->vbus_draw_lock, flags);
+	cancel_delayed_work_sync(&dwc->vbus_draw_work);
+}
+
+static void dwc3_vbus_draw_resume(struct dwc3 *dwc)
+{
+	unsigned long flags;
+
+	if (!dwc->usb_psy || !of_machine_is_compatible("xiaomi,uke"))
+		return;
+	spin_lock_irqsave(&dwc->vbus_draw_lock, flags);
+	dwc->vbus_draw_paused = false;
+	dwc->vbus_draw_generation++;
+	spin_unlock_irqrestore(&dwc->vbus_draw_lock, flags);
 }
 
 static struct power_supply *dwc3_get_usb_power_supply(struct dwc3 *dwc)
@@ -2234,6 +2268,7 @@
 		power_supply_put(usb_psy);
 		return ERR_PTR(-EINVAL);
 	}
+	spin_lock_init(&dwc->vbus_draw_lock);
 	INIT_DELAYED_WORK(&dwc->vbus_draw_work, dwc3_vbus_draw_work);
 	return usb_psy;
 }
@@ -2440,6 +2475,7 @@
 
 void dwc3_core_remove(struct dwc3 *dwc)
 {
+	dwc3_vbus_draw_pause(dwc);
 	pm_runtime_get_sync(dwc->dev);
 
 	dwc3_core_exit_mode(dwc);
@@ -2506,6 +2542,9 @@
 	int i;
 	int ret;
 
+	if (!PMSG_IS_AUTO(msg))
+		dwc3_vbus_draw_pause(dwc);
+
 	if (!pm_runtime_suspended(dwc->dev) && !PMSG_IS_AUTO(msg)) {
 		dwc->susphy_state = (dwc3_readl(dwc, DWC3_GUSB2PHYCFG(0)) &
 				    DWC3_GUSB2PHYCFG_SUSPHY) ||
@@ -2524,8 +2563,10 @@
 		if (pm_runtime_suspended(dwc->dev))
 			break;
 		ret = dwc3_gadget_suspend(dwc);
-		if (ret)
+		if (ret) {
+			dwc3_vbus_draw_resume(dwc);
 			return ret;
+		}
 		synchronize_irq(dwc->irq_gadget);
 		dwc3_core_exit(dwc);
 		break;
@@ -2562,8 +2603,10 @@
 
 		if (dwc->current_otg_role == DWC3_OTG_ROLE_DEVICE) {
 			ret = dwc3_gadget_suspend(dwc);
-			if (ret)
+			if (ret) {
+				dwc3_vbus_draw_resume(dwc);
 				return ret;
+			}
 			synchronize_irq(dwc->irq_gadget);
 		}
 
@@ -2584,6 +2627,10 @@
 	u32		reg;
 	int		i;
 
+	/* Resume admits a fresh callback, never the old delayed request. */
+	if (!PMSG_IS_AUTO(msg))
+		dwc3_vbus_draw_resume(dwc);
+
 	switch (dwc->current_dr_role) {
 	case DWC3_GCTL_PRTCAP_DEVICE:
 		ret = dwc3_core_init_for_resume(dwc);
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1071,6 +1071,10 @@
  * @vbus_draw_work: Work to set the vbus drawing limit
  * @current_limit: How much current to draw from vbus, in milliAmperes.
  * @vbus_draw_retries: Bounded retries while the Uke charger service starts.
+ * @vbus_draw_lock: Serializes gadget budget generations and retry state.
+ * @vbus_draw_generation: Changes for every gadget request, including equal values.
+ * @vbus_draw_deadline: Absolute deadline for the current Uke request.
+ * @vbus_draw_paused: Prevents a removed or sleeping Uke consumer from retrying.
  * @usb2_phy: pointer to USB2 PHY
  * @usb3_phy: pointer to USB3 PHY
  * @usb2_generic_phy: pointer to array of USB2 PHYs
@@ -1271,6 +1275,10 @@
 	struct delayed_work	vbus_draw_work;
 	unsigned int		current_limit;
 	unsigned int		vbus_draw_retries;
+	spinlock_t		vbus_draw_lock;
+	u32			vbus_draw_generation;
+	unsigned long		vbus_draw_deadline;
+	bool			vbus_draw_paused;
 
 	u32			fladj;
 	u32			ref_clk_per;
--- a/drivers/usb/dwc3/gadget.c
+++ b/drivers/usb/dwc3/gadget.c
@@ -3179,6 +3179,7 @@
 static int dwc3_gadget_vbus_draw(struct usb_gadget *g, unsigned int mA)
 {
 	struct dwc3		*dwc = gadget_to_dwc(g);
+	unsigned long flags;
 
 	if (dwc->usb2_phy && (dwc->usb2_phy->set_power ||
 	    !of_device_is_compatible(dwc->usb2_phy->dev->of_node,
@@ -3188,9 +3189,17 @@
 	if (!dwc->usb_psy)
 		return -EOPNOTSUPP;
 
-	WRITE_ONCE(dwc->current_limit, mA);
-	WRITE_ONCE(dwc->vbus_draw_retries, 0);
+	spin_lock_irqsave(&dwc->vbus_draw_lock, flags);
+	if (dwc->vbus_draw_paused) {
+		spin_unlock_irqrestore(&dwc->vbus_draw_lock, flags);
+		return -EHOSTDOWN;
+	}
+	dwc->current_limit = mA;
+	dwc->vbus_draw_retries = 0;
+	dwc->vbus_draw_generation++;
+	dwc->vbus_draw_deadline = jiffies + 5 * HZ;
-	mod_delayed_work(system_wq, &dwc->vbus_draw_work, 0);
+	mod_delayed_work(system_percpu_wq, &dwc->vbus_draw_work, 0);
+	spin_unlock_irqrestore(&dwc->vbus_draw_lock, flags);
 
 	return 0;
 }
