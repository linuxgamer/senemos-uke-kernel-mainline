+static int qcom_llcc_sm7675_resources(struct platform_device *pdev)
+{
+	struct resource *res;
+	int i;
+
+	/* OEM Cliffs7 has four 2 MiB banks followed by the broadcast window. */
+	for (i = 0; i < 5; i++) {
+		res = platform_get_resource(pdev, IORESOURCE_MEM, i);
+		if (!res || res->start != 0x25000000 + i * SZ_2M ||
+		    resource_size(res) != SZ_2M)
+			return -EINVAL;
+	}
+
+	return platform_get_resource(pdev, IORESOURCE_MEM, 5) ? -EINVAL : 0;
+}
