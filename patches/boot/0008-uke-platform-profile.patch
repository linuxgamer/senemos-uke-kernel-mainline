+	  platform profile ABI. Hardware frequency tables and thermal QoS
+	  constraints retain authority. This does not control charging.
+
 config QCOM_RPMH_UKE
 	bool "Xiaomi Uke downstream RPMh DRV/channel support"
 	depends on QCOM_RPMH=y
