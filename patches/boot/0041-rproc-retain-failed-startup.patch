From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: remoteproc: retain partial startup until early stop succeeds

Keep started transports, firmware resources and the original power reference
until the prepare_stop transaction succeeds. Reuse the normal stop path,
retain the failed subdevice boundary and reject new boots during cleanup.
Legacy startup and attach unwind remain unchanged.

--- a/include/linux/remoteproc.h
+++ b/include/linux/remoteproc.h
@@ -250,6 +250,8 @@
  * @auto_boot: flag to indicate if remote processor should be auto-started
  * @sysfs_read_only: flag to make remoteproc sysfs files read only
  * @subdevs_started: flag to indicate if subdevs have started
+ * @failed_subdev: first subdevice that failed during a retained boot
+ * @boot_cleanup_pending: failed boot still owns resources until stop succeeds
  * @dump_segments: list of segments in the firmware
  * @nb_vdev: number of vdev currently handled by rproc
  * @elf_class: firmware ELF class
@@ -295,6 +297,8 @@
 	bool auto_boot;
 	bool sysfs_read_only;
 	bool subdevs_started;
+	struct rproc_subdev *failed_subdev;
+	bool boot_cleanup_pending;
 	struct list_head dump_segments;
 	int nb_vdev;
 	u8 elf_class;
--- a/drivers/remoteproc/remoteproc_core.c
+++ b/drivers/remoteproc/remoteproc_core.c
@@ -1086,7 +1086,7 @@
 	return ret;
 }
 
-static int rproc_start_subdevices(struct rproc *rproc)
+static int rproc_start_subdevices(struct rproc *rproc, bool retain_on_failure)
 {
 	struct rproc_subdev *subdev;
 	int ret;
@@ -1104,6 +1104,11 @@
 	return 0;
 
 unroll_registration:
+	if (retain_on_failure) {
+		rproc->failed_subdev = subdev;
+		rproc->subdevs_started = true;
+		return ret;
+	}
 	list_for_each_entry_continue_reverse(subdev, &rproc->subdevs, node) {
 		if (subdev->stop)
 			subdev->stop(subdev, true);
@@ -1115,16 +1120,23 @@
 static void rproc_stop_subdevices(struct rproc *rproc, bool crashed)
 {
 	struct rproc_subdev *subdev;
+	bool skip = rproc->failed_subdev != NULL;
 
 	if (!rproc->subdevs_started)
 		return;
 
 	list_for_each_entry_reverse(subdev, &rproc->subdevs, node) {
+		if (skip) {
+			if (subdev == rproc->failed_subdev)
+				skip = false;
+			continue;
+		}
 		if (subdev->stop)
 			subdev->stop(subdev, crashed);
 	}
 
 	rproc->subdevs_started = false;
+	rproc->failed_subdev = NULL;
 }
 
 static void rproc_unprepare_subdevices(struct rproc *rproc)
@@ -1261,6 +1273,8 @@
 }
 EXPORT_SYMBOL(rproc_resource_cleanup);
 
+static int rproc_stop(struct rproc *rproc, bool crashed);
+
 static int rproc_start(struct rproc *rproc, const struct firmware *fw)
 {
 	struct resource_table *loaded_table;
@@ -1303,7 +1317,7 @@
 	}
 
 	/* Start any subdevices for the remote processor */
-	ret = rproc_start_subdevices(rproc);
+	ret = rproc_start_subdevices(rproc, rproc->ops->prepare_stop != NULL);
 	if (ret) {
 		dev_err(dev, "failed to probe subdevices for %s: %d\n",
 			rproc->name, ret);
@@ -1317,6 +1331,17 @@
 	return 0;
 
 stop_rproc:
+	if (rproc->ops->prepare_stop) {
+		int stop_ret = rproc_stop(rproc, true);
+
+		if (stop_ret) {
+			/* Keep DMA, tables and the power reference available for retry. */
+			rproc->boot_cleanup_pending = true;
+			rproc->state = RPROC_CRASHED;
+			return stop_ret;
+		}
+		goto reset_table_ptr;
+	}
 	rproc->ops->stop(rproc);
 unprepare_subdevices:
 	rproc_unprepare_subdevices(rproc);
@@ -1347,7 +1372,7 @@
 	}
 
 	/* Start any subdevices for the remote processor */
-	ret = rproc_start_subdevices(rproc);
+	ret = rproc_start_subdevices(rproc, false);
 	if (ret) {
 		dev_err(dev, "failed to probe subdevices for %s: %d\n",
 			rproc->name, ret);
@@ -1429,8 +1454,11 @@
 	}
 
 	ret = rproc_start(rproc, fw);
-	if (ret)
+	if (ret) {
+		if (rproc->boot_cleanup_pending)
+			return ret;
 		goto clean_up_resources;
+	}
 
 	return 0;
 
@@ -1742,6 +1770,7 @@
 	rproc_unprepare_subdevices(rproc);
 
 	rproc->state = RPROC_OFFLINE;
+	rproc->boot_cleanup_pending = false;
 
 	dev_info(dev, "stopped remote processor %s\n", rproc->name);
 
@@ -1963,6 +1992,10 @@
 	}
 
 	/* skip the boot or attach process if rproc is already powered up */
+	if (rproc->boot_cleanup_pending) {
+		ret = -EBUSY;
+		goto unlock_mutex;
+	}
 	if (atomic_inc_return(&rproc->power) > 1) {
 		ret = 0;
 		goto unlock_mutex;
@@ -1988,7 +2021,7 @@
 	}
 
 downref_rproc:
-	if (ret)
+	if (ret && !rproc->boot_cleanup_pending)
 		atomic_dec(&rproc->power);
 unlock_mutex:
 	mutex_unlock(&rproc->lock);
