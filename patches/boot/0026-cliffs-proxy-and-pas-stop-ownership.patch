-		if (!ret && dtb_ret)
-			ret = dtb_ret;
+static int qcom_pas_prepare_stop(struct rproc *rproc)
+{
+	struct qcom_pas *pas = rproc->priv;
 
-		qcom_pas_unmap_carveout(rproc, pas->dtb_mem_phys, pas->dtb_mem_size);
+	/* Cliffs CDSP must halt before FastRPC clients can lose DMA mappings. */
