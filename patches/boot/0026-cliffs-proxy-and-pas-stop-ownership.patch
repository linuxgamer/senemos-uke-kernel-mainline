-		dtb_ret = qcom_pas_shutdown(pas->dtb_pas_id);
-		if (dtb_ret)
-			dev_err(pas->dev, "failed to shutdown dtb: %d\n", dtb_ret);
+	switch (pas->stop_phase) {
+	case QCOM_PAS_STOP_IDLE:
+		ret = qcom_q6v5_request_stop(&pas->q6v5, pas->sysmon);
+		if (ret == -ETIMEDOUT)
