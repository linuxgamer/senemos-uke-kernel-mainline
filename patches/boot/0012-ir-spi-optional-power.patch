From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] media: rc: ir-spi: honor optional binding power supply and label

Uke's OEM SPI emitter has no software-controlled supply. Use the standard
power-supply property when present and permit the board-wired supply otherwise.
Keep the upstream pulse encoder and LIRC interface.

--- a/drivers/media/rc/ir-spi.c
+++ b/drivers/media/rc/ir-spi.c
@@ -75,15 +75,18 @@ static int ir_spi_tx(struct rc_dev *dev, unsigned int *buffer, unsigned int coun
 	xfer.len = len * sizeof(*tx_buf);
 	xfer.tx_buf = tx_buf;
 
-	ret = regulator_enable(idata->regulator);
-	if (ret)
-		goto err_free_tx_buf;
+	if (idata->regulator) {
+		ret = regulator_enable(idata->regulator);
+		if (ret)
+			goto err_free_tx_buf;
+	}
 
 	ret = spi_sync_transfer(idata->spi, &xfer, 1);
 	if (ret)
 		dev_err(&idata->spi->dev, "unable to deliver the signal\n");
 
-	regulator_disable(idata->regulator);
+	if (idata->regulator)
+		regulator_disable(idata->regulator);
 
 err_free_tx_buf:
 
@@ -130,14 +133,18 @@ static int ir_spi_probe(struct spi_device *spi)
 	int ret;
 	u8 dc;
 	struct ir_spi_data *idata;
+	const char *label;
 
 	idata = devm_kzalloc(dev, sizeof(*idata), GFP_KERNEL);
 	if (!idata)
 		return -ENOMEM;
 
-	idata->regulator = devm_regulator_get(dev, "irda_regulator");
-	if (IS_ERR(idata->regulator))
-		return PTR_ERR(idata->regulator);
+	idata->regulator = devm_regulator_get_optional(dev, "power");
+	if (IS_ERR(idata->regulator)) {
+		if (PTR_ERR(idata->regulator) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(idata->regulator), "IR supply unavailable\n");
+		idata->regulator = NULL;
+	}
 
 	idata->rc = devm_rc_allocate_device(&spi->dev, RC_DRIVER_IR_RAW_TX);
 	if (!idata->rc)
@@ -147,6 +154,8 @@ static int ir_spi_probe(struct spi_device *spi)
 	idata->rc->s_tx_carrier    = ir_spi_set_tx_carrier;
 	idata->rc->s_tx_duty_cycle = ir_spi_set_duty_cycle;
 	idata->rc->device_name	   = "IR SPI";
+	if (!device_property_read_string(dev, "label", &label))
+		idata->rc->device_name = label;
 	idata->rc->driver_name     = IR_SPI_DRIVER_NAME;
 	idata->rc->priv            = idata;
 	idata->spi                 = spi;
--- a/Documentation/devicetree/bindings/leds/irled/ir-spi-led.yaml
+++ b/Documentation/devicetree/bindings/leds/irled/ir-spi-led.yaml
@@ -20,6 +20,10 @@ properties:
   compatible:
     const: ir-spi-led
 
+  label:
+    description: Human-readable name of the infrared transmitter.
+    $ref: /schemas/types.yaml#/definitions/string
+
   reg:
     maxItems: 1
 
