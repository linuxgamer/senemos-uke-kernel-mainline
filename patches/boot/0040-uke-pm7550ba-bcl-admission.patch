+	}
 	ret = devm_mutex_init(bcl->dev, &bcl->lock);
 	if (ret)
 		return ret;
@@ -1347,6 +1420,11 @@
 		return dev_err_probe(&pdev->dev, ret, "Failed to read 'reg' property\n");
 
