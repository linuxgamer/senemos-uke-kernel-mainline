From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] pinctrl: qcom: reuse the Palawan LPASS controller for SM7675

Backport the GPL-2.0-only Palawan driver by Alexandr Zubtsov from
443b31b76d2574b94c435c0a7a00714746aff10c in the pinned Palawan tree.
Uke OEM 94c84aeb and the stock OS3 FDT agree on the selected TX/RX/GPIO12
muxes, 0x1000 stride and per-pin slew bits 11:12. Add the exact SM7675
match; do not claim SM8650 pin-table compatibility. Preserve the original
copyright and algorithm. No pin state is selected by adding this driver.

Source: https://codeberg.org/palawan-mainline/linux/commit/443b31b76d2574b94c435c0a7a00714746aff10c

--- a/Documentation/devicetree/bindings/pinctrl/qcom,sm7675-lpass-lpi-pinctrl.yaml
+++ b/Documentation/devicetree/bindings/pinctrl/qcom,sm7675-lpass-lpi-pinctrl.yaml
@@ -0,0 +1,61 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pinctrl/qcom,sm7675-lpass-lpi-pinctrl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm SM7675 LPASS LPI pin controller
+
+maintainers:
+  - Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
+
+description:
+  The SM7675 LPASS LPI pin controller uses per-pin 0x1000 register strides
+  with slew control in bits 11 and 12 of each pin configuration register.
+  This binding describes GPIO, SoundWire and TDM functions used on Uke.
+
+properties:
+  compatible:
+    const: qcom,sm7675-lpass-lpi-pinctrl
+  reg:
+    maxItems: 1
+  clocks:
+    maxItems: 2
+  clock-names:
+    items:
+      - const: core
+      - const: audio
+
+patternProperties:
+  "-state$":
+    oneOf:
+      - $ref: "#/$defs/pin-state"
+      - patternProperties:
+          "-pins$":
+            $ref: "#/$defs/pin-state"
+        additionalProperties: false
+
+$defs:
+  pin-state:
+    type: object
+    $ref: qcom,lpass-lpi-common.yaml#/$defs/qcom-tlmm-state
+    unevaluatedProperties: false
+    properties:
+      pins:
+        items:
+          pattern: "^gpio([0-9]|1[0-9]|2[0-2])$"
+      function:
+        enum: [gpio, swr_tx_clk, swr_tx_data, swr_rx_clk, swr_rx_data,
+               i2s1_clk, i2s1_ws, i2s1_data]
+
+allOf:
+  - $ref: qcom,lpass-lpi-common.yaml#
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+
+unevaluatedProperties: false
+...
--- a/drivers/pinctrl/qcom/Kconfig
+++ b/drivers/pinctrl/qcom/Kconfig
@@ -62,6 +62,13 @@
 	  Qualcomm Technologies Inc LPASS (Low Power Audio SubSystem) LPI
 	  (Low Power Island) found on the Qualcomm Technologies Inc SoCs.
 
+config PINCTRL_PALAWAN_LPASS_LPI
+	tristate "Qualcomm Palawan and SM7675 LPASS LPI pin controller"
+	depends on ARM64 || COMPILE_TEST
+	depends on PINCTRL_LPASS_LPI
+	help
+	  Pin control for the Palawan/SM7675 LPASS Low Power Island.
+
 config PINCTRL_MILOS_LPASS_LPI
 	tristate "Qualcomm Milos LPASS LPI pin controller driver"
 	depends on ARM64 || COMPILE_TEST
--- a/drivers/pinctrl/qcom/Makefile
+++ b/drivers/pinctrl/qcom/Makefile
@@ -84,5 +84,6 @@
 obj-$(CONFIG_PINCTRL_SM8750) += pinctrl-sm8750.o
 obj-$(CONFIG_PINCTRL_SC8280XP_LPASS_LPI) += pinctrl-sc8280xp-lpass-lpi.o
 obj-$(CONFIG_PINCTRL_LPASS_LPI) += pinctrl-lpass-lpi.o
+obj-$(CONFIG_PINCTRL_PALAWAN_LPASS_LPI) += pinctrl-palawan-lpass-lpi.o
 obj-$(CONFIG_PINCTRL_X1E80100)	+= pinctrl-x1e80100.o
 obj-$(CONFIG_PINCTRL_TLMM_TEST) += tlmm-test.o
--- a/drivers/pinctrl/qcom/pinctrl-palawan-lpass-lpi.c
+++ b/drivers/pinctrl/qcom/pinctrl-palawan-lpass-lpi.c
@@ -0,0 +1,222 @@
