@@ -144,37 +161,42 @@
 static int pmic_glink_altmode_request(struct pmic_glink_altmode *altmode, u32 cmd, u32 arg)
 {
 	struct usbc_write_req req = {};
-	unsigned long left;
+	unsigned long flags, left = 0;
 	int ret;
 
-	/*
-	 * The USBC_CMD_WRITE_REQ ack doesn't identify the request, so wait for
-	 * one ack at a time.
-	 */
 	guard(mutex)(&altmode->lock);
-
+	spin_lock_irqsave(&altmode->event_lock, flags);
+	if (!altmode->online || altmode->stopping || altmode->quarantined) {
+		spin_unlock_irqrestore(&altmode->event_lock, flags);
+		return -ENOTCONN;
+	}
+	reinit_completion(&altmode->pan_ack);
+	altmode->pending = true;
+	altmode->request_error = -EINPROGRESS;
+	spin_unlock_irqrestore(&altmode->event_lock, flags);
 	req.hdr.owner = cpu_to_le32(altmode->owner_id);
 	req.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP);
 	req.hdr.opcode = cpu_to_le32(USBC_CMD_WRITE_REQ);
 	req.cmd = cpu_to_le32(cmd);
 	req.arg = cpu_to_le32(arg);
-
 	ret = pmic_glink_send(altmode->client, &req, sizeof(req));
+	if (!ret)
+		left = wait_for_completion_timeout(&altmode->pan_ack, 5 * HZ);
+	spin_lock_irqsave(&altmode->event_lock, flags);
+	if (!ret)
+		ret = left ? altmode->request_error : -ETIMEDOUT;
 	if (ret) {
-		dev_err(altmode->dev, "failed to send altmode request: %#x (%d)\n", cmd, ret);
-		return ret;
-	}
-
-	left = wait_for_completion_timeout(&altmode->pan_ack, 5 * HZ);
-	if (!left) {
-		dev_err(altmode->dev, "timeout waiting for altmode request ack for: %#x\n", cmd);
-		return -ETIMEDOUT;
+		/* A local generation cannot disambiguate a late wire ACK. */
+		altmode->quarantined = true;
 	}
-
-	return 0;
+	altmode->pending = false;
+	spin_unlock_irqrestore(&altmode->event_lock, flags);
+	if (ret)
+		dev_err_ratelimited(altmode->dev, "PAN request %#x failed: %d; channel quarantined\n", cmd, ret);
+	return ret;
 }
 
