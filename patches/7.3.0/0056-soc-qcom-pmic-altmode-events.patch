+static void pmic_glink_altmode_stop(void *data)
+{
+	struct pmic_glink_altmode *am = data;
+	unsigned long flags;
+	unsigned int i;
+
+	spin_lock_irqsave(&am->event_lock, flags);
+	am->stopping = true;
+	am->generation++;
+	am->request_error = -ESHUTDOWN;
+	am->pending = false;
+	complete_all(&am->pan_ack);
+	spin_unlock_irqrestore(&am->event_lock, flags);
+	disable_work_sync(&am->enable_work);
+	for (i = 0; i < ARRAY_SIZE(am->ports); i++) {
+		struct pmic_glink_altmode_port *port = &am->ports[i];
+		if (!port->altmode)
+			continue;
+		disable_work_sync(&port->work);
+		drm_aux_hpd_bridge_notify(&port->bridge->dev, connector_status_disconnected);
+		if (pmic_glink_altmode_safe(am, port))
+			dev_warn(am->dev, "port %u cleanup indeterminate\n", i);
+	}
