-	pmic_glink_altmode_request(altmode, ALTMODE_PAN_ACK, alt_port->index);
+static void pmic_glink_altmode_queue(struct pmic_glink_altmode_port *port,
+				   struct pmic_glink_altmode_event *event)
+{
+	struct pmic_glink_altmode *am = port->altmode;
+	unsigned long flags;
+
+	spin_lock_irqsave(&am->event_lock, flags);
+	if (am->online && !am->stopping && !am->quarantined) {
+		if (port->count == ALTMODE_EVENT_COUNT) {
+			/* Lost protocol obligations require resynchronization, never coalescing. */
+			port->overflow = true;
+			am->quarantined = true;
+			am->request_error = -EOVERFLOW;
+			am->pending = false;
+			complete_all(&am->pan_ack);
+			dev_err_ratelimited(am->dev, "PAN event queue overflow on port %u\n", port->index);
+		} else {
+			event->generation = am->generation;
+			port->events[(port->head + port->count) % ALTMODE_EVENT_COUNT] = *event;
+			port->count++;
+		}
+		schedule_work(&port->work);
+	}
+	spin_unlock_irqrestore(&am->event_lock, flags);
 }
 
