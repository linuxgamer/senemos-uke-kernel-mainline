+struct pmic_glink_altmode_event {
+	u64 generation;
+	enum typec_orientation orientation;
+	u16 svid;
+	u8 mode, hpd_state, hpd_irq, mux_ctrl;
+	struct usbc_sc8280x_tbt_data tbt_data;
+};
