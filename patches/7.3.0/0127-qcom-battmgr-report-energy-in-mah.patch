+static int qcom_battmgr_bat_energy_uh(struct qcom_battmgr *battmgr,
+				      unsigned int charge_mah, int *val)
+{
+	s64 energy;
+
+	if (!battmgr->status.voltage_now)
+		return -ENODATA;
+
+	energy = div_s64((s64)charge_mah * battmgr->status.voltage_now, 1000);
+	if (energy > INT_MAX)
+		return -ERANGE;
+
+	*val = energy;
+	return 0;
+}
