--- /dev/null
+++ b/drivers/power/supply/qcom_battmgr_uke_control.h
@@ -0,0 +1,713 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/* Included after the common property helpers. No raw firmware ABI is exported. */
+#ifndef QCOM_BATTMGR_UKE_CONTROL_H
+#define QCOM_BATTMGR_UKE_CONTROL_H
+
+#define UKE_CHARGE_LEASE_MAX_NS (30ULL * NSEC_PER_SEC)
+
+static bool qcom_battmgr_uke_current_live(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+
+	return IS_ENABLED(CONFIG_BATTERY_QCOM_BATTMGR_UKE_CURRENT) &&
+		battmgr->control.current_admitted && battmgr->control.current_verified &&
+		battmgr->service_up && !tx->desynced && !tx->suspended && !tx->removing &&
+		ktime_get_boottime_ns() < battmgr->control.current_until_ns &&
+		battmgr->control.current_generation == tx->generation &&
+		battmgr->control.current_firmware == tx->firmware_generation &&
+		battmgr->control.current_source == tx->source_generation;
+}
+
+static bool qcom_battmgr_uke_measurement_live(struct qcom_battmgr *battmgr)
+{
+	u64 now = ktime_get_boottime_ns();
+
+	return battmgr->control.measurement_ns && now >= battmgr->control.measurement_ns &&
+		now - battmgr->control.measurement_ns <= 5ULL * NSEC_PER_SEC &&
+		battmgr->control.measurement_generation == battmgr->transaction.generation &&
+		qcom_battmgr_uke_control_live(battmgr, false);
+}
+
+static bool qcom_battmgr_uke_readback_live(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+
+	return battmgr->control.verified && battmgr->service_up &&
+		!tx->desynced && !tx->suspended && !tx->removing &&
+		ktime_get_boottime_ns() < battmgr->control.verified_until_ns &&
+		battmgr->control.verified_generation == tx->generation &&
+		battmgr->control.verified_firmware == tx->firmware_generation &&
+		battmgr->control.verified_source == tx->source_generation;
+}
+
+static int qcom_battmgr_uke_control_check(struct qcom_battmgr *battmgr)
+{
+	unsigned long flags;
+	bool valid;
+
+	lockdep_assert_held(&battmgr->lock);
+	spin_lock_irqsave(&battmgr->transaction.lock, flags);
+	valid = qcom_battmgr_uke_control_live(battmgr, true);
+	spin_unlock_irqrestore(&battmgr->transaction.lock, flags);
+	return valid ? 0 : -EACCES;
+}
+
+static int qcom_battmgr_uke_control_guard(struct qcom_battmgr *battmgr)
+{
+	const unsigned int props[] = {
+		BATT_HEALTH, BATT_PRESENT, BATT_TEMP, BATT_VOLT_NOW, BATT_CURR_NOW,
+	};
+	s64 current;
+	u64 began = ktime_get_boottime_ns();
+	u32 generation = qcom_battmgr_uke_generation(battmgr);
+	unsigned long flags;
+	unsigned int i;
+	int ret;
+
+	battmgr->control.measurement_ns = 0;
+	ret = qcom_battmgr_uke_control_check(battmgr);
+	if (ret)
+		return ret;
+	for (i = 0; i < ARRAY_SIZE(props); i++) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+						  props[i], 0);
+		if (ret)
+			return ret;
+	}
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE, 0);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_TYPE, 0);
+	if (ret)
+		return ret;
+	current = battmgr->status.current_now;
+	if (current < 0)
+		current = -current;
+	if (generation != qcom_battmgr_uke_generation(battmgr))
+		return -ESTALE;
+	if (battmgr->status.health != POWER_SUPPLY_HEALTH_GOOD || !battmgr->info.present ||
+	    !battmgr->usb.online || battmgr->usb.usb_type != battmgr->control.usb_type ||
+	    (s32)battmgr->status.temperature < battmgr->control.temperature_min ||
+	    (s32)battmgr->status.temperature >= battmgr->control.temperature_max ||
+	    battmgr->status.voltage_now < battmgr->control.voltage_min_uv ||
+	    battmgr->status.voltage_now > battmgr->control.voltage_max_uv ||
+	    current > battmgr->control.current_abs_max_ua)
+		return -ERANGE;
+	ret = qcom_battmgr_uke_control_check(battmgr);
+	if (ret)
+		return ret;
+	spin_lock_irqsave(&battmgr->transaction.lock, flags);
+	if (generation != battmgr->transaction.generation ||
+	    ktime_get_boottime_ns() - began > 5ULL * NSEC_PER_SEC) {
+		ret = -ESTALE;
+	} else {
+		battmgr->control.measured_temperature = (s32)battmgr->status.temperature;
+		battmgr->control.measured_voltage = battmgr->status.voltage_now;
+		battmgr->control.measured_current = battmgr->status.current_now;
+		battmgr->control.measurement_generation = generation;
+		battmgr->control.measurement_ns = began;
+	}
+	spin_unlock_irqrestore(&battmgr->transaction.lock, flags);
+	return ret;
+}
+
+static int qcom_battmgr_uke_current_read(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_property_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_BAT_PROPERTY_GET),
+		.property = cpu_to_le32(12),
+	};
+	u32 generation = qcom_battmgr_uke_generation(battmgr);
+	int ret = qcom_battmgr_uke_control_check(battmgr);
+
+	if (ret)
+		return ret;
+	if (!IS_ENABLED(CONFIG_BATTERY_QCOM_BATTMGR_UKE_CURRENT) || !battmgr->control.current_admitted)
+		return -EOPNOTSUPP;
+	ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+	if (ret)
+		return ret;
+	if (generation != qcom_battmgr_uke_generation(battmgr))
+		return -ESTALE;
+	battmgr->control.current_read_generation = generation;
+	return qcom_battmgr_uke_control_check(battmgr);
+}
+
+static void qcom_battmgr_uke_current_record(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	unsigned long flags;
+
+	spin_lock_irqsave(&tx->lock, flags);
+	battmgr->control.current_generation = tx->generation;
+	battmgr->control.current_firmware = tx->firmware_generation;
+	battmgr->control.current_source = tx->source_generation;
+	battmgr->control.current_verified_ns = ktime_get_boottime_ns();
+	battmgr->control.current_until_ns = battmgr->control.expires_ns;
+	battmgr->control.current_verified = qcom_battmgr_uke_control_live(battmgr, true) &&
+		battmgr->control.current_admitted && tx->generation == battmgr->control.current_read_generation;
+	spin_unlock_irqrestore(&tx->lock, flags);
+}
+
+static int qcom_battmgr_uke_current_apply(struct qcom_battmgr *battmgr, u32 value)
+{
+	struct qcom_battmgr_property_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_BAT_PROPERTY_SET),
+		.property = cpu_to_le32(12),
+		.value = cpu_to_le32(value),
+	};
+	u32 ceiling = 0;
+	unsigned int i;
+	int ret;
+
+	lockdep_assert_held(&battmgr->lock);
+	battmgr->control.current_verified = false;
+	if (!IS_ENABLED(CONFIG_BATTERY_QCOM_BATTMGR_UKE_CURRENT) || !battmgr->control.current_admitted)
+		return -EOPNOTSUPP;
+	ret = qcom_battmgr_uke_control_guard(battmgr);
+	if (ret)
+		return ret;
+	for (i = 0; i < battmgr->control.band_count; i++) {
+		const struct qcom_battmgr_uke_current_band *b = &battmgr->control.bands[i];
+
+		if (battmgr->control.measured_temperature >= b->min_temperature &&
+		    battmgr->control.measured_temperature < b->max_temperature) {
+			if (battmgr->control.measured_voltage > b->voltage_max_uv)
+				return -ERANGE;
+			ceiling = min3(b->current_max_ua, battmgr->control.current_max_ua,
+				       battmgr->control.source_budget_ua);
+			break;
+		}
+	}
+	if (!ceiling || value < battmgr->control.current_min_ua || value > ceiling)
+		return -ERANGE;
+	ret = qcom_battmgr_uke_current_read(battmgr);
+	if (ret)
+		return ret;
+	if (battmgr->control.current_ua != value) {
+		/* An increase is forbidden while the measured battery is discharging. */
+		if (value > battmgr->control.current_ua && battmgr->control.measured_current < 0)
+			return -EAGAIN;
+		ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+		if (ret)
+			return ret;
+		ret = qcom_battmgr_uke_current_read(battmgr);
+		if (ret)
+			return ret;
+		if (battmgr->control.current_ua != value)
+			return -EREMOTEIO;
+	}
+	qcom_battmgr_uke_current_record(battmgr);
+	return battmgr->control.current_verified ? 0 : -ESTALE;
+}
+
+static int qcom_battmgr_uke_threshold_read(struct qcom_battmgr *battmgr)
+{
+	const unsigned int props[] = {
+		BATT_CHG_CTRL_EN, BATT_CHG_CTRL_START_THR, BATT_CHG_CTRL_END_THR,
+	};
+	u32 generation = qcom_battmgr_uke_generation(battmgr);
+	unsigned int i;
+	int ret;
+
+	for (i = 0; i < ARRAY_SIZE(props); i++) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET,
+						  props[i], 0);
+		if (ret)
+			return ret;
+	}
+	if (generation != qcom_battmgr_uke_generation(battmgr))
+		return -ESTALE;
+	if (battmgr->info.charge_ctrl_start > battmgr->info.charge_ctrl_end ||
+	    battmgr->info.charge_ctrl_end > 100)
+		return -ENODATA;
+	battmgr->control.readback_generation = generation;
+	return qcom_battmgr_uke_control_check(battmgr);
+}
+
+static void qcom_battmgr_uke_threshold_record(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	unsigned long flags;
+
+	spin_lock_irqsave(&tx->lock, flags);
+	battmgr->control.verified_generation = tx->generation;
+	battmgr->control.verified_firmware = tx->firmware_generation;
+	battmgr->control.verified_source = tx->source_generation;
+	battmgr->control.verified_ns = ktime_get_boottime_ns();
+	battmgr->control.verified_until_ns = battmgr->control.expires_ns;
+	battmgr->control.verified = qcom_battmgr_uke_control_live(battmgr, true) &&
+		tx->generation == battmgr->control.readback_generation;
+	spin_unlock_irqrestore(&tx->lock, flags);
+}
+
+static int qcom_battmgr_uke_threshold_pair(struct qcom_battmgr *battmgr,
+					 unsigned int start, unsigned int end)
+{
+	struct qcom_battmgr_property_request enable = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_BAT_PROPERTY_SET),
+		.property = cpu_to_le32(BATT_CHG_CTRL_EN + 1),
+		.value = cpu_to_le32(1),
+	};
+	int ret;
+
+	lockdep_assert_held(&battmgr->lock);
+	battmgr->control.verified = false;
+	if (start >= end || end > 100)
+		return -EINVAL;
+	ret = qcom_battmgr_uke_control_guard(battmgr);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_uke_threshold_read(battmgr);
+	if (ret)
+		return ret;
+	/* The standard 0/100 pair disables the reviewed threshold feature.
+	 * Do not emulate unlimited charging with an enabled zero-start hysteresis.
+	 */
+	if (!start && end == 100) {
+		if (battmgr->control.enabled) {
+			if (!battmgr->control.may_enable)
+				return -EOPNOTSUPP;
+			enable.value = cpu_to_le32(0);
+			ret = qcom_battmgr_request(battmgr, &enable, sizeof(enable));
+			if (ret)
+				return ret;
+			ret = qcom_battmgr_uke_threshold_read(battmgr);
+			if (ret)
+				return ret;
+			if (battmgr->control.enabled)
+				return -EREMOTEIO;
+		}
+		qcom_battmgr_uke_threshold_record(battmgr);
+		return battmgr->control.verified ? 0 : -ESTALE;
+	}
+	/* Idempotence is proven by fresh GETs, never by an AP cache. */
+	if (battmgr->control.enabled && battmgr->info.charge_ctrl_start == start &&
+	    battmgr->info.charge_ctrl_end == end) {
+		qcom_battmgr_uke_threshold_record(battmgr);
+		return battmgr->control.verified ? 0 : -ESTALE;
+	}
+	if (!battmgr->control.enabled) {
+		if (!battmgr->control.may_enable)
+			return -EOPNOTSUPP;
+		ret = qcom_battmgr_request(battmgr, &enable, sizeof(enable));
+		if (ret)
+			return ret;
+		ret = qcom_battmgr_uke_threshold_read(battmgr);
+		if (ret)
+			return ret;
+		if (!battmgr->control.enabled)
+			return -EREMOTEIO;
+	}
+	ret = qcom_battmgr_uke_control_guard(battmgr);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_set_charge_control(battmgr, end, end - start);
+	if (ret)
+		return ret;
+	/* An opaque 0x48 ACK is not success: all three settings must read back. */
+	ret = qcom_battmgr_uke_threshold_read(battmgr);
+	if (ret)
+		return ret;
+	if (!battmgr->control.enabled || battmgr->info.charge_ctrl_start != start ||
+	    battmgr->info.charge_ctrl_end != end)
+		return -EREMOTEIO;
+	qcom_battmgr_uke_threshold_record(battmgr);
+	return battmgr->control.verified ? 0 : -ESTALE;
+}
+
+static int qcom_battmgr_uke_standard_threshold(struct qcom_battmgr *battmgr,
+					      int value, bool start)
+{
+	unsigned int first, last;
+	int ret;
+
+	if (value < 0 || value > 100)
+		return -EINVAL;
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_uke_control_check(battmgr);
+	if (!ret)
+		ret = qcom_battmgr_uke_threshold_read(battmgr);
+	if (!ret) {
+		first = start ? value : battmgr->control.enabled ?
+			battmgr->info.charge_ctrl_start : battmgr->control.fallback_start;
+		last = start ? (battmgr->control.enabled ? battmgr->info.charge_ctrl_end : 100) : value;
+		if (!start && value == 100 && !battmgr->control.enabled)
+			first = 0;
+		ret = qcom_battmgr_uke_threshold_pair(battmgr, first, last);
+	}
+	battmgr->control.last_error = ret;
+	if (ret)
+		battmgr->control.verified = false;
+	mutex_unlock(&battmgr->lock);
+	if (!ret)
+		power_supply_changed(battmgr->bat_psy);
+	return ret;
+}
+
+static int qcom_battmgr_uke_control_get_property(struct power_supply *psy,
+					       enum power_supply_property prop,
+					       union power_supply_propval *value)
+{
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+	unsigned long flags;
+	int ret = 0;
+
+	if (prop == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT) {
+		mutex_lock(&battmgr->lock);
+		spin_lock_irqsave(&battmgr->transaction.lock, flags);
+		if (!battmgr->control.standard_clients || !qcom_battmgr_uke_current_live(battmgr) ||
+		    !qcom_battmgr_uke_control_live(battmgr, false))
+			ret = -ENODATA;
+		else
+			value->intval = battmgr->control.current_ua;
+		spin_unlock_irqrestore(&battmgr->transaction.lock, flags);
+		mutex_unlock(&battmgr->lock);
+		return ret;
+	}
+	if (prop != POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD &&
+	    prop != POWER_SUPPLY_PROP_CHARGE_CONTROL_END_THRESHOLD)
+		return qcom_battmgr_bat_get_property(psy, prop, value);
+	mutex_lock(&battmgr->lock);
+	spin_lock_irqsave(&battmgr->transaction.lock, flags);
+	if (!qcom_battmgr_uke_readback_live(battmgr) || !battmgr->control.standard_clients ||
+	    !qcom_battmgr_uke_control_live(battmgr, false))
+		ret = -ENODATA;
+	else
+		value->intval = prop == POWER_SUPPLY_PROP_CHARGE_CONTROL_START_THRESHOLD ?
+			(battmgr->control.enabled ? battmgr->info.charge_ctrl_start : 0) :
+			(battmgr->control.enabled ? battmgr->info.charge_ctrl_end : 100);
+	spin_unlock_irqrestore(&battmgr->transaction.lock, flags);
+	mutex_unlock(&battmgr->lock);
+	return ret;
+}
+
+static int qcom_battmgr_uke_control_set_property(struct power_supply *psy,
+					       enum power_supply_property prop,
+					       const union power_supply_propval *value)
+{
+	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
+	int ret;
+
+	if (prop != POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT)
+		return qcom_battmgr_bat_set_property(psy, prop, value);
+	if (value->intval <= 0)
+		return -EINVAL;
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_uke_current_apply(battmgr, value->intval);
+	battmgr->control.last_error = ret;
+	mutex_unlock(&battmgr->lock);
+	if (!ret)
+		power_supply_changed(battmgr->bat_psy);
+	return ret;
+}
+
+static int qcom_battmgr_uke_control_is_writeable(struct power_supply *psy,
+					       enum power_supply_property prop)
+{
+	if (prop == POWER_SUPPLY_PROP_CONSTANT_CHARGE_CURRENT)
+		return IS_ENABLED(CONFIG_BATTERY_QCOM_BATTMGR_UKE_CURRENT);
+	return qcom_battmgr_bat_is_writeable(psy, prop);
+}
+
+static ssize_t uke_charge_state_show(struct device *dev, struct device_attribute *attr, char *buf)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	unsigned long flags;
+	ssize_t len;
+
+	mutex_lock(&battmgr->lock);
+	spin_lock_irqsave(&tx->lock, flags);
+	len = sysfs_emit(buf, "1 %u %u %u %u %u %llu %llu %u %u %u %u %llu %d %u %s "
+		"%u %u %u %u %llu %d %u %d %llu %u %llu\n",
+		IS_ENABLED(CONFIG_BATTERY_QCOM_BATTMGR_UKE_THRESHOLDS),
+		qcom_battmgr_uke_control_live(battmgr, false), tx->generation,
+		tx->firmware_generation, tx->source_generation, tx->instance_ns,
+		battmgr->control.expires_ns, battmgr->control.enabled,
+		battmgr->info.charge_ctrl_start, battmgr->info.charge_ctrl_end,
+		qcom_battmgr_uke_readback_live(battmgr), battmgr->control.verified_ns,
+		battmgr->control.last_error, battmgr->control.standard_clients,
+		battmgr->control.evidence[0] ? battmgr->control.evidence : "none",
+		IS_ENABLED(CONFIG_BATTERY_QCOM_BATTMGR_UKE_CURRENT), battmgr->control.current_admitted,
+		battmgr->control.current_ua, qcom_battmgr_uke_current_live(battmgr),
+		battmgr->control.current_verified_ns, battmgr->control.measured_temperature,
+		battmgr->control.measured_voltage, battmgr->control.measured_current,
+		battmgr->control.measurement_ns, qcom_battmgr_uke_measurement_live(battmgr),
+		battmgr->control.invalidation_ns);
+	spin_unlock_irqrestore(&tx->lock, flags);
+	mutex_unlock(&battmgr->lock);
+	return len;
+}
+static DEVICE_ATTR_RO(uke_charge_state);
+
+static int qcom_battmgr_uke_control_split(const char *buf, size_t count,
+					 char *data, size_t size, char **words, size_t capacity)
+{
+	char *cursor, *part;
+	size_t n = 0;
+
+	if (!count || count >= size || memchr(buf, 0, count))
+		return -EINVAL;
+	memcpy(data, buf, count);
+	data[count] = 0;
+	cursor = data;
+	while ((part = strsep(&cursor, " \t\r\n"))) {
+		if (!*part)
+			continue;
+		if (n == capacity)
+			return -EINVAL;
+		words[n++] = part;
+	}
+	return n;
+}
+
+static int qcom_battmgr_uke_control_words(const char *buf, size_t count,
+					 char *data, size_t size, char **words, size_t needed)
+{
+	int n = qcom_battmgr_uke_control_split(buf, count, data, size, words, needed);
+
+	return n == needed ? 0 : -EINVAL;
+}
+
+static ssize_t uke_charge_lease_store(struct device *dev, struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	unsigned long flags;
+	unsigned long long instance, expires, reviewed;
+	u32 generation, firmware, source, ack, usb, enable, standard, vmin, vmax, imax, resume;
+	char data[512], *word[18];
+	int tmin, tmax, ret = 0;
+	u64 now;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	mutex_lock(&battmgr->lock);
+	now = ktime_get_boottime_ns();
+	if (sysfs_streq(buf, "revoke")) {
+		if (battmgr->control.owner && task_tgid(current) != battmgr->control.owner)
+			ret = -EBUSY;
+		else {
+			put_pid(battmgr->control.owner);
+			battmgr->control.owner = NULL;
+			battmgr->control.expires_ns = 0;
+		}
+		goto out;
+	}
+	if (qcom_battmgr_uke_control_words(buf, count, data, sizeof(data), word, ARRAY_SIZE(word)) ||
+	    strcmp(word[0], "1") || kstrtoull(word[1], 10, &instance) ||
+	    kstrtou32(word[2], 10, &generation) || kstrtou32(word[3], 10, &firmware) ||
+	    kstrtou32(word[4], 10, &source) || kstrtoull(word[5], 10, &expires) ||
+	    kstrtou32(word[6], 10, &ack) || kstrtou32(word[7], 10, &usb) ||
+	    kstrtou32(word[8], 10, &enable) || kstrtou32(word[9], 10, &standard) ||
+	    kstrtoint(word[10], 10, &tmin) || kstrtoint(word[11], 10, &tmax) ||
+	    kstrtou32(word[12], 10, &vmin) || kstrtou32(word[13], 10, &vmax) ||
+	    kstrtou32(word[14], 10, &imax) || kstrtou32(word[15], 10, &resume) || resume >= 80 ||
+	    strlen(word[16]) != 64 || strspn(word[16], "0123456789abcdef") != 64 ||
+	    kstrtoull(word[17], 10, &reviewed) || !reviewed || reviewed > now ||
+	    expires <= now || expires - now > UKE_CHARGE_LEASE_MAX_NS ||
+	    ack < sizeof(struct pmic_glink_hdr) || ack > sizeof(struct qcom_battmgr_message) ||
+	    usb == POWER_SUPPLY_USB_TYPE_UNKNOWN || usb > POWER_SUPPLY_USB_TYPE_APPLE_BRICK_ID ||
+	    enable > 1 || standard > 1 || tmin >= tmax || !vmin || vmin >= vmax ||
+	    vmax > INT_MAX || !imax || imax > INT_MAX) {
+		ret = -EINVAL;
+		goto out;
+	}
+	spin_lock_irqsave(&tx->lock, flags);
+	if (!IS_ENABLED(CONFIG_BATTERY_QCOM_BATTMGR_UKE_THRESHOLDS) ||
+	    battmgr->variant != QCOM_BATTMGR_UKE)
+		ret = -EOPNOTSUPP;
+	else if (reviewed <= battmgr->control.invalidation_ns ||
+		 instance != tx->instance_ns || generation != tx->generation ||
+		 firmware != tx->firmware_generation || source != tx->source_generation ||
+		 !battmgr->service_up || tx->desynced || tx->suspended || tx->removing)
+		ret = -ESTALE;
+	else if (battmgr->control.owner && task_tgid(current) != battmgr->control.owner &&
+		 now < battmgr->control.expires_ns)
+		ret = -EBUSY;
+	if (!ret) {
+		if (task_tgid(current) != battmgr->control.owner ||
+		    strcmp(battmgr->control.evidence, word[16]) ||
+		    battmgr->control.instance_ns != instance ||
+		    battmgr->control.firmware_generation != firmware ||
+		    battmgr->control.source_generation != source) {
+			battmgr->control.current_admitted = false;
+			battmgr->control.current_verified = false;
+			battmgr->control.verified = false;
+		}
+		put_pid(battmgr->control.owner);
+		battmgr->control.owner = get_task_pid(current, PIDTYPE_TGID);
+		battmgr->control.instance_ns = instance;
+		battmgr->control.firmware_generation = firmware;
+		battmgr->control.source_generation = source;
+		battmgr->control.expires_ns = expires;
+		battmgr->control.reviewed_ns = reviewed;
+		battmgr->control.ack_bytes = ack;
+		battmgr->control.usb_type = usb;
+		battmgr->control.may_enable = enable;
+		battmgr->control.standard_clients = standard;
+		battmgr->control.temperature_min = tmin;
+		battmgr->control.temperature_max = tmax;
+		battmgr->control.voltage_min_uv = vmin;
+		battmgr->control.voltage_max_uv = vmax;
+		battmgr->control.current_abs_max_ua = imax;
+		battmgr->control.fallback_start = resume;
+		strscpy(battmgr->control.evidence, word[16], sizeof(battmgr->control.evidence));
+	}
+	spin_unlock_irqrestore(&tx->lock, flags);
+out:
+	mutex_unlock(&battmgr->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(uke_charge_lease);
+
+static ssize_t uke_charge_thresholds_store(struct device *dev, struct device_attribute *attr,
+					   const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	u32 start, end;
+	char data[64], *word[2];
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (qcom_battmgr_uke_control_words(buf, count, data, sizeof(data), word, ARRAY_SIZE(word)) ||
+	    kstrtou32(word[0], 10, &start) || kstrtou32(word[1], 10, &end))
+		return -EINVAL;
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_uke_threshold_pair(battmgr, start, end);
+	battmgr->control.last_error = ret;
+	if (ret)
+		battmgr->control.verified = false;
+	mutex_unlock(&battmgr->lock);
+	if (!ret)
+		power_supply_changed(battmgr->bat_psy);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(uke_charge_thresholds);
+
+static ssize_t uke_charge_refresh_store(struct device *dev, struct device_attribute *attr,
+					const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	mutex_lock(&battmgr->lock);
+	battmgr->control.verified = false;
+	battmgr->control.current_verified = false;
+	ret = qcom_battmgr_uke_control_guard(battmgr);
+	if (!ret)
+		ret = qcom_battmgr_uke_threshold_read(battmgr);
+	if (!ret && battmgr->control.current_admitted) {
+		ret = qcom_battmgr_uke_current_read(battmgr);
+		if (!ret)
+			qcom_battmgr_uke_current_record(battmgr);
+	}
+	if (!ret)
+		qcom_battmgr_uke_threshold_record(battmgr);
+	if (!ret && !battmgr->control.verified)
+		ret = -ESTALE;
+	battmgr->control.last_error = ret;
+	mutex_unlock(&battmgr->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(uke_charge_refresh);
+
+static ssize_t uke_charge_current_profile_store(struct device *dev, struct device_attribute *attr,
+					       const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	struct qcom_battmgr_uke_current_band bands[8];
+	u32 minimum, maximum, budget, n;
+	char data[1024], *word[38];
+	unsigned int i;
+	int words, ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (!IS_ENABLED(CONFIG_BATTERY_QCOM_BATTMGR_UKE_CURRENT))
+		return -EOPNOTSUPP;
+	words = qcom_battmgr_uke_control_split(buf, count, data, sizeof(data), word, ARRAY_SIZE(word));
+	if (words < 10 || strcmp(word[0], "1") || strlen(word[1]) != 64 ||
+	    strspn(word[1], "0123456789abcdef") != 64 ||
+	    kstrtou32(word[2], 10, &minimum) || kstrtou32(word[3], 10, &maximum) ||
+	    kstrtou32(word[4], 10, &budget) || kstrtou32(word[5], 10, &n) ||
+	    !n || n > ARRAY_SIZE(bands) || words != 6 + 4 * n ||
+	    !minimum || minimum > maximum || maximum > INT_MAX ||
+	    budget < minimum || budget > maximum)
+		return -EINVAL;
+	for (i = 0; i < n; i++) {
+		struct qcom_battmgr_uke_current_band *b = &bands[i];
+
+		if (kstrtos32(word[6 + 4 * i], 10, &b->min_temperature) ||
+		    kstrtos32(word[7 + 4 * i], 10, &b->max_temperature) ||
+		    kstrtou32(word[8 + 4 * i], 10, &b->current_max_ua) ||
+		    kstrtou32(word[9 + 4 * i], 10, &b->voltage_max_uv) ||
+		    b->min_temperature >= b->max_temperature ||
+		    (i && b->min_temperature < bands[i - 1].max_temperature) ||
+		    b->current_max_ua > maximum ||
+		    (b->current_max_ua && b->current_max_ua < minimum))
+			return -EINVAL;
+	}
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_uke_control_check(battmgr);
+	if (!ret && task_tgid(current) != battmgr->control.owner)
+		ret = -EBUSY;
+	if (!ret && (strcmp(word[1], battmgr->control.evidence) ||
+		     maximum > battmgr->control.current_abs_max_ua))
+		ret = -EINVAL;
+	for (i = 0; !ret && i < n; i++) {
+		if (bands[i].min_temperature < battmgr->control.temperature_min ||
+		    bands[i].max_temperature > battmgr->control.temperature_max ||
+		    bands[i].voltage_max_uv <= battmgr->control.voltage_min_uv ||
+		    bands[i].voltage_max_uv > battmgr->control.voltage_max_uv)
+			ret = -EINVAL;
+	}
+	if (!ret) {
+		memcpy(battmgr->control.bands, bands, n * sizeof(bands[0]));
+		battmgr->control.band_count = n;
+		battmgr->control.current_min_ua = minimum;
+		battmgr->control.current_max_ua = maximum;
+		battmgr->control.source_budget_ua = budget;
+		battmgr->control.current_verified = false;
+		battmgr->control.current_admitted = true;
+	}
+	mutex_unlock(&battmgr->lock);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(uke_charge_current_profile);
+
+static ssize_t uke_charge_current_ua_store(struct device *dev, struct device_attribute *attr,
+					  const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	u32 value;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (kstrtou32(buf, 10, &value) || !value || value > INT_MAX)
+		return -EINVAL;
+	mutex_lock(&battmgr->lock);
+	ret = qcom_battmgr_uke_current_apply(battmgr, value);
+	battmgr->control.last_error = ret;
+	mutex_unlock(&battmgr->lock);
+	if (!ret)
+		power_supply_changed(battmgr->bat_psy);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(uke_charge_current_ua);
+
+#endif
