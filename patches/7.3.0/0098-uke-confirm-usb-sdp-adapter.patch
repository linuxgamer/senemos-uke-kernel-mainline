From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] power: supply: qcom_battmgr: confirm the Uke SDP adapter

The exact Uke OS3.0.304.0 charger frontend queries USB_ADAP_TYPE wire 7
before its ICL SET. Require a fresh SDP adapter observation in addition to
the existing wire-6, source-generation and current-limit checks. Keep the
existing legacy wire-6 interpretation separate; unknown adapters retry only
within the existing bounded window, and other adapters remain refused.

Compare MiCode uke-v-oss 5712080a4b0c0b1a879e6d145c601c649ddaddfd,
qti_battery_charger.c usb_psy_set_icl and the exact stock module frontend.
This narrows the existing gate; it does not qualify zero-current, electrical
USB suspend, wet response or the separate XM actuator.

--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -316,6 +316,7 @@
 	unsigned int current_now;
 	unsigned int current_max;
 	unsigned int current_limit;
+	u32 adapter_type;
 	u32 moisture_enabled, moisture_status;
 	unsigned int usb_type;
 	/* Raw legacy USB wire6 observation; not OEM adapter wire7/XM real_type. */
@@ -1450,7 +1451,9 @@
 				       const union power_supply_propval *val)
 {
 	struct qcom_battmgr *battmgr = power_supply_get_drvdata(psy);
-	const unsigned int properties[] = { USB_ONLINE, USB_TYPE, USB_CURR_MAX };
+	const unsigned int properties[] = {
+		USB_ONLINE, USB_TYPE, USB_ADAP_TYPE, USB_CURR_MAX,
+	};
 	u32 generation;
 	int ret;
 	unsigned int i;
@@ -1478,15 +1481,17 @@
 	/* This first path admits the configured USB2 SDP budget only. */
 	if (!battmgr->usb.online ||
 	    battmgr->usb.usb_type == POWER_SUPPLY_USB_TYPE_UNKNOWN ||
-	    !battmgr->usb.current_max) {
+	    !battmgr->usb.adapter_type || !battmgr->usb.current_max) {
 		ret = -EAGAIN;
 		goto out;
 	}
 	if (battmgr->usb.usb_type != POWER_SUPPLY_USB_TYPE_SDP ||
+	    battmgr->usb.adapter_type != POWER_SUPPLY_USB_TYPE_SDP ||
 	    (unsigned int)val->intval > battmgr->usb.current_max) {
 		dev_info_ratelimited(battmgr->dev,
-			 "SDP budget refused: type=%u source=%u request=%d uA\n",
-			 battmgr->usb.usb_type, battmgr->usb.current_max, val->intval);
+			 "SDP budget refused: type=%u adapter=%u source=%u request=%d uA\n",
+			 battmgr->usb.usb_type, battmgr->usb.adapter_type,
+			 battmgr->usb.current_max, val->intval);
 		ret = -EINVAL;
 		goto out;
 	}
@@ -2087,6 +2092,9 @@
 		case USB_INPUT_CURR_LIMIT:
 			battmgr->usb.current_limit = le32_to_cpu(resp->intval.value);
 			break;
+		case USB_ADAP_TYPE:
+			battmgr->usb.adapter_type = le32_to_cpu(resp->intval.value);
+			break;
 		case USB_TYPE:
 			if (battmgr->variant == QCOM_BATTMGR_UKE) {
 				battmgr->usb.type_raw = le32_to_cpu(resp->intval.value);
