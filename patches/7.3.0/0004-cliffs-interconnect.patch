+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/interconnect/qcom,cliffs-rpmh.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Cliffs RPMh USB interconnects
+
+maintainers:
+  - Uke Linux contributors
+
+description: |
+  The Xiaomi Uke USB2 peripheral path uses these Cliffs Network-on-Chip
+  providers for DWC3 and WCD939x control I2C bandwidth votes.
+
+properties:
+  compatible:
+    enum:
+      - qcom,cliffs-aggre1_noc
+      - qcom,cliffs-clk_virt
+      - qcom,cliffs-cnoc_main
+      - qcom,cliffs-system_noc
+      - qcom,cliffs-cnoc_cfg
+      - qcom,cliffs-gem_noc
+      - qcom,cliffs-mc_virt
+
+required:
+  - compatible
+
+allOf:
+  - $ref: qcom,rpmh-common.yaml#
+
+unevaluatedProperties: false
+
+additionalProperties: true
+...
