+	for (i = 0; i < UCSI_BUF_V1_SIZE + sizeof(u32); i++)
+		KUNIT_EXPECT_EQ(test, ucsi_glink_decode_read(packet, i, 0, &size, &error), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ucsi_glink_decode_read(packet, UCSI_BUF_V1_SIZE + 4, 0, &size, &error), 0);
+	KUNIT_EXPECT_EQ(test, size, (size_t)UCSI_BUF_V1_SIZE);
+	KUNIT_EXPECT_EQ(test, ucsi_glink_decode_read(packet, UCSI_BUF_V2_SIZE + 4,
+						  UCSI_VERSION_2_0, &size, &error), 0);
+	KUNIT_EXPECT_EQ(test, size, (size_t)UCSI_BUF_V2_SIZE);
+	KUNIT_EXPECT_EQ(test, ucsi_glink_decode_read(packet, sizeof(packet), 0, &size, &error), -EPROTO);
+	KUNIT_EXPECT_EQ(test, ucsi_glink_decode_read(packet, UCSI_BUF_V1_SIZE + 4,
+						  UCSI_VERSION_2_0, &size, &error), -EPROTO);
+	put_unaligned_le32(0x12345678, packet + UCSI_BUF_V1_SIZE);
+	KUNIT_EXPECT_EQ(test, ucsi_glink_decode_read(packet, UCSI_BUF_V1_SIZE + 4, 0, &size, &error), -EREMOTEIO);
+	KUNIT_EXPECT_EQ(test, error, (u32)0x12345678);
+	for (i = 0; i < 4; i++)
+		KUNIT_EXPECT_EQ(test, ucsi_glink_decode_write(packet, i, &error), -EPROTO);
+	put_unaligned_le32(0x12345678, packet);
+	KUNIT_EXPECT_EQ(test, ucsi_glink_decode_write(packet, 4, &error), -EREMOTEIO);
+	KUNIT_EXPECT_EQ(test, error, (u32)0x12345678);
+	KUNIT_EXPECT_EQ(test, ucsi_glink_decode_write(packet, 5, &error), -EPROTO);
+	put_unaligned_le32(0, packet);
+	KUNIT_EXPECT_EQ(test, ucsi_glink_decode_write(packet, 4, &error), 0);
+}
+
+static struct kunit_case ucsi_glink_cases[] = {
+	KUNIT_CASE(ucsi_glink_packets),
+	{}
+};
+static struct kunit_suite ucsi_glink_suite = {
+	.name = "ucsi-glink-protocol",
+	.test_cases = ucsi_glink_cases,
+};
+kunit_test_suite(ucsi_glink_suite);
+MODULE_LICENSE("GPL");
