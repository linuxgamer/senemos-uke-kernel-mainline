diff --git a/drivers/usb/typec/ucsi/ucsi_glink_protocol.h b/drivers/usb/typec/ucsi/ucsi_glink_protocol.h
new file mode 100644
index 0000000..0070b06
--- /dev/null
+++ b/drivers/usb/typec/ucsi/ucsi_glink_protocol.h
@@ -0,0 +1,40 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef UCSI_GLINK_PROTOCOL_H
+#define UCSI_GLINK_PROTOCOL_H
+
+#include <linux/errno.h>
+#include <linux/unaligned.h>
+#include "ucsi.h"
+
+#define UCSI_BUF_V1_SIZE (UCSI_MESSAGE_OUT + UCSI_MESSAGE_OUT - UCSI_MESSAGE_IN)
+#define UCSI_BUF_V2_SIZE (UCSIv2_MESSAGE_OUT + UCSIv2_MESSAGE_OUT - UCSI_MESSAGE_IN)
+
+/* Payload excludes pmic_glink_hdr; ret_code follows the complete ABI buffer. */
+static inline int ucsi_glink_decode_read(const void *payload, size_t len,
+					u16 version, size_t *buffer_len, u32 *fw_error)
+{
+	size_t size;
+
+	if (version)
+		size = version >= UCSI_VERSION_2_0 ? UCSI_BUF_V2_SIZE : UCSI_BUF_V1_SIZE;
+	else if (len == UCSI_BUF_V2_SIZE + sizeof(u32))
+		size = UCSI_BUF_V2_SIZE;
+	else
+		size = UCSI_BUF_V1_SIZE;
+	if (len != size + sizeof(u32))
+		return -EPROTO;
+	*fw_error = get_unaligned_le32((const u8 *)payload + size);
+	if (*fw_error)
+		return -EREMOTEIO;
+	*buffer_len = size;
+	return 0;
+}
+
+static inline int ucsi_glink_decode_write(const void *payload, size_t len, u32 *fw_error)
+{
+	if (len != sizeof(u32))
+		return -EPROTO;
+	*fw_error = get_unaligned_le32(payload);
+	return *fw_error ? -EREMOTEIO : 0;
+}
+#endif
