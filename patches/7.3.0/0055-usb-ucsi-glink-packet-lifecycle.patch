 #define MSG_TYPE_REQ_RESP               1
+#define MSG_TYPE_NOTIFY                 2
 
 #define UC_NOTIFY_RECEIVER_UCSI         0x0
 #define UC_UCSI_READ_BUF_REQ            0x11
@@ -68,8 +69,7 @@ struct pmic_glink_ucsi {
 	struct pmic_glink_client *client;
 
 	struct ucsi *ucsi;
-	struct completion read_ack;
-	struct completion write_ack;
+	struct completion response;
 	struct mutex lock;	/* protects concurrent access to PMIC Glink interface */
 
 	struct work_struct notify_work;
@@ -77,41 +77,89 @@ struct pmic_glink_ucsi {
 	spinlock_t state_lock;
 	bool ucsi_registered;
 	bool pd_running;
+	bool stopping;
+	bool quarantined;
+	u32 pending_opcode;
+	int response_error;
+	size_t response_len;
+	u64 service_generation;
+	u64 registered_generation;
 
 	u8 read_buf[UCSI_BUF_V2_SIZE];
 };
 
+/* No transaction ID exists on the wire: a timeout poisons this instance. */
+static int pmic_glink_ucsi_begin(struct pmic_glink_ucsi *ucsi, u32 opcode)
+{
+	unsigned long flags;
+	int ret = 0;
+
+	spin_lock_irqsave(&ucsi->state_lock, flags);
+	if (ucsi->stopping || !ucsi->pd_running)
+		ret = -ENOTCONN;
+	else if (ucsi->quarantined)
+		ret = -EPIPE;
+	else {
+		reinit_completion(&ucsi->response);
+		ucsi->pending_opcode = opcode;
+		ucsi->response_error = -EINPROGRESS;
+		ucsi->response_len = 0;
+	}
+	spin_unlock_irqrestore(&ucsi->state_lock, flags);
+	return ret;
+}
+
+static int pmic_glink_ucsi_wait(struct pmic_glink_ucsi *ucsi, int send_error)
+{
+	unsigned long flags;
+	unsigned long left = 0;
+	int ret;
+
+	if (!send_error)
+		left = wait_for_completion_timeout(&ucsi->response, 5 * HZ);
+	spin_lock_irqsave(&ucsi->state_lock, flags);
+	ret = send_error ?: ucsi->response_error;
+	if ((!send_error && !left) || ret == -EINPROGRESS)
+		ret = -ETIMEDOUT;
+	if (send_error || ret == -ETIMEDOUT || ret == -EPROTO)
+		ucsi->quarantined = true;
+	ucsi->pending_opcode = 0;
+	spin_unlock_irqrestore(&ucsi->state_lock, flags);
+	return ret;
+}
