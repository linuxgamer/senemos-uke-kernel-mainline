+	req.hdr.opcode = cpu_to_le32(UC_UCSI_READ_BUF_REQ);
 
-	ret = pmic_glink_send(ucsi->client, &req, sizeof(req));
-	if (ret < 0) {
-		dev_err(ucsi->dev, "failed to send UCSI read request: %d\n", ret);
+	mutex_lock(&ucsi->lock);
+	ret = pmic_glink_ucsi_begin(ucsi, UC_UCSI_READ_BUF_REQ);
+	if (ret)
 		goto out_unlock;
-	}
 
-	left = wait_for_completion_timeout(&ucsi->read_ack, 5 * HZ);
-	if (!left) {
-		dev_err(ucsi->dev, "timeout waiting for UCSI read response\n");
-		ret = -ETIMEDOUT;
+	ret = pmic_glink_send(ucsi->client, &req, sizeof(req));
+	ret = pmic_glink_ucsi_wait(ucsi, ret);
+	if (ret)
 		goto out_unlock;
-	}
-
-	memcpy(val, &ucsi->read_buf[offset], val_len);
-	ret = 0;
+	spin_lock_irqsave(&ucsi->state_lock, flags);
