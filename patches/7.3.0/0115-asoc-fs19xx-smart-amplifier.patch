+static const struct regmap_config fs19xx_regmap_config = {
+	.reg_bits		= 8,
+	.val_bits		= 16,
+	.max_register		= FS19XX_REG_MAX,
+	.val_format_endian	= REGMAP_ENDIAN_BIG,
+	.cache_type		= REGCACHE_NONE,
+};
+
+/* Returns a pointer to @count units of @unit_size at @offset, or NULL. */
+static const void *fs19xx_list_at(const u8 *base, size_t size, size_t offset,
+				  size_t count, size_t unit_size)
+{
+	size_t bytes;
+
+	if (check_mul_overflow(count, unit_size, &bytes))
+		return NULL;
+	if (offset > size || bytes > size - offset)
+		return NULL;
+	return base + offset;
+}
+
+static int fs19xx_find_sub(const u8 *preset, size_t size, size_t dev_off,
+			   const struct fs19xx_dev_list *dev, unsigned int type,
+			   size_t unit_size, const void **list, unsigned int *count)
+{
+	size_t idx_base = dev_off + offsetof(struct fs19xx_dev_list, index);
+	unsigned int nsub = le16_to_cpu(dev->len);
+	unsigned int i;
+
+	for (i = 0; i < nsub; i++) {
+		size_t off, n;
+		const void *hdr;
+
+		if (le16_to_cpu(dev->index[i].type) != type)
+			continue;
+		off = idx_base + le16_to_cpu(dev->index[i].offset);
+		hdr = fs19xx_list_at(preset, size, off, 1, sizeof(__le16));
+		if (!hdr)
+			return -EINVAL;
+		n = get_unaligned_le16(hdr);
+		*list = fs19xx_list_at(preset, size, off + sizeof(__le16), n, unit_size);
+		if (!*list)
+			return -EINVAL;
+		*count = n;
+		return 0;
+	}
+	return -ENOENT;
+}
+
+/* Locates this amplifier's lists inside @copy; on success the tables point into it. */
+static int fs19xx_parse_dev(struct fs19xx_priv *fs19xx, const u8 *copy, size_t fw_size,
+			    unsigned int chipid)
+{
+	const struct fs19xx_preset_header *hdr = (const void *)copy;
+	const struct fs19xx_index *index;
+	const struct fs19xx_dev_list *dev = NULL;
+	size_t dev_off = 0;
+	const void *list;
+	unsigned int count, ndev, i;
+	int ret;
+
+	ndev = le16_to_cpu(hdr->ndev);
+	index = fs19xx_list_at(copy, fw_size, sizeof(*hdr), ndev, sizeof(*index));
+	if (!index)
+		return -EINVAL;
+
+	for (i = 0; i < ndev; i++) {
+		const struct fs19xx_dev_list *cand;
+		size_t off = le16_to_cpu(index[i].offset);
+
+		if (le16_to_cpu(index[i].type) != 0)
+			continue;
+		cand = fs19xx_list_at(copy, fw_size, off, 1, sizeof(*cand));
+		if (!cand)
+			return -EINVAL;
+		if (le16_to_cpu(cand->addr) == fs19xx->i2c->addr) {
+			dev = cand;
+			dev_off = off;
+			break;
+		}
+	}
+	if (!dev)
+		return -ENOENT;
+
+	if (!(le16_to_cpu(dev->preset_ver) & FS19XX_PRESET_VER_VALID) ||
+	    (le16_to_cpu(dev->dev_type) >> 8) != chipid)
+		return -EINVAL;
+	if (!fs19xx_list_at(copy, fw_size, dev_off, 1,
+			    sizeof(*dev) + le16_to_cpu(dev->len) * sizeof(*dev->index)))
+		return -EINVAL;
+
+	ret = fs19xx_find_sub(copy, fw_size, dev_off, dev, FS19XX_DSC_SPK_INFO,
+			      sizeof(__le16), &list, &count);
+	if (ret)
+		return ret;
+	if (count <= FS19XX_INFO_POSITION)
+		return -EINVAL;
+	fs19xx->tcoef = get_unaligned_le16(list + FS19XX_INFO_TEMPR_COEF * sizeof(__le16));
+	fs19xx->position = get_unaligned_le16(list + FS19XX_INFO_POSITION * sizeof(__le16));
+
+	ret = fs19xx_find_sub(copy, fw_size, dev_off, dev, FS19XX_DSC_REG_COMMON,
+			      sizeof(struct fs19xx_reg_unit), &list, &count);
+	if (ret)
+		return ret;
+	fs19xx->common = list;
+	fs19xx->ncommon = count;
+
+	ret = fs19xx_find_sub(copy, fw_size, dev_off, dev, FS19XX_DSC_REG_SCENES,
+			      sizeof(struct fs19xx_scene_unit), &list, &count);
+	if (ret)
+		return ret;
+	fs19xx->scenes = list;
+	fs19xx->nscenes = count;
+	return 0;
+}
+
+static int fs19xx_parse_preset(struct fs19xx_priv *fs19xx, const u8 *fw_data,
+			       size_t fw_size, unsigned int chipid)
+{
+	const struct fs19xx_preset_header *hdr = (const void *)fw_data;
+	u8 *copy;
+	int ret;
+
+	if (fw_size < sizeof(*hdr) || le16_to_cpu(hdr->size) != fw_size)
+		return -EINVAL;
+	if (le16_to_cpu(hdr->crc16) !=
+	    crc16(0, fw_data + offsetof(struct fs19xx_preset_header, ndev),
+		  fw_size - offsetof(struct fs19xx_preset_header, ndev)))
+		return -EINVAL;
+
+	copy = devm_kmemdup(fs19xx->dev, fw_data, fw_size, GFP_KERNEL);
+	if (!copy)
+		return -ENOMEM;
+
+	ret = fs19xx_parse_dev(fs19xx, copy, fw_size, chipid);
+	if (ret) {
+		fs19xx->common = NULL;
+		fs19xx->scenes = NULL;
+		fs19xx->ncommon = fs19xx->nscenes = 0;
+		devm_kfree(fs19xx->dev, copy);
+		return ret;
+	}
+
+	fs19xx->preset = copy;
+	fs19xx->preset_size = fw_size;
+	return 0;
+}
+
+static int fs19xx_load_preset(struct fs19xx_priv *fs19xx, unsigned int chipid)
+{
+	const struct firmware *fw;
+	const char *name = FS19XX_DEFAULT_FW_NAME;
+	int ret;
+
+	of_property_read_string(fs19xx->dev->of_node, "firmware-name", &name);
+
+	ret = request_firmware(&fw, name, fs19xx->dev);
+	if (ret) {
+		dev_warn(fs19xx->dev, "preset %s unavailable (%d); speaker disabled\n",
+			 name, ret);
+		return ret;
+	}
+	ret = fs19xx_parse_preset(fs19xx, fw->data, fw->size, chipid);
+	release_firmware(fw);
+	if (ret)
+		dev_warn(fs19xx->dev, "preset %s rejected (%d); speaker disabled\n",
+			 name, ret);
+	return ret;
+}
+
+static int fs19xx_detect(struct fs19xx_priv *fs19xx, unsigned int *chipid)
+{
+	unsigned int id, rev;
+	int ret;
+
+	/* The chip only answers on I2C once it is out of reset. */
+	if (fs19xx->gpio_reset) {
+		gpiod_set_value_cansleep(fs19xx->gpio_reset, 1);
+		msleep(10);
+		gpiod_set_value_cansleep(fs19xx->gpio_reset, 0);
+		msleep(2);
+	}
+	ret = regmap_read(fs19xx->regmap, FS19XX_REG_CHIPID, &id);
+	if (!ret)
+		ret = regmap_read(fs19xx->regmap, FS19XX_REG_REVID, &rev);
+	if (fs19xx->gpio_reset)
+		gpiod_set_value_cansleep(fs19xx->gpio_reset, 1);
+	if (ret)
+		return ret;
+
+	*chipid = id >> 8;
+	if (*chipid != FS19XX_CHIPID_FS19XX && *chipid != FS19XX_CHIPID_FS1958)
+		return -ENODEV;
+	dev_info(fs19xx->dev, "FS19xx id 0x%04x rev 0x%04x\n", id, rev);
+	return 0;
+}
+
+static int fs19xx_i2c_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct fs19xx_priv *fs19xx;
+	unsigned int chipid;
+	int ret;
+
+	fs19xx = devm_kzalloc(dev, sizeof(*fs19xx), GFP_KERNEL);
+	if (!fs19xx)
+		return -ENOMEM;
+
+	fs19xx->i2c = client;
+	fs19xx->dev = dev;
+	fs19xx->volume = min_t(unsigned int, FS19XX_VOL_DEFAULT, max_volume);
+	mutex_init(&fs19xx->lock);
+	INIT_DELAYED_WORK(&fs19xx->unmute_work, fs19xx_unmute_work);
+	i2c_set_clientdata(client, fs19xx);
+
+	fs19xx->regmap = devm_regmap_init_i2c(client, &fs19xx_regmap_config);
+	if (IS_ERR(fs19xx->regmap))
+		return dev_err_probe(dev, PTR_ERR(fs19xx->regmap), "regmap init failed\n");
+
+	/* Asserted (logical 1) holds the amplifier in reset. */
+	fs19xx->gpio_reset = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(fs19xx->gpio_reset))
+		return dev_err_probe(dev, PTR_ERR(fs19xx->gpio_reset), "reset gpio\n");
+	if (fs19xx->gpio_reset && !gpiod_is_active_low(fs19xx->gpio_reset))
+		return dev_err_probe(dev, -EINVAL, "reset-gpios must be GPIO_ACTIVE_LOW\n");
+
+	ret = fs19xx_detect(fs19xx, &chipid);
+	if (ret == -EPROBE_DEFER)
+		return ret;
+	if (ret) {
+		/*
+		 * Keep the component so the sound card (and HDMI) still binds; this
+		 * speaker then refuses to open a stream.
+		 */
+		dev_err(dev, "amplifier not detected (%d); speaker disabled\n", ret);
+	} else {
+		/* A missing preset also leaves the card usable, speaker disabled. */
+		fs19xx_load_preset(fs19xx, chipid);
+		if (fs19xx->preset)
+			dev_info(dev, "preset loaded, position 0x%x\n", fs19xx->position);
+	}
+
+	return devm_snd_soc_register_component(dev, &fs19xx_component, &fs19xx_dai, 1);
+}
+
+static void fs19xx_i2c_remove(struct i2c_client *client)
+{
+	struct fs19xx_priv *fs19xx = i2c_get_clientdata(client);
+
+	cancel_delayed_work_sync(&fs19xx->unmute_work);
+	mutex_lock(&fs19xx->lock);
+	if (fs19xx->powered) {
+		fs19xx->powered = false;
+		fs19xx_chip_stop(fs19xx);
+	}
+	mutex_unlock(&fs19xx->lock);
+}
