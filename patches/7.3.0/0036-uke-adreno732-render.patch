From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] drm/msm: add exact Adreno 732 resources and identity

Describe the inspected gen7_11_0 GPU, firmware, power domains and UBWC.
Keep preemption, IFPC and high GPU operating points outside this candidate.

OEM comparison: LineageOS SM8635 modules
ed4ad0d1ad00b755af2fe61387dcc5397ad20b8f.
Uke firmware and live DT remain private physical evidence.

---
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
--- a/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_catalog.c
@@ -1615,6 +1615,37 @@
 		},
 		.preempt_record_size = 3572 * SZ_1K,
 	}, {
+		.chip_ids = ADRENO_CHIP_IDS(0x43030b00), /* Adreno 732 / gen7_11_0 */
+		.family = ADRENO_7XX_GEN2,
+		.revn = 732,
+		.fw = {
+			[ADRENO_FW_SQE] = "gen71100_sqe.fw",
+			[ADRENO_FW_GMU] = "gen71100_gmu.bin",
+		},
+		.gmem = SZ_1M + SZ_512K,
+		.inactive_period = DRM_MSM_INACTIVE_PERIOD,
+		/* Preemption and IFPC require separate device qualification. */
+		.quirks = ADRENO_QUIRK_HAS_CACHED_COHERENT |
+			  ADRENO_QUIRK_HAS_HW_APRIV,
+		.funcs = &a7xx_gpu_funcs,
+		.zapfw = "gen71100_zap.mbn",
+		.a6xx = &(const struct a6xx_info) {
+			.hwcg = a740_hwcg,
+			.protect = &a730_protect,
+			.pwrup_reglist = &a7xx_pwrup_reglist,
+			.dyn_pwrup_reglist = &a7xx_dyn_pwrup_reglist,
+			.gbif_cx = a640_gbif,
+			.gmu_chipid = 0x70b0000,
+			.gmu_cgc_mode = 0x00020202,
+			.bcms = (const struct a6xx_bcm[]) {
+				{ .name = "SH0", .buswidth = 16 },
+				{ .name = "MC0", .buswidth = 4 },
+				{ .name = "ACV", .fixed = true, .perfmode = BIT(2) },
+				{ /* sentinel */ },
+			},
+		},
+		.preempt_record_size = 2196 * SZ_1K,
+	}, {
 		.chip_ids = ADRENO_CHIP_IDS(0x43030c00),
 		.family = ADRENO_7XX_GEN2,
 		.fw = {
diff --git a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
--- a/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
+++ b/drivers/gpu/drm/msm/adreno/a6xx_gmu.c
@@ -1203,7 +1203,14 @@
 	if (test_bit(GMU_STATUS_SECURE_INIT, &gmu->status))
 		return 0;
 
-	if (adreno_is_a750(adreno_gpu) || adreno_is_a8xx(adreno_gpu)) {
+	if (adreno_gpu->chip_id == 0x43030b00) {
+		if (!qcom_scm_is_available())
+			return -EPROBE_DEFER;
+		ret = qcom_scm_gpu_init_regs(QCOM_SCM_GPU_ALWAYS_EN_REQ |
+					     QCOM_SCM_GPU_BCL_EN_REQ);
+		if (ret)
+			return ret;
+	} else if (adreno_is_a750(adreno_gpu) || adreno_is_a8xx(adreno_gpu)) {
 		/*
 		 * Assume that if qcom scm isn't available, that whatever
 		 * replacement allows writing the fuse register ourselves.
@@ -1319,9 +1326,14 @@
 	a6xx_gmu_gxpd_get(gmu);
 
 	/* Use a known rate to bring up the GMU */
-	clk_set_rate(gmu->core_clk, 200000000);
-	clk_set_rate(gmu->hub_clk, adreno_is_a740_family(adreno_gpu) ?
-		     200000000 : 150000000);
+	ret = clk_set_rate(gmu->core_clk,
+		adreno_gpu->chip_id == 0x43030b00 ? 220000000 : 200000000);
+	if (ret)
+		goto rpm_put;
+	ret = clk_set_rate(gmu->hub_clk, adreno_is_a740_family(adreno_gpu) ?
+			   200000000 : 150000000);
+	if (ret)
+		goto rpm_put;
 	ret = clk_bulk_prepare_enable(gmu->nr_clocks, gmu->clocks);
 	if (ret)
 		goto rpm_put;
diff --git a/drivers/clk/qcom/gpucc-cliffs.c b/drivers/clk/qcom/gpucc-cliffs.c
--- a/drivers/clk/qcom/gpucc-cliffs.c
+++ b/drivers/clk/qcom/gpucc-cliffs.c
@@ -18,6 +18,7 @@
 #include "clk-rcg.h"
 #include "clk-regmap-divider.h"
 #include "common.h"
+#include "gdsc.h"
 #include "reset.h"
 #include "vdd-level.h"
 
@@ -562,12 +563,40 @@
 	.fast_io = true,
 };
 
+/* The Cliffs offsets differ from the neighboring SM8550 controller. */
+static struct gdsc gpu_cc_cx_gdsc = {
+	.gdscr = 0x908c,
+	.gds_hw_ctrl = 0x90a0,
+	.clk_dis_wait_val = 8,
+	.pd = { .name = "gpu_cc_cx_gdsc" },
+	.pwrsts = PWRSTS_OFF_ON,
+	.flags = RETAIN_FF_ENABLE | VOTABLE,
+};
+
+static struct gdsc gpu_cc_gx_gdsc = {
+	.gdscr = 0x9034,
+	.clamp_io_ctrl = 0x9504,
+	.pd = {
+		.name = "gpu_cc_gx_gdsc",
+		.power_on = gdsc_gx_do_nothing_enable,
+	},
+	.pwrsts = PWRSTS_OFF_ON,
+	.flags = CLAMP_IO | POLL_CFG_GDSCR | RETAIN_FF_ENABLE,
+};
+
+static struct gdsc *gpu_cc_cliffs_gdscs[] = {
+	[GPU_CC_CX_GDSC] = &gpu_cc_cx_gdsc,
+	[GPU_CC_GX_GDSC] = &gpu_cc_gx_gdsc,
+};
+
 static const struct qcom_cc_desc gpu_cc_cliffs_desc = {
 	.config = &gpu_cc_cliffs_regmap_config,
 	.clks = gpu_cc_cliffs_clocks,
 	.num_clks = ARRAY_SIZE(gpu_cc_cliffs_clocks),
 	.resets = gpu_cc_cliffs_resets,
 	.num_resets = ARRAY_SIZE(gpu_cc_cliffs_resets),
+	.gdscs = gpu_cc_cliffs_gdscs,
+	.num_gdscs = ARRAY_SIZE(gpu_cc_cliffs_gdscs),
 	.clk_regulators = gpu_cc_cliffs_regulators,
 	.num_clk_regulators = ARRAY_SIZE(gpu_cc_cliffs_regulators),
 };
diff --git a/include/dt-bindings/clock/qcom,gpucc-cliffs.h b/include/dt-bindings/clock/qcom,gpucc-cliffs.h
--- a/include/dt-bindings/clock/qcom,gpucc-cliffs.h
+++ b/include/dt-bindings/clock/qcom,gpucc-cliffs.h
@@ -48,4 +48,8 @@
 #define GPUCC_GPU_CC_XO_BCR					9
 #define GPUCC_GPU_CC_FREQUENCY_LIMITER_IRQ_CLEAR		10
 
+/* GPU_CC power domains */
+#define GPU_CC_CX_GDSC 0
+#define GPU_CC_GX_GDSC 1
+
 #endif
diff --git a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
@@ -36,6 +36,9 @@
 #define GFX_ACTLR_PRR          (1 << 5)
 
 static const struct of_device_id qcom_smmu_actlr_client_of_match[] = {
+	/* Exact gen7_11_0 ACTLR from the inspected Uke GPU SMMU graph. */
+	{ .compatible = "qcom,adreno-43030b00", .data = (const void *)0x32b },
+	{ .compatible = "qcom,adreno-gmu-732", .data = (const void *)0x32b },
 	{ .compatible = "qcom,adreno",
 			.data = (const void *) (PREFETCH_DEEP | CPRE | CMTLB) },
 	{ .compatible = "qcom,adreno-gmu",
diff --git a/drivers/soc/qcom/ubwc_config.c b/drivers/soc/qcom/ubwc_config.c
--- a/drivers/soc/qcom/ubwc_config.c
+++ b/drivers/soc/qcom/ubwc_config.c
@@ -292,6 +302,7 @@
 	{ .compatible = "qcom,sm8250", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8350", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8450", .data = &ubwc_4_0_hbb16, },
+	{ .compatible = "qcom,sm7675", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8550", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8650", .data = &ubwc_4_0_hbb16, },
 	{ .compatible = "qcom,sm8750", .data = &ubwc_5_0_hbb16, },
