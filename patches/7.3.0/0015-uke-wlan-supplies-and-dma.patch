From: Uke platform maintainers
Subject: [PATCH] wifi: ath11k: preserve Uke RF supplies and scoped DMA

Carry the reviewed boot supplier/GENI admission into the package source,
then admit OEM smpb1/smpb3 and the exact WLAN SMR ID/mask. Require all
three Uke RF supplies before DSP boot; unwind failed starts and release
votes after shutdown. Other ath11k AHB boards stay unchanged.

--- a/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
+++ b/drivers/iommu/arm/arm-smmu/arm-smmu-qcom.c
@@ -815,7 +815,7 @@
 	const __be32 *actlr;
 	int len, i, j;
 
-	/* OEM Cliffs streams: DWC3/GPI0, plus UFS only in the boot profile. */
+	/* OEM Cliffs streams, including WLAN SID 0x1400 with SMR mask 1. */
 	if (!fwspec || !fwspec->num_ids)
 		return -EINVAL;
 	actlr = of_get_property(smmu->dev->of_node, "qcom,actlr", &len);
@@ -825,12 +825,13 @@
 		u32 sid = fwspec->ids[i];
 
 		if (sid != 0x40 && sid != 0xb6 &&
-		    !(sid == 0x60 && of_device_is_compatible(smmu->dev->of_node,
-						"qcom,sm7675-boot-smmu")))
+		    !((sid == 0x60 || sid == 0xa3 || sid == 0x11400) &&
+		      of_device_is_compatible(smmu->dev->of_node, "qcom,sm7675-boot-smmu")))
 			return dev_err_probe(dev, -EOPNOTSUPP, "outside Uke boot SMMU scope\n");
 		/* None of these streams has an ACTLR override in OEM Cliffs DT. */
 		for (j = 0; actlr && j < len / sizeof(u32); j += 3)
-			if (!((sid ^ be32_to_cpu(actlr[j])) & ~be32_to_cpu(actlr[j + 1])))
+			if (!((FIELD_GET(ARM_SMMU_SMR_ID, sid) ^ be32_to_cpu(actlr[j])) &
+			      ~be32_to_cpu(actlr[j + 1])))
 				return dev_err_probe(dev, -EOPNOTSUPP,
 						     "boot stream needs an ACTLR override\n");
 	}
--- a/drivers/regulator/qcom-rpmh-regulator-uke.c
+++ b/drivers/regulator/qcom-rpmh-regulator-uke.c
@@ -1991,13 +1991,20 @@
 		return rc;
 	}
 
-	/* Limit this data-only experiment to the six required supply resources. */
+	/* OEM Uke supplies required by CPU, USB, UFS and WCN6750. */
 	if (strcmp(aggr_vreg->resource_name, "cx.lvl") &&
 	    strcmp(aggr_vreg->resource_name, "mx.lvl") &&
 	    strcmp(aggr_vreg->resource_name, "ldob2") &&
 	    strcmp(aggr_vreg->resource_name, "ldob4") &&
 	    strcmp(aggr_vreg->resource_name, "ldob7") &&
-	    strcmp(aggr_vreg->resource_name, "ldob17"))
+	    strcmp(aggr_vreg->resource_name, "ldob17") &&
+	    strcmp(aggr_vreg->resource_name, "smpb2") &&
+	    strcmp(aggr_vreg->resource_name, "smpb1") &&
+	    strcmp(aggr_vreg->resource_name, "smpb3") &&
+	    strcmp(aggr_vreg->resource_name, "ldod1") &&
+	    strcmp(aggr_vreg->resource_name, "ldob5") &&
+	    strcmp(aggr_vreg->resource_name, "ldob12") &&
+	    strcmp(aggr_vreg->resource_name, "ldod3"))
 		return -ENODEV;
 
 	aggr_vreg->addr = cmd_db_read_addr(aggr_vreg->resource_name);
--- a/drivers/net/wireless/ath/ath11k/ahb.c
+++ b/drivers/net/wireless/ath/ath11k/ahb.c
@@ -401,14 +401,60 @@
 	ath11k_ce_cleanup_pipes(ab);
 }
 
+static int ath11k_ahb_uke_regulators(struct ath11k_base *ab)
+{
+	static const char * const names[] = { "vdd-cx-mx", "vdd-1.8-xo", "vdd-1.3-rfa" };
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+	int i, ret;
+
+	if (!of_device_is_compatible(ab->dev->of_node, "xiaomi,uke-wcn6750-wifi"))
+		return 0;
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		char property[32];
+
+		snprintf(property, sizeof(property), "%s-supply", names[i]);
+		if (!of_property_present(ab->dev->of_node, property))
+			return dev_err_probe(ab->dev, -EINVAL, "Uke WLAN requires all three RF supplies\n");
+		ab_ahb->uke_regs[i].supply = names[i];
+	}
+	ret = devm_regulator_bulk_get(ab->dev, ARRAY_SIZE(ab_ahb->uke_regs), ab_ahb->uke_regs);
+	if (ret)
+		return dev_err_probe(ab->dev, ret, "Uke WLAN RF supplies unavailable\n");
+	/* The admitted OEM providers retain their exact initial voltage constraints. */
+	ab_ahb->uke_supplies = true;
+	return 0;
+}
+
+static void ath11k_ahb_uke_regulators_off(struct ath11k_base *ab)
+{
+	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
+	int ret;
+
+	if (!ab_ahb->uke_supplies_enabled)
+		return;
+	ret = regulator_bulk_disable(ARRAY_SIZE(ab_ahb->uke_regs), ab_ahb->uke_regs);
+	if (ret)
+		ath11k_err(ab, "failed to release Uke WLAN RF supplies: %d\n", ret);
+	else
+		ab_ahb->uke_supplies_enabled = false;
+}
+
 static int ath11k_ahb_power_up(struct ath11k_base *ab)
 {
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
 	int ret;
 
+	if (ab_ahb->uke_supplies && !ab_ahb->uke_supplies_enabled) {
+		ret = regulator_bulk_enable(ARRAY_SIZE(ab_ahb->uke_regs), ab_ahb->uke_regs);
+		if (ret)
+			return ret;
+		ab_ahb->uke_supplies_enabled = true;
+	}
 	ret = rproc_boot(ab_ahb->tgt_rproc);
-	if (ret)
+	if (ret) {
 		ath11k_err(ab, "failed to boot the remote processor Q6\n");
+		ath11k_ahb_uke_regulators_off(ab);
+	}
 
 	return ret;
 }
@@ -418,6 +464,7 @@
 	struct ath11k_ahb *ab_ahb = ath11k_ahb_priv(ab);
 
 	rproc_shutdown(ab_ahb->tgt_rproc);
+	ath11k_ahb_uke_regulators_off(ab);
 }
 
 static void ath11k_ahb_init_qmi_ce_config(struct ath11k_base *ab)
@@ -1150,6 +1197,10 @@
 	ab->fw_mode = ATH11K_FIRMWARE_MODE_NORMAL;
 	platform_set_drvdata(pdev, ab);
 
+	ret = ath11k_ahb_uke_regulators(ab);
+	if (ret)
+		goto err_core_free;
+
 	ret = ath11k_pcic_register_pci_ops(ab, pci_ops);
 	if (ret) {
 		ath11k_err(ab, "failed to register PCI ops: %d\n", ret);
--- a/drivers/net/wireless/ath/ath11k/ahb.h
+++ b/drivers/net/wireless/ath/ath11k/ahb.h
@@ -7,6 +7,7 @@
 #define ATH11K_AHB_H
 
 #include "core.h"
+#include <linux/regulator/consumer.h>
 
 #define ATH11K_AHB_RECOVERY_TIMEOUT (3 * HZ)
 
@@ -23,6 +24,9 @@
 
 struct ath11k_ahb {
 	struct rproc *tgt_rproc;
+	struct regulator_bulk_data uke_regs[3];
+	bool uke_supplies;
+	bool uke_supplies_enabled;
 	struct {
 		struct device *dev;
 		struct iommu_domain *iommu_domain;
