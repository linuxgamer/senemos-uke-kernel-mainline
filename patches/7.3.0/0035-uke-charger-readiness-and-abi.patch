From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] power: qualify Uke charger startup, current ABI and USB lifetime

Preload the in-kernel domain mapper before Qualcomm remoteproc startup,
following Loic Poulain's upstream remoteproc load-order proposal:
https://lore.kernel.org/linux-remoteproc/?q=load+pd_mapper+before+booting
The Uke initramfs must also preload the QRTR transport before DSP coldplug.

Exact Uke gauge responses carry mAh counters and charge-negative current.
Translate them to the Linux uAh/charge-positive ABI with overflow rejection.
Other battery variants retain their existing interpretation.

Retry a still-current USB SDP budget for at most five seconds while the
Uke remote charger reports EAGAIN. Each attempt retains the battery driver's
online/type/source-ceiling checks. Never retry a terminal admission error.
Link the USB consumer to the battery supplier so live supplier removal cannot
leave a callable driver pointer in the USB worker. Cancel delayed work on exit.
These are source candidates; repeated physical boot and charging remain gates.

diff --git a/drivers/power/supply/qcom_battmgr.c b/drivers/power/supply/qcom_battmgr.c
index ac42b0f..5c01e69 100644
--- a/drivers/power/supply/qcom_battmgr.c
+++ b/drivers/power/supply/qcom_battmgr.c
@@ -1523,7 +1523,16 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 			battmgr->info.voltage_max = le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_CURR_NOW:
-			battmgr->status.current_now = le32_to_cpu(resp->intval.value);
+			val = le32_to_cpu(resp->intval.value);
+			if (battmgr->variant == QCOM_BATTMGR_UKE) {
+				/* OEM gauge current is negative while charging; Linux is positive. */
+				if ((int)val == INT_MIN) {
+					battmgr->error = -ERANGE;
+					break;
+				}
+				val = -(int)val;
+			}
+			battmgr->status.current_now = val;
 			break;
 		case BATT_TEMP:
 			val = le32_to_cpu(resp->intval.value);
@@ -1536,7 +1545,16 @@ static void qcom_battmgr_sm8350_callback(struct qcom_battmgr *battmgr,
 			battmgr->info.technology = le32_to_cpu(resp->intval.value);
 			break;
 		case BATT_CHG_COUNTER:
-			battmgr->info.charge_count = le32_to_cpu(resp->intval.value);
+			val = le32_to_cpu(resp->intval.value);
+			if (battmgr->variant == QCOM_BATTMGR_UKE) {
+				/* Exact Uke firmware reports mAh; the power-supply ABI uses uAh. */
+				if (val > INT_MAX / 1000) {
+					battmgr->error = -ERANGE;
+					break;
+				}
+				val *= 1000;
+			}
+			battmgr->info.charge_count = val;
 			break;
 		case BATT_CYCLE_COUNT:
 			battmgr->info.cycle_count = le32_to_cpu(resp->intval.value);
diff --git a/drivers/remoteproc/qcom_common.c b/drivers/remoteproc/qcom_common.c
index 5294e32..aaac807 100644
--- a/drivers/remoteproc/qcom_common.c
+++ b/drivers/remoteproc/qcom_common.c
@@ -627,3 +627,6 @@ EXPORT_SYMBOL_GPL(qcom_remove_pdm_subdev);
 
 MODULE_DESCRIPTION("Qualcomm Remoteproc helper driver");
 MODULE_LICENSE("GPL v2");
+
+/* Make the local service locator available before remote firmware starts. */
+MODULE_SOFTDEP("pre: qcom_pd_mapper");
diff --git a/drivers/usb/dwc3/core.c b/drivers/usb/dwc3/core.c
index 0617fbf..7559795 100644
--- a/drivers/usb/dwc3/core.c
+++ b/drivers/usb/dwc3/core.c
@@ -2183,16 +2183,29 @@ static int dwc3_get_num_ports(struct dwc3 *dwc)
 
 static void dwc3_vbus_draw_work(struct work_struct *work)
 {
-	struct dwc3 *dwc = container_of(work, struct dwc3, vbus_draw_work);
+	struct dwc3 *dwc = container_of(to_delayed_work(work), struct dwc3, vbus_draw_work);
 	union power_supply_propval val = {0};
+	unsigned int current_limit = READ_ONCE(dwc->current_limit);
+	unsigned int retries = READ_ONCE(dwc->vbus_draw_retries);
 	int ret;
 
-	val.intval = 1000 * (dwc->current_limit);
+	val.intval = 1000 * current_limit;
 	ret = power_supply_set_property(dwc->usb_psy, POWER_SUPPLY_PROP_INPUT_CURRENT_LIMIT, &val);
+	/*
+	 * Enumeration can precede the remote charger. Revalidate every retry in
+	 * the battery driver; never turn an expired SDP budget into a PD request.
+	 * A newer gadget request queues immediate work and must not be delayed.
+	 */
+	if (ret == -EAGAIN && of_machine_is_compatible("xiaomi,uke") &&
+	    current_limit == READ_ONCE(dwc->current_limit) &&
+	    retries < 50) {
+		WRITE_ONCE(dwc->vbus_draw_retries, retries + 1);
+		schedule_delayed_work(&dwc->vbus_draw_work, msecs_to_jiffies(100));
+	}
 
 	if (ret < 0)
 		dev_dbg(dwc->dev, "Error (%d) setting vbus draw (%d mA)\n",
-			ret, dwc->current_limit);
+			ret, current_limit);
 }
 
 static struct power_supply *dwc3_get_usb_power_supply(struct dwc3 *dwc)
@@ -2209,7 +2222,16 @@ static struct power_supply *dwc3_get_usb_power_supply(struct dwc3 *dwc)
 	if (!usb_psy)
 		return ERR_PTR(-EPROBE_DEFER);
 
-	INIT_WORK(&dwc->vbus_draw_work, dwc3_vbus_draw_work);
+	/*
+	 * A reference to the supply object does not pin its driver's callbacks.
+	 * Unbind the USB consumer before a Uke battery-driver removal can free them.
+	 */
+	if (of_machine_is_compatible("xiaomi,uke") &&
+	    !device_link_add(dwc->dev, usb_psy->dev.parent, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		power_supply_put(usb_psy);
+		return ERR_PTR(-EINVAL);
+	}
+	INIT_DELAYED_WORK(&dwc->vbus_draw_work, dwc3_vbus_draw_work);
 	return usb_psy;
 }
 
@@ -2437,10 +2459,10 @@ void dwc3_core_remove(struct dwc3 *dwc)
 	dwc3_free_event_buffers(dwc);
 
 	if (dwc->psy_nb.notifier_call)
 		power_supply_unreg_notifier(&dwc->psy_nb);
 
 	if (dwc->usb_psy) {
-		cancel_work_sync(&dwc->vbus_draw_work);
+		cancel_delayed_work_sync(&dwc->vbus_draw_work);
 		power_supply_put(dwc->usb_psy);
 	}
 }
diff --git a/drivers/usb/dwc3/core.h b/drivers/usb/dwc3/core.h
index e0dee9d..bfb9000 100644
--- a/drivers/usb/dwc3/core.h
+++ b/drivers/usb/dwc3/core.h
@@ -1061,8 +1061,9 @@ struct dwc3_glue_ops {
  * @usb_psy: pointer to power supply interface.
  * @usb_psy_name: name of the USB power supply
  * @psy_nb: power supply notifier block
  * @vbus_draw_work: Work to set the vbus drawing limit
  * @current_limit: How much current to draw from vbus, in milliAmperes.
+ * @vbus_draw_retries: Bounded retries while the Uke charger service starts.
  * @usb2_phy: pointer to USB2 PHY
  * @usb3_phy: pointer to USB3 PHY
  * @usb2_generic_phy: pointer to array of USB2 PHYs
@@ -1251,12 +1252,13 @@ struct dwc3 {
 	enum usb_dr_mode	role_switch_default_mode;
 
 	struct power_supply	*usb_psy;
 	const char		*usb_psy_name;
 	struct notifier_block	psy_nb;
-	struct work_struct	vbus_draw_work;
+	struct delayed_work	vbus_draw_work;
 	unsigned int		current_limit;
+	unsigned int		vbus_draw_retries;
 
 #define DWC3_CURRENT_UNSPECIFIED	UINT_MAX
 
 	u32			fladj;
 	u32			ref_clk_per;
diff --git a/drivers/usb/dwc3/gadget.c b/drivers/usb/dwc3/gadget.c
index 59e0ff5..fe06e6a 100644
--- a/drivers/usb/dwc3/gadget.c
+++ b/drivers/usb/dwc3/gadget.c
@@ -3161,8 +3161,9 @@ static int dwc3_gadget_vbus_draw(struct usb_gadget *g, unsigned int mA)
 	if (!dwc->usb_psy)
 		return -EOPNOTSUPP;
 
-	dwc->current_limit = mA;
-	schedule_work(&dwc->vbus_draw_work);
+	WRITE_ONCE(dwc->current_limit, mA);
+	WRITE_ONCE(dwc->vbus_draw_retries, 0);
+	mod_delayed_work(system_wq, &dwc->vbus_draw_work, 0);
 
 	return 0;
 }
