+/* PMIC7/Gen3 conversions from the Uke Qualcomm downstream driver. */
+static int qcom_vadc_scale_hw_pm7_chg_temp(const struct u32_fract *prescale,
+		const struct adc5_data *data, u16 adc_code, int *result)
+{
+	int uv = qcom_vadc_scale_code_voltage_factor(adc_code, prescale, data, 1);
+	s64 temp = div_s64(30303LL * uv - 27712 * 1000000LL, 100000);
+
+	*result = temp > 0 ? temp : 0;
+	return 0;
+}
+
+static int qcom_vadc_scale_hw_calib_current(const struct u32_fract *prescale,
+		const struct adc5_data *data, u16 adc_code, int *result)
+{
+	s64 voltage;
+
+	if (!prescale->numerator || !data->full_scale_code_volt)
+		return -EINVAL;
+	voltage = div_s64((s64)(s16)adc_code * 1875 * 1000, data->full_scale_code_volt);
+	*result = div_s64(voltage * prescale->denominator, prescale->numerator);
+	return 0;
+}
+
+static int qcom_vadc_scale_hw_calib_current_raw(const struct u32_fract *prescale,
+		const struct adc5_data *data, u16 adc_code, int *result)
+{
+	if (!prescale->numerator)
+		return -EINVAL;
+	*result = div_s64((s64)(s16)adc_code * prescale->denominator, prescale->numerator);
+	return 0;
+}
+
+static int qcom_adc5_gen3_scale_hw_calib_batt_therm_100(const struct u32_fract *prescale,
+		const struct adc5_data *data, u16 adc_code, int *result)
+{
+	s64 resistance;
+	int ret, decidegrees;
+
+	if (adc_code >= RATIO_MAX_ADC7)
+		return -EINVAL;
+	resistance = div64_s64((s64)adc_code * R_PU_100K, RATIO_MAX_ADC7 - adc_code);
+	ret = qcom_vadc_map_voltage_temp(adcmap_gen3_batt_therm_100k,
+			ARRAY_SIZE(adcmap_gen3_batt_therm_100k), resistance, &decidegrees);
+	if (ret)
+		return ret;
+	/* The downstream table uses decidegrees; IIO temperature uses millidegrees. */
+	*result = decidegrees * 100;
+	return 0;
+}
+
 static int qcom_vadc_scale_hw_calib_volt(
 				const struct u32_fract *prescale,
 				const struct adc5_data *data,
