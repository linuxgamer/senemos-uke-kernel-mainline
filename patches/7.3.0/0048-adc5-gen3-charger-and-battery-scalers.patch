+			chan_props->common_props.scale_fn_type = SCALE_HW_CALIB_GEN3_BATT_THERM_100K;
+		}
 
 		iio_chan->channel = ADC5_GEN3_V_CHAN(chan_props->common_props);
 		iio_chan->info_mask_separate = adc_chan->info_mask;
