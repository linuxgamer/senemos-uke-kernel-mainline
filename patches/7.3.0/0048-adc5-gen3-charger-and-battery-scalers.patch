-		if (chan->type == IIO_VOLTAGE) {
-			/* Hardware scaling returns uV; the IIO voltage ABI uses mV. */
+		if (chan->type == IIO_VOLTAGE || chan->type == IIO_CURRENT) {
+			/* Hardware scaling returns uV/uA; processed IIO uses mV/mA. */
 			*val2 = 1000;
 			return IIO_VAL_FRACTIONAL;
 		}
