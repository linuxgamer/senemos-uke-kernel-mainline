From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] ASoC: contain Uke amplifier faults and reject invalid TDM setup

Keep the OEM startup sequence, serialize stream and switch changes, stop on
clock or thermal failures, and preserve volume retry state. Bound the
uncalibrated volume in code and remove the bring-up bypass parameters.
Keep preset writes muted and volume bounded. Propagate topology-loader errors
before admitting a graph.

diff --git a/sound/soc/codecs/fs19xx.c b/sound/soc/codecs/fs19xx.c
index ebd27f8..4e9a2c6 100644
--- a/sound/soc/codecs/fs19xx.c
+++ b/sound/soc/codecs/fs19xx.c
@@ -18,6 +18,7 @@
 #include <linux/firmware.h>
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
+#include <linux/log2.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
 #include <linux/overflow.h>
@@ -34,7 +35,6 @@
 #define FS19XX_STATUS_PLLS		BIT(1)
 #define FS19XX_REG_CHIPID		0x03
 #define FS19XX_CHIPID_FS19XX		0x29
-#define FS19XX_CHIPID_FS1958		0x17
 #define FS19XX_REG_REVID		0x04
 #define FS19XX_REG_OTPACC		0x0b
 #define FS19XX_OTPACC_KEY		0xca91
@@ -54,6 +54,7 @@
 #define FS19XX_REG_DACCTRL		0x30
 #define FS19XX_DACCTRL_MUTE		0x0310
 #define FS19XX_DACCTRL_RUN		0x0210
+#define FS19XX_DACCTRL_MUTE_BIT		BIT(8)
 #define FS19XX_REG_TSCTRL		0x4c
 #define FS19XX_TSCTRL_TSEN		BIT(3)
 #define FS19XX_REG_PLLCTRL1		0xa1
@@ -75,7 +76,7 @@
 #define FS19XX_PLL_C3			0x0018
 
 #define FS19XX_VOL_DEFAULT		0xdf	/* OEM uncalibrated default, -12 dB */
-#define FS19XX_VOL_MAX			0xff
+#define FS19XX_VOL_MAX			FS19XX_VOL_DEFAULT
 
 #define FS19XX_LOCK_POLL_MS		10
 #define FS19XX_LOCK_POLL_COUNT		200
@@ -164,20 +165,14 @@ struct fs19xx_priv {
 	u16 position;
 
 	unsigned int volume;
+	unsigned int pll_polls;
 	bool powered;
 	bool speaker_enabled;
+	bool stream_active;
+	bool suspended;
+	bool removing;
 };
 
-static unsigned int max_volume = FS19XX_VOL_DEFAULT;
-module_param(max_volume, uint, 0644);
-MODULE_PARM_DESC(max_volume,
-		 "Highest digital volume register value accepted (default 0xdf, the OEM uncalibrated limit)");
-
-static bool force_unmute;
-module_param(force_unmute, bool, 0644);
-MODULE_PARM_DESC(force_unmute,
-		 "Unmute without waiting for the amplifier PLL lock flag (bring-up only)");
-
 /* Registers that are read-modify-written must be read twice to be trusted. */
 static int fs19xx_read_stable(struct fs19xx_priv *fs19xx, unsigned int reg,
 			      unsigned int *val)
@@ -189,12 +184,13 @@ static int fs19xx_read_stable(struct fs19xx_priv *fs19xx, unsigned int reg,
 		ret = regmap_read(fs19xx->regmap, reg, &cur);
 		if (ret)
 			return ret;
-		if (i && cur == prev)
-			break;
+		if (i && cur == prev) {
+			*val = cur;
+			return 0;
+		}
 		prev = cur;
 	}
-	*val = cur;
-	return 0;
+	return -EIO;
 }
 
 static int fs19xx_apply_unit(struct fs19xx_priv *fs19xx,
@@ -232,22 +228,30 @@ static int fs19xx_apply_unit(struct fs19xx_priv *fs19xx,
 					return 0;
 			}
 			dev_dbg(fs19xx->dev, "wait on reg 0x%02x timed out\n", addr);
-			return 0;
+			return -ETIMEDOUT;
 		}
 		default:
-			return 0;
+			return -EINVAL;
 		}
 	}
 
-	if (pos == 0 && len == 15)
-		return regmap_write(fs19xx->regmap, addr, value);
-
-	/* The OEM driver keeps the mask in 16 bits; match that. */
-	mask = (((1U << (len + 1)) - 1) << pos) & 0xffff;
-	ret = fs19xx_read_stable(fs19xx, addr, &cur);
-	if (ret)
-		return ret;
-	cur = (cur & ~mask) | (((unsigned int)value << pos) & mask);
+	if (pos + len >= 16)
+		return -EINVAL;
+	if (pos == 0 && len == 15) {
+		cur = value;
+	} else {
+		/* The OEM driver keeps the mask in 16 bits; match that. */
+		mask = (((1U << (len + 1)) - 1) << pos) & 0xffff;
+		ret = fs19xx_read_stable(fs19xx, addr, &cur);
+		if (ret)
+			return ret;
+		cur = (cur & ~mask) | (((unsigned int)value << pos) & mask);
+	}
+	/* Preset tables cannot bypass the runtime unmute gate or volume ceiling. */
+	if (addr == FS19XX_REG_DACCTRL)
+		cur |= FS19XX_DACCTRL_MUTE_BIT;
+	if (addr == FS19XX_REG_VOLCTRL && (cur >> 8) > FS19XX_VOL_MAX)
+		cur = (FS19XX_VOL_MAX << 8) | (cur & 0xff);
 	return regmap_write(fs19xx->regmap, addr, cur);
 }
 
@@ -274,7 +278,7 @@ static int fs19xx_write_tables(struct fs19xx_priv *fs19xx)
 static int fs19xx_reset_chip(struct fs19xx_priv *fs19xx)
 {
 	unsigned int val = 0;
-	int i;
+	int i, ret;
 
 	if (fs19xx->gpio_reset) {
 		gpiod_set_value_cansleep(fs19xx->gpio_reset, 1);
@@ -287,7 +291,9 @@ static int fs19xx_reset_chip(struct fs19xx_priv *fs19xx)
 		regmap_write(fs19xx->regmap, FS19XX_REG_PWRCTRL, FS19XX_PWRCTRL_RESET);
 		regmap_read(fs19xx->regmap, FS19XX_REG_PWRCTRL, &val);
 		msleep(15);
-		regmap_write(fs19xx->regmap, FS19XX_REG_PWRCTRL, FS19XX_PWRCTRL_PWDN);
+		ret = regmap_write(fs19xx->regmap, FS19XX_REG_PWRCTRL, FS19XX_PWRCTRL_PWDN);
+		if (ret)
+			return ret;
 		if (regmap_read(fs19xx->regmap, FS19XX_REG_CHIPINI, &val))
 			continue;
 		if (val == FS19XX_CHIPINI_DONE_A || val == FS19XX_CHIPINI_DONE_B)
@@ -320,10 +326,10 @@ static int fs19xx_chip_init(struct fs19xx_priv *fs19xx)
 	return regmap_write(fs19xx->regmap, FS19XX_REG_SYSCTRL, 0);
 }
 
-static int fs19xx_set_volume_reg(struct fs19xx_priv *fs19xx)
+static int fs19xx_set_volume_reg(struct fs19xx_priv *fs19xx, unsigned int volume)
 {
 	return regmap_write(fs19xx->regmap, FS19XX_REG_VOLCTRL,
-			    (fs19xx->volume << 8) | 0x00c0);
+			    (volume << 8) | 0x00c0);
 }
 
 /* Everything except the DAC unmute and thermal sensing; DAC stays muted. */
@@ -351,7 +357,10 @@ static int fs19xx_chip_start(struct fs19xx_priv *fs19xx)
 		ret = regmap_write(fs19xx->regmap, FS19XX_REG_PLLCTRL2, FS19XX_PLL_C2);
 	if (!ret)
 		ret = regmap_write(fs19xx->regmap, FS19XX_REG_PLLCTRL3, FS19XX_PLL_C3);
-	regmap_write(fs19xx->regmap, FS19XX_REG_OTPACC, 0);
+	if (ret)
+		regmap_write(fs19xx->regmap, FS19XX_REG_OTPACC, 0);
+	else
+		ret = regmap_write(fs19xx->regmap, FS19XX_REG_OTPACC, 0);
 	if (ret)
 		return ret;
 
@@ -361,7 +370,7 @@ static int fs19xx_chip_start(struct fs19xx_priv *fs19xx)
 	ret = regmap_write(fs19xx->regmap, FS19XX_REG_PWRCTRL, FS19XX_PWRCTRL_RUN);
 	if (ret)
 		return ret;
-	ret = fs19xx_set_volume_reg(fs19xx);
+	ret = fs19xx_set_volume_reg(fs19xx, fs19xx->volume);
 	if (ret)
 		return ret;
 	return regmap_write(fs19xx->regmap, FS19XX_REG_DACCTRL, FS19XX_DACCTRL_MUTE);
@@ -382,48 +391,61 @@ static void fs19xx_unmute_work(struct work_struct *work)
 {
 	struct fs19xx_priv *fs19xx = container_of(to_delayed_work(work),
 						  struct fs19xx_priv, unmute_work);
-	unsigned int status = 0, tsctrl;
-	bool locked = false;
-	int i, ret;
-
-	/*
-	 * The bit clock can take a while to appear after the stream starts. Poll
-	 * without holding the lock across the sleeps so a stream stop never waits.
-	 */
-	for (i = 0; i < FS19XX_LOCK_POLL_COUNT && !locked; i++) {
-		scoped_guard(mutex, &fs19xx->lock) {
-			if (!fs19xx->powered)
-				return;
-			ret = regmap_read(fs19xx->regmap, FS19XX_REG_STATUS, &status);
-			locked = !ret && (status & FS19XX_STATUS_PLLS);
-		}
-		if (!locked && force_unmute && i == 2)
-			locked = true;
-		if (!locked)
-			msleep(FS19XX_LOCK_POLL_MS);
-	}
-	dev_info_once(fs19xx->dev, "status 0x%04x after %d polls\n", status, i);
-	if (!locked) {
-		dev_warn(fs19xx->dev, "PLL not locked (status 0x%04x), staying muted\n", status);
-		return;
-	}
+	unsigned int status, tsctrl;
+	int ret;
 
 	guard(mutex)(&fs19xx->lock);
 
 	if (!fs19xx->powered)
 		return;
-	if (regmap_write(fs19xx->regmap, FS19XX_REG_DACCTRL, FS19XX_DACCTRL_RUN))
-		return;
+	ret = regmap_read(fs19xx->regmap, FS19XX_REG_STATUS, &status);
+	if (ret)
+		goto stop;
+	if (!(status & FS19XX_STATUS_PLLS)) {
+		if (++fs19xx->pll_polls < FS19XX_LOCK_POLL_COUNT) {
+			mod_delayed_work(system_wq, &fs19xx->unmute_work,
+					 msecs_to_jiffies(FS19XX_LOCK_POLL_MS));
+			return;
+		}
+		ret = -ETIMEDOUT;
+		goto stop;
+	}
+	ret = regmap_write(fs19xx->regmap, FS19XX_REG_DACCTRL, FS19XX_DACCTRL_RUN);
+	if (ret)
+		goto stop;
 	msleep(10);
-	if (!fs19xx_read_stable(fs19xx, FS19XX_REG_TSCTRL, &tsctrl) &&
-	    !(tsctrl & FS19XX_TSCTRL_TSEN))
-		regmap_write(fs19xx->regmap, FS19XX_REG_TSCTRL, tsctrl | FS19XX_TSCTRL_TSEN);
+	ret = fs19xx_read_stable(fs19xx, FS19XX_REG_TSCTRL, &tsctrl);
+	if (ret)
+		goto stop;
+	if (!(tsctrl & FS19XX_TSCTRL_TSEN)) {
+		ret = regmap_write(fs19xx->regmap, FS19XX_REG_TSCTRL,
+				   tsctrl | FS19XX_TSCTRL_TSEN);
+		if (ret)
+			goto stop;
+		ret = fs19xx_read_stable(fs19xx, FS19XX_REG_TSCTRL, &tsctrl);
+		if (ret)
+			goto stop;
+		if (!(tsctrl & FS19XX_TSCTRL_TSEN)) {
+			ret = -EIO;
+			goto stop;
+		}
+	}
+	return;
+
+stop:
+	dev_err(fs19xx->dev, "unmute failed: %d; amplifier reset\n", ret);
+	fs19xx->powered = false;
+	fs19xx_chip_stop(fs19xx);
 }
 
 static int fs19xx_power_on(struct fs19xx_priv *fs19xx)
 {
 	int ret;
 
+	if (fs19xx->removing || !fs19xx->preset)
+		return -ENODEV;
+	if (fs19xx->suspended)
+		return -EBUSY;
 	if (fs19xx->powered)
 		return 0;
 
@@ -436,20 +458,19 @@ static int fs19xx_power_on(struct fs19xx_priv *fs19xx)
 		return ret;
 	}
 	fs19xx->powered = true;
-	schedule_delayed_work(&fs19xx->unmute_work,
-			      msecs_to_jiffies(FS19XX_UNMUTE_DELAY_MS));
+	fs19xx->pll_polls = 0;
+	mod_delayed_work(system_wq, &fs19xx->unmute_work,
+			 msecs_to_jiffies(FS19XX_UNMUTE_DELAY_MS));
 	return 0;
 }
 
 static void fs19xx_power_off(struct fs19xx_priv *fs19xx)
 {
+	/* The worker checks powered under this lock; never drop it during stop. */
+	cancel_delayed_work(&fs19xx->unmute_work);
 	if (!fs19xx->powered)
 		return;
 	fs19xx->powered = false;
-	/* The work takes the lock; it sees !powered and returns. */
-	mutex_unlock(&fs19xx->lock);
-	cancel_delayed_work_sync(&fs19xx->unmute_work);
-	mutex_lock(&fs19xx->lock);
 	fs19xx_chip_stop(fs19xx);
 }
 
@@ -483,15 +504,31 @@ static int fs19xx_dai_mute(struct snd_soc_dai *dai, int mute, int stream)
 
 	guard(mutex)(&fs19xx->lock);
 
