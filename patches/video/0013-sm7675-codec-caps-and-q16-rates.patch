+int iris_check_inst_mbps(struct iris_inst *inst)
+{
+	const struct platform_inst_caps *caps = iris_get_inst_caps(inst, inst->codec);
+	u32 frame_rate = inst->frame_rate_q16 ? inst->frame_rate_q16 : inst->frame_rate << 16;
+	u32 operating_rate = inst->operating_rate_q16 ? inst->operating_rate_q16 :
+								inst->operating_rate << 16;
+	u64 rate = max(frame_rate, operating_rate);
+
+	/* Decoder rate is measured during queueing, not a declared stream interval. */
+	if (inst->domain != ENCODER || !caps->max_mbps)
+		return 0;
+	if (rate > ((u64)min(caps->max_frame_rate, caps->max_operating_rate) << 16) ||
+	    (u64)iris_get_mbpf(inst) * rate > ((u64)caps->max_mbps << 16))
+		return -ENOMEM;
+	return 0;
