+/* Clear-video intersection: Uke Cliffs XML and OnePlus SM7675 1138e00f.
+ * shortcut: 4096x2176 and larger coded-height conflicts need target acceptance.
+ */
+#define SM7675_CAPS(minimum, mbps, fps, vsp, vpp, fw_vpp) { \
+	.min_frame_width = minimum, .max_frame_width = 4096, \
+	.min_frame_height = minimum, .max_frame_height = 4096, \
+	.max_mbpf = 34560, .max_mbps = mbps, \
+	.mb_cycles_vsp = vsp, .mb_cycles_vpp = vpp, \
+	.mb_cycles_fw = 489583, .mb_cycles_fw_vpp = fw_vpp, \
+	.max_frame_rate = fps, .max_operating_rate = fps, \
+}
+
+static struct platform_inst_caps platform_inst_cap_sm7675 =
+	SM7675_CAPS(96, 2073600, 480, 25, 200, 66234);
+static const struct platform_inst_caps sm7675_hevc_dec_caps =
+	SM7675_CAPS(96, 2088960, 480, 25, 200, 66234);
+static const struct platform_inst_caps sm7675_vp9_dec_caps =
+	SM7675_CAPS(96, 2073600, 200, 60, 200, 66234);
+static const struct platform_inst_caps sm7675_h264_enc_caps =
+	SM7675_CAPS(128, 2073600, 480, 25, 675, 48405);
+static const struct platform_inst_caps sm7675_hevc_enc_caps =
+	SM7675_CAPS(96, 2088960, 480, 25, 675, 48405);
+#undef SM7675_CAPS
+
+static const struct platform_inst_caps *sm7675_get_inst_caps(struct iris_inst *inst, u32 codec)
+{
+	if (codec != V4L2_PIX_FMT_H264 && codec != V4L2_PIX_FMT_HEVC &&
+	    codec != V4L2_PIX_FMT_VP9)
+		codec = inst->codec;
+	if (inst->domain == ENCODER)
+		return codec == V4L2_PIX_FMT_HEVC ? &sm7675_hevc_enc_caps : &sm7675_h264_enc_caps;
+	if (codec == V4L2_PIX_FMT_HEVC)
+		return &sm7675_hevc_dec_caps;
+	if (codec == V4L2_PIX_FMT_VP9)
+		return &sm7675_vp9_dec_caps;
+	return &platform_inst_cap_sm7675;
+}
 
