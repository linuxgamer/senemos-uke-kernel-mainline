 }
 
+static void iris_sm7675_limit_level(struct platform_inst_fw_cap *cap, s64 level)
+{
+	if (!cap->cap_id)
+		return;
+	cap->max = min(cap->max, level);
+	cap->step_or_mask &= GENMASK_ULL(level, 0);
+	cap->value = min(cap->value, cap->max);
+}
+
+static void iris_sm7675_limit_caps(struct iris_core *core)
+{
+	struct platform_inst_fw_cap *caps;
+	u32 domain, id;
+
+	if (core->iris_platform_data != &sm7675_data)
+		return;
+	for (domain = 0; domain < 2; domain++) {
+		caps = domain ? core->inst_fw_caps_enc : core->inst_fw_caps_dec;
+		iris_sm7675_limit_level(&caps[LEVEL_H264], V4L2_MPEG_VIDEO_H264_LEVEL_5_2);
+		iris_sm7675_limit_level(&caps[LEVEL_HEVC], V4L2_MPEG_VIDEO_HEVC_LEVEL_5_1);
+		iris_sm7675_limit_level(&caps[LEVEL_VP9], V4L2_MPEG_VIDEO_VP9_LEVEL_5_1);
+	}
+	caps = core->inst_fw_caps_enc;
+	for (id = 1; id < INST_FW_CAP_MAX; id++) {
+		if (id == BITRATE || id == BITRATE_PEAK ||
+		    (id >= LAYER0_BITRATE_H264 && id <= LAYER5_BITRATE_HEVC)) {
+			caps[id].max = min_t(s64, caps[id].max, 100000000);
+			caps[id].value = min(caps[id].value, caps[id].max);
+		}
+	}
+	/* shortcut: expose Main10 encode after the P010 buffer/HFI chain is implemented. */
+	caps[PROFILE_HEVC].max = V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_STILL_PICTURE;
+	caps[PROFILE_HEVC].step_or_mask &= BIT(V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN) |
+					BIT(V4L2_MPEG_VIDEO_HEVC_PROFILE_MAIN_STILL_PICTURE);
+	caps[PROFILE_HEVC].value = min(caps[PROFILE_HEVC].value, caps[PROFILE_HEVC].max);
+}
+
 void iris_session_init_caps(struct iris_core *core)
 {
 	const struct platform_inst_fw_cap *caps;
@@ -497,6 +534,7 @@
 		core->inst_fw_caps_enc[cap_id].hfi_id = caps[i].hfi_id;
 		core->inst_fw_caps_enc[cap_id].set = caps[i].set;
 	}
+	iris_sm7675_limit_caps(core);
 }
 
