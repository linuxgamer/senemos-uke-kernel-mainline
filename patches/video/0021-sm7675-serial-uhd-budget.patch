Subject: [PATCH] media: iris: reserve one existing OPP for serial UHD decode

A single queued UHD decoder input cannot overlap subsequent client work. Raise the calculated SM7675 decoder vote by one currently available OPP. Keep higher queued demand, thermal OPP availability, other platforms, encoders, lower resolutions and runtime idle collapse. This is an experimental latency candidate; original Chrome acceptance remains separate.

--- a/drivers/media/platform/qcom/iris/iris_power.c
+++ b/drivers/media/platform/qcom/iris/iris_power.c
@@ -11,6 +11,7 @@
 #include "iris_instance.h"
 #include "iris_power.h"
 #include "iris_resources.h"
+#include "iris_utils.h"
 #include "iris_vpu_common.h"
 
 static u32 iris_calc_bw(struct iris_inst *inst, struct icc_vote_data *data)
@@ -99,17 +100,45 @@
 	return ret;
 }
 
+static u64 iris_serial_decoder_rate(struct iris_inst *inst, unsigned int queued, u64 freq)
+{
+	struct v4l2_pix_format_mplane *f = &inst->fmt_src->fmt.pix_mp;
+	unsigned long rate = min_t(u64, freq, ULONG_MAX);
+	struct dev_pm_opp *opp;
+
+	if (inst->core->iris_platform_data != &sm7675_data || inst->domain != DECODER ||
+	    queued != 1 || !inst->operating_rate ||
+	    NUM_MBS_PER_FRAME(f->height, f->width) < NUM_MBS_PER_FRAME(2160, 3840))
+		return freq;
+
+	/* A serial UHD client needs service-time headroom before its next input. */
+	opp = dev_pm_opp_find_freq_ceil(inst->core->dev, &rate);
+	if (IS_ERR(opp))
+		return freq;
+	dev_pm_opp_put(opp);
+	if (rate == ULONG_MAX)
+		return freq;
+	rate++;
+	opp = dev_pm_opp_find_freq_ceil(inst->core->dev, &rate);
+	if (IS_ERR(opp))
+		return freq;
+	dev_pm_opp_put(opp);
+	return rate;
+}
+
 static int iris_scale_clocks(struct iris_inst *inst)
 {
 	const struct vpu_ops *vpu_ops = inst->core->iris_platform_data->vpu_ops;
 	struct v4l2_m2m_ctx *m2m_ctx = inst->m2m_ctx;
 	struct v4l2_m2m_buffer *buffer, *n;
 	struct iris_buffer *buf;
+	unsigned int queued = 0;
 	size_t data_size = 0;
 
 	v4l2_m2m_for_each_src_buf_safe(m2m_ctx, buffer, n) {
 		buf = to_iris_buffer(&buffer->vb);
 		data_size = max(data_size, buf->data_size);
+		queued++;
 	}
 
 	inst->max_input_data_size = data_size;
@@ -117,6 +146,7 @@
 		return 0;
 
 	inst->power.min_freq = vpu_ops->calc_freq(inst, inst->max_input_data_size);
+	inst->power.min_freq = iris_serial_decoder_rate(inst, queued, inst->power.min_freq);
 
 	return iris_set_clocks(inst);
 }
