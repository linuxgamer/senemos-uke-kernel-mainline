+		return -EBUSY;
 
 	for (i = ARRAY_SIZE(sm7675_fw_regions) - 1; i >= 0; i--) {
 		if (!(memory->mapped & BIT(i)))
@@ -131,3 +142,279 @@
 
 	return 0;
 }
+
+/* Native PM references and the OEM reset transaction have different lifetimes. */
+#define SM7675_CTRL_PD BIT(0)
+#define SM7675_HW_PD BIT(1)
+#define SM7675_AXI_CLK BIT(2)
+#define SM7675_CTRL_CLK BIT(3)
+#define SM7675_HW_CLK BIT(4)
+#define SM7675_BUS_RESET BIT(5)
+#define SM7675_CORE_RESET BIT(6)
+
+#define SM7675_NOC_RESET (AON_BASE_OFFS + 0x18)
+#define SM7675_NOC_CLOCK (AON_BASE_OFFS + 0x20)
+#define SM7675_AON_SPARE (AON_BASE_OFFS + 0x28)
+
+enum sm7675_reset { SM7675_BUS, SM7675_CORE, SM7675_VCODEC };
+enum sm7675_off_step {
+	SM7675_OFF_HW,
+	SM7675_OFF_CPU,
+	SM7675_OFF_BUS_ASSERT,
+	SM7675_OFF_VCODEC_ASSERT,
+	SM7675_OFF_RETAIN,
+	SM7675_OFF_CORE_ASSERT,
+	SM7675_OFF_VCODEC_DEASSERT,
+	SM7675_OFF_BUS_DEASSERT,
+	SM7675_OFF_CORE_DEASSERT,
+	SM7675_OFF_NOC,
+	SM7675_OFF_XO_ASSERT,
+	SM7675_OFF_XO_DEASSERT,
+	SM7675_OFF_CLOCKS,
+	SM7675_OFF_RELEASE,
+};
+
+int iris_sm7675_power_on_controller(struct iris_core *core)
+{
+	struct iris_fw_memory *memory = core->fw_memory;
+	int ret;
+
+	if (!memory || memory->power || memory->off_step || memory->power_error)
+		return -EBUSY;
+	ret = iris_enable_power_domains(core, core->pmdomain_tbl->pd_devs[IRIS_CTRL_POWER_DOMAIN]);
+	if (ret < 0)
+		return ret;
+	memory->power |= SM7675_CTRL_PD;
+	/* Keep possible asserted state even if the reset readback fails. */
+	memory->power |= SM7675_BUS_RESET;
+	ret = reset_control_assert(core->resets[SM7675_BUS].rstc);
+	if (ret)
+		return ret;
+	memory->power |= SM7675_CORE_RESET;
+	ret = reset_control_assert(core->resets[SM7675_CORE].rstc);
+	if (ret)
+		return ret;
+	usleep_range(1000, 1100);
+	ret = reset_control_deassert(core->resets[SM7675_BUS].rstc);
+	if (ret)
+		return ret;
+	memory->power &= ~SM7675_BUS_RESET;
+	ret = reset_control_deassert(core->resets[SM7675_CORE].rstc);
+	if (ret)
+		return ret;
+	memory->power &= ~SM7675_CORE_RESET;
+	ret = iris_prepare_enable_clock(core, IRIS_AXI_CLK);
+	if (ret)
+		return ret;
+	memory->power |= SM7675_AXI_CLK;
+	ret = iris_prepare_enable_clock(core, IRIS_CTRL_CLK);
+	if (!ret)
+		memory->power |= SM7675_CTRL_CLK;
+	return ret;
+}
+
+int iris_sm7675_power_on_hw(struct iris_core *core)
+{
+	struct iris_fw_memory *memory = core->fw_memory;
+	int ret;
+
+	ret = iris_enable_power_domains(core, core->pmdomain_tbl->pd_devs[IRIS_HW_POWER_DOMAIN]);
+	if (ret < 0)
+		return ret;
+	memory->power |= SM7675_HW_PD;
+	ret = iris_prepare_enable_clock(core, IRIS_HW_CLK);
+	if (!ret)
+		memory->power |= SM7675_HW_CLK;
+	return ret;
+}
+
+static int iris_sm7675_put_domain(struct iris_core *core, u32 flag, unsigned int id)
+{
+	struct iris_fw_memory *memory = core->fw_memory;
+	int ret;
+
+	if (!(memory->power & flag))
+		return 0;
+	/* put_sync consumes the reference even on error; never put it twice. */
+	memory->power &= ~flag;
+	ret = pm_runtime_put_sync(core->pmdomain_tbl->pd_devs[id]);
+	if (ret < 0)
+		memory->power_error = ret;
+	return ret < 0 ? ret : 0;
+}
+
+int iris_sm7675_power_off(struct iris_core *core)
+{
+	struct iris_fw_memory *memory = core->fw_memory;
+	u32 value;
+	int ret;
+
+	if (!memory)
+		return 0;
+	if (memory->power_error)
+		return memory->power_error;
+	/* Startup failed before the controller clock became accessible. */
+	if (!(memory->power & SM7675_CTRL_CLK)) {
+		if (memory->power & SM7675_CORE_RESET) {
+			ret = reset_control_deassert(core->resets[SM7675_CORE].rstc);
+			if (ret)
+				return ret;
+			memory->power &= ~SM7675_CORE_RESET;
+		}
+		if (memory->power & SM7675_BUS_RESET) {
+			ret = reset_control_deassert(core->resets[SM7675_BUS].rstc);
+			if (ret)
+				return ret;
+			memory->power &= ~SM7675_BUS_RESET;
+		}
+		goto release;
+	}
+
+	/* Resume at the failed step; do not poll the CPU while its reset is held. */
+	switch (memory->off_step) {
+	case SM7675_OFF_HW:
+		if (memory->power & SM7675_HW_PD) {
+			ret = dev_pm_genpd_set_hwmode(core->pmdomain_tbl->pd_devs[IRIS_HW_POWER_DOMAIN],
+						    false);
+			if (ret)
+				return ret;
+			if ((memory->power & SM7675_HW_CLK) && !iris_vpu3x_hw_power_collapsed(core)) {
+				ret = iris_vpu33_2p_quiesce(core);
+				if (ret)
+					return ret;
+			}
+			ret = iris_sm7675_put_domain(core, SM7675_HW_PD, IRIS_HW_POWER_DOMAIN);
+			if (ret)
+				return ret;
+		}
+		memory->off_step = SM7675_OFF_CPU;
+		fallthrough;
+	case SM7675_OFF_CPU:
+		writel(MSK_SIGNAL_FROM_TENSILICA | MSK_CORE_POWER_ON,
+		       core->reg_base + CPU_CS_X2RPMH);
+		value = readl(core->reg_base + WRAPPER_IRIS_CPU_NOC_LPI_CONTROL);
+		writel(value | BIT(0), core->reg_base + WRAPPER_IRIS_CPU_NOC_LPI_CONTROL);
+		ret = readl_poll_timeout(core->reg_base + WRAPPER_IRIS_CPU_NOC_LPI_STATUS,
+					value, value & BIT(0), 200, 2000);
+		if (ret)
+			return ret;
+		writel(0, core->reg_base + WRAPPER_DEBUG_BRIDGE_LPI_CONTROL);
+		ret = readl_poll_timeout(core->reg_base + WRAPPER_DEBUG_BRIDGE_LPI_STATUS,
+					value, value == 0, 200, 2000);
+		if (ret)
+			return ret;
+		writel(CTL_AXI_CLK_HALT | CTL_CLK_HALT,
+		       core->reg_base + WRAPPER_TZ_CTL_AXI_CLOCK_CONFIG);
+		writel(RESET_HIGH, core->reg_base + WRAPPER_TZ_QNS4PDXFIFO_RESET);
+		writel(0, core->reg_base + WRAPPER_TZ_QNS4PDXFIFO_RESET);
+		writel(0, core->reg_base + WRAPPER_TZ_CTL_AXI_CLOCK_CONFIG);
+		memory->off_step = SM7675_OFF_BUS_ASSERT;
+		fallthrough;
+	case SM7675_OFF_BUS_ASSERT:
+		ret = reset_control_assert(core->resets[SM7675_BUS].rstc);
+		if (ret)
+			return ret;
+		memory->off_step = SM7675_OFF_VCODEC_ASSERT;
+		fallthrough;
+	case SM7675_OFF_VCODEC_ASSERT:
+		ret = reset_control_assert(core->resets[SM7675_VCODEC].rstc);
+		if (ret)
+			return ret;
+		memory->off_step = SM7675_OFF_RETAIN;
+		fallthrough;
+	case SM7675_OFF_RETAIN:
+		ret = qcom_uke_videocc_set_retention(core->dev, true);
+		if (ret)
+			return ret;
+		memory->off_step = SM7675_OFF_CORE_ASSERT;
+		fallthrough;
+	case SM7675_OFF_CORE_ASSERT:
+		ret = reset_control_assert(core->resets[SM7675_CORE].rstc);
+		if (ret)
+			return ret;
+		usleep_range(400, 500);
+		memory->off_step = SM7675_OFF_VCODEC_DEASSERT;
+		fallthrough;
+	case SM7675_OFF_VCODEC_DEASSERT:
+		ret = reset_control_deassert(core->resets[SM7675_VCODEC].rstc);
+		if (ret)
+			return ret;
+		memory->off_step = SM7675_OFF_BUS_DEASSERT;
+		fallthrough;
+	case SM7675_OFF_BUS_DEASSERT:
+		ret = reset_control_deassert(core->resets[SM7675_BUS].rstc);
+		if (ret)
+			return ret;
+		memory->off_step = SM7675_OFF_CORE_DEASSERT;
+		fallthrough;
+	case SM7675_OFF_CORE_DEASSERT:
+		ret = reset_control_deassert(core->resets[SM7675_CORE].rstc);
+		if (ret)
+			return ret;
+		memory->off_step = SM7675_OFF_NOC;
+		fallthrough;
+	case SM7675_OFF_NOC:
+		value = readl(core->reg_base + SM7675_NOC_CLOCK);
+		writel(value | BIT(0), core->reg_base + SM7675_NOC_CLOCK);
+		value = readl(core->reg_base + SM7675_NOC_RESET);
+		writel(value | BIT(0), core->reg_base + SM7675_NOC_RESET);
+		ret = readl_poll_timeout(core->reg_base + SM7675_AON_SPARE,
+					value, !(value & BIT(0)), 1000, 50000);
+		if (ret)
+			return ret;
+		writel(value | BIT(1), core->reg_base + SM7675_AON_SPARE);
+		memory->off_step = SM7675_OFF_XO_ASSERT;
+		fallthrough;
+	case SM7675_OFF_XO_ASSERT:
+		ret = reset_control_assert(core->controller_resets[0].rstc);
+		if (ret)
+			return ret;
+		value = readl(core->reg_base + SM7675_NOC_RESET);
+		writel(value & ~BIT(0), core->reg_base + SM7675_NOC_RESET);
+		usleep_range(80, 100);
+		memory->off_step = SM7675_OFF_XO_DEASSERT;
+		fallthrough;
+	case SM7675_OFF_XO_DEASSERT:
+		ret = reset_control_deassert(core->controller_resets[0].rstc);
+		if (ret)
+			return ret;
+		value = readl(core->reg_base + SM7675_AON_SPARE);
+		writel(value & ~BIT(1), core->reg_base + SM7675_AON_SPARE);
+		value = readl(core->reg_base + SM7675_NOC_CLOCK);
