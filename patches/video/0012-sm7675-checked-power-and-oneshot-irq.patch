+/* SM7675 uses IRQF_ONESHOT and holds runtime power throughout response handling. */
+irqreturn_t iris_hfi_oneshot_handler(int irq, void *data)
+{
+	struct iris_core *core = data;
+	int ret;
+
+	if (!core)
+		return IRQ_NONE;
+	ret = pm_runtime_resume_and_get(core->dev);
+	mutex_lock(&core->lock);
+	if (ret < 0) {
+		iris_vpu_disable_irq(core);
+		core->state = IRIS_CORE_ERROR;
+		mutex_unlock(&core->lock);
+		return IRQ_HANDLED;
+	}
+	if (!core->irq_enabled || core->removing || core->state != IRIS_CORE_INIT) {
+		mutex_unlock(&core->lock);
+		goto put;
+	}
+	iris_vpu_clear_interrupt(core);
+	if (iris_vpu_watchdog(core, core->intr_status))
+		iris_vpu_disable_irq(core);
+	mutex_unlock(&core->lock);
+	core->hfi_sys_ops->sys_hfi_response_handler(core);
+put:
+	pm_runtime_mark_last_busy(core->dev);
+	pm_runtime_put_autosuspend(core->dev);
+	return IRQ_HANDLED;
+}
