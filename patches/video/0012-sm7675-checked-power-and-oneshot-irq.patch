From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] media: iris: own Cliffs reset, retention and oneshot IRQ lifetime

Follow OnePlus SM7675 1138e00f iris33 controller ordering and MiCode
5712080a clk-branch retention bits. Use the native VIDEOCC regmap through
an identity-checked provider helper. Keep partial startup and failed
teardown resources owned, resume reset cleanup at the failed step, and
never consume a PM reference twice after a failed put_sync.

Use a platform-only oneshot IRQ thread with a runtime power reference.
Enable after HFI ops and firmware setup; disable without waiting under
the mutex taken by the thread. Keep legacy platform IRQ behavior.
Preserve power errors through core and runtime PM cleanup. Firmware/PAS,
runtime races and failed administrative removal still need target work.

--- a/drivers/clk/qcom/videocc-sm8550.c
+++ b/drivers/clk/qcom/videocc-sm8550.c
@@ -4,11 +4,14 @@
  * SM7675 variant adapted from Alexandr Zubtsov's Palawan support.
  */
 
+#include <linux/clk.h>
 #include <linux/clk-provider.h>
+#include <linux/delay.h>
 #include <linux/module.h>
 #include <linux/platform_device.h>
 #include <linux/regmap.h>
 #include <linux/regulator/consumer.h>
+#include <linux/qcom-uke-video.h>
 
 #include <dt-bindings/clock/qcom,sm7675-videocc.h>
 
@@ -362,6 +365,45 @@
 	},
 };
 
+/* MiCode uke-v-oss 5712080a, clk_branch2_set_flags(): CBCR bits 14/13. */
+int qcom_uke_videocc_set_retention(struct device *consumer, bool enable)
+{
+	const u32 mask = BIT(14) | BIT(13);
+	struct clk *clk;
+	struct clk_hw *hw;
+	struct device *provider;
+	u32 value;
+	int ret;
+
+	if (!of_machine_is_compatible("xiaomi,uke") ||
+	    !of_device_is_compatible(consumer->of_node, "qcom,sm7675-iris"))
+		return -ENODEV;
+	clk = clk_get(consumer, "core");
+	if (IS_ERR(clk))
+		return PTR_ERR(clk);
+	hw = __clk_get_hw(clk);
+	provider = hw ? clk_hw_get_dev(hw) : NULL;
+	if (hw != &video_cc_mvs0c_clk.clkr.hw || !provider ||
+	    !of_device_is_compatible(provider->of_node, "qcom,sm7675-videocc")) {
+		ret = -ENODEV;
+		goto out;
+	}
+	ret = regmap_update_bits(video_cc_mvs0c_clk.clkr.regmap,
+				video_cc_mvs0c_clk.halt_reg, mask, enable ? mask : 0);
+	if (ret)
+		goto out;
+	/* Match the OEM settling interval and reject an ignored retention write. */
+	udelay(1);
+	ret = regmap_read(video_cc_mvs0c_clk.clkr.regmap,
+			  video_cc_mvs0c_clk.halt_reg, &value);
+	if (!ret && (value & mask) != (enable ? mask : 0))
+		ret = -EACCES;
+out:
+	clk_put(clk);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_uke_videocc_set_retention);
+
 static struct clk_branch video_cc_mvs0c_shift_clk = {
 	.halt_reg = 0x812c,
 	.halt_check = BRANCH_HALT_VOTED,
