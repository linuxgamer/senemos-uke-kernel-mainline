 #define AON_WRAPPER_MVP_NOC_CORE_SW_RESET	(AON_BASE_OFFS + 0x18)
 #define SW_RESET				BIT(0)
@@ -134,6 +136,84 @@
 	iris_vpu_power_off_hw(core);
 }
 
+static int iris_vpu33_2p_quiesce(struct iris_core *core)
+{
+	u32 value, i, count, busy;
+	void __iomem *control = core->reg_base + AON_WRAPPER_MVP_NOC_LPI_CONTROL;
+
+	value = readl(core->reg_base + WRAPPER_CORE_CLOCK_CONFIG);
+	if (value)
+		writel(CORE_CLK_RUN, core->reg_base + WRAPPER_CORE_CLOCK_CONFIG);
+
+	value = readl(core->reg_base + IRIS33_2P_DMA_SPARE3);
+	writel(value | BIT(0), core->reg_base + IRIS33_2P_DMA_SPARE3);
+
+	for (i = 0; i < 2; i++) {
+		int ret;
+
+		ret = readl_poll_timeout(core->reg_base + VCODEC_SS_IDLE_STATUSN + 4 * i,
+					value, value & BIT(22), 2000, 20000);
+		if (ret)
+			return ret;
+	}
+
+	for (count = 0; count < 1000; count++) {
+		value = readl(control);
+		writel(value | REQ_POWER_DOWN_PREP, control);
+		usleep_range(10, 20);
+		value = readl(core->reg_base + AON_WRAPPER_MVP_NOC_LPI_STATUS);
+		if ((value & NOC_LPI_STATUS_DONE) ||
+		    !(value & (NOC_LPI_STATUS_DENY | NOC_LPI_STATUS_ACTIVE)))
+			break;
+		value = readl(control);
+		writel(value & ~REQ_POWER_DOWN_PREP, control);
+		usleep_range(10, 20);
+	}
+	value = readl(control);
+	writel(value & ~REQ_POWER_DOWN_PREP, control);
+	if (count == 1000)
+		return -ETIMEDOUT;
+
+	for (count = 0; count < 101; count++) {
+		busy = iris_vpu33_2p_noc_busy(core->reg_base);
+		usleep_range(10, 20);
+		if (!busy)
+			break;
+	}
+	if (count == 101)
+		return -ETIMEDOUT;
+
+	writel(CORE_BRIDGE_SW_RESET | CORE_BRIDGE_HW_RESET_DISABLE,
+	       core->reg_base + CPU_CS_AHB_BRIDGE_SYNC_RESET);
+	writel(CORE_BRIDGE_HW_RESET_DISABLE, core->reg_base + CPU_CS_AHB_BRIDGE_SYNC_RESET);
+	writel(0, core->reg_base + CPU_CS_AHB_BRIDGE_SYNC_RESET);
+
+	return 0;
+}
+
+static void iris_vpu33_2p_power_off_hardware(struct iris_core *core)
+{
+	int ret;
+
+	if (iris_vpu3x_hw_power_collapsed(core))
+		goto disable_power;
+
+	ret = dev_pm_genpd_set_hwmode(core->pmdomain_tbl->pd_devs[IRIS_HW_POWER_DOMAIN], false);
+	if (!ret)
+		ret = iris_vpu33_2p_quiesce(core);
+	if (ret)
+		dev_err(core->dev, "Iris33 2P quiesce failed: %d\n", ret);
+
+disable_power:
+	/* Keep the native forced-shutdown policy; runtime fault handling is unqualified. */
+	iris_vpu_power_off_hw(core);
+}
+
+static void iris_vpu33_2p_set_preset_registers(struct iris_core *core)
+{
+	iris_vpu33_2p_write_presets(core->reg_base);
+}
+
 static int iris_vpu33_power_off_controller(struct iris_core *core)
 {
 	u32 xo_rst_tbl_size = core->iris_platform_data->controller_rst_tbl_size;
@@ -271,6 +351,16 @@
 	.calc_freq = iris_vpu3x_vpu4x_calculate_frequency,
 	.set_hwmode = iris_vpu_set_hwmode,
 };
+
+const struct vpu_ops iris_vpu33_2p_ops = {
+	.power_off_hw = iris_vpu33_2p_power_off_hardware,
+	.power_on_hw = iris_vpu_power_on_hw,
+	.power_off_controller = iris_vpu33_power_off_controller,
+	.power_on_controller = iris_vpu_power_on_controller,
+	.set_preset_registers = iris_vpu33_2p_set_preset_registers,
+	.calc_freq = iris_vpu3x_vpu4x_calculate_frequency,
+	.set_hwmode = iris_vpu_set_hwmode,
+};
 
