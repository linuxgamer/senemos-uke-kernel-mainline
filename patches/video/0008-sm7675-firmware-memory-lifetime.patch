--- /dev/null
+++ b/drivers/media/platform/qcom/iris/iris_sm7675_memory.c
@@ -0,0 +1,133 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2022-2024 Qualcomm Innovation Center, Inc.
+ * Iris33 mmap ABI: OnePlus SM7675 1138e00f, venus_hfi_queue.c.
+ * Regions cross-checked against Uke OS3.0.304.0 msm_video.ko, SHA256
+ * 2976535e5523521d953bdc762fc446e02bd5b564b28db34789d066b6070406df.
+ */
+#include <linux/dma-mapping.h>
+#include <linux/iommu.h>
+#include <linux/slab.h>
+
+#include "iris_core.h"
+#include "iris_vpu_common.h"
+
+struct iris_fw_memory {
+	struct iommu_domain *domain;
+	void *mmap;
+	dma_addr_t mmap_dma;
+	u32 mapped;
+};
+
+static const struct {
+	phys_addr_t physical;
+	u32 iova;
+	u32 payload_index;
+} sm7675_fw_regions[] = {
+	{ 0x0aae0000, 0xffae0000, 11 },
+	{ 0x00508000, 0xffadf000, 19 },
+	{ 0x17421000, 0xffade000, 21 },
+};
+
+int iris_sm7675_fw_memory_deinit(struct iris_core *core)
+{
+	struct iris_fw_memory *memory = core->fw_memory;
+	int i;
+
+	if (!memory)
+		return 0;
+
+	for (i = ARRAY_SIZE(sm7675_fw_regions) - 1; i >= 0; i--) {
+		if (!(memory->mapped & BIT(i)))
+			continue;
+		if (iommu_unmap(memory->domain, sm7675_fw_regions[i].iova, SZ_4K) != SZ_4K) {
+			dev_err(core->dev, "firmware region %d unmap incomplete\n", i);
+			continue;
+		}
+		memory->mapped &= ~BIT(i);
+	}
+	/* Keep ownership for a later cleanup attempt if an unmap was incomplete. */
+	if (memory->mapped)
+		return -EIO;
+
+	if (memory->mmap)
+		dma_free_coherent(core->dev, SZ_4K, memory->mmap, memory->mmap_dma);
+	kfree(memory);
+	core->fw_memory = NULL;
+
+	return 0;
+}
+
+int iris_sm7675_fw_memory_init(struct iris_core *core)
+{
+	struct iris_fw_memory *memory;
+	u32 *payload;
+	unsigned int i;
+	int ret;
+
+	if (core->fw_memory)
+		return -EBUSY;
+	if (core->iris_platform_data->dma_mask >= sm7675_fw_regions[2].iova)
+		return -EINVAL;
+	memory = kzalloc(sizeof(*memory), GFP_KERNEL);
+	if (!memory)
+		return -ENOMEM;
+	memory->domain = iommu_get_domain_for_dev(core->dev);
+	if (!memory->domain) {
+		kfree(memory);
+		return -ENODEV;
+	}
+	core->fw_memory = memory;
+
+	/* MMIO IOVAs are above the platform DMA allocation mask and cannot alias it. */
+	for (i = 0; i < ARRAY_SIZE(sm7675_fw_regions); i++) {
+		ret = iommu_map(memory->domain, sm7675_fw_regions[i].iova,
+				sm7675_fw_regions[i].physical, SZ_4K,
+				IOMMU_READ | IOMMU_WRITE | IOMMU_MMIO, GFP_KERNEL);
+		if (ret)
+			goto error;
+		memory->mapped |= BIT(i);
+	}
+
+	memory->mmap = dma_alloc_coherent(core->dev, SZ_4K, &memory->mmap_dma, GFP_KERNEL);
+	if (!memory->mmap) {
+		ret = -ENOMEM;
+		goto error;
+	}
+	if (upper_32_bits(memory->mmap_dma) || !IS_ALIGNED(memory->mmap_dma, SZ_4K) ||
+	    memory->mmap_dma < memory->domain->geometry.aperture_start ||
+	    memory->mmap_dma > core->iris_platform_data->dma_mask ||
+	    core->iris_platform_data->dma_mask - memory->mmap_dma < SZ_4K - 1) {
+		ret = -ERANGE;
+		goto error;
+	}
+
+	payload = memory->mmap;
+	memset(payload, 0, SZ_4K);
+	payload[0] = 1;
+	for (i = 0; i < ARRAY_SIZE(sm7675_fw_regions); i++) {
+		payload[sm7675_fw_regions[i].payload_index] = sm7675_fw_regions[i].iova;
+		payload[sm7675_fw_regions[i].payload_index + 1] = SZ_4K;
+	}
+
+	return 0;
+
+error:
+	iris_sm7675_fw_memory_deinit(core);
+	return ret;
+}
+
+int iris_sm7675_program_bootup_registers(struct iris_core *core)
+{
+	struct iris_fw_memory *memory = core->fw_memory;
+
+	if (!memory || !memory->mmap || memory->mapped != GENMASK(2, 0))
+		return -EINVAL;
+
+	dma_wmb();
+	writel(lower_32_bits(memory->mmap_dma), core->reg_base + 0xa0060);
+	writel(0xffade000, core->reg_base + 0xa0024);
+	writel(0x3000, core->reg_base + 0xa0028);
+
+	return 0;
+}
