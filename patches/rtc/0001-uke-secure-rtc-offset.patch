+static int pm8xxx_rtc_uke_store(struct pm8xxx_rtc *rtc_dd)
+{
+	struct qcom_uefi_rtc_info verified;
+	unsigned long size = sizeof(verified);
+	efi_status_t status;
+	int rc;
+
+	rc = efivar_lock();
+	if (rc)
+		return rc;
+	status = efivar_set_variable_locked(QCOM_UEFI_NAME, &QCOM_UEFI_GUID,
+			QCOM_UEFI_ATTRS, sizeof(rtc_dd->rtc_info), &rtc_dd->rtc_info, false);
+	if (status == EFI_SUCCESS)
+		status = efivar_get_variable(QCOM_UEFI_NAME, &QCOM_UEFI_GUID,
+				NULL, &size, &verified);
+	efivar_unlock();
+	if (status != EFI_SUCCESS)
+		return efi_status_to_err(status);
+	if (size != sizeof(verified) || memcmp(&verified, &rtc_dd->rtc_info, size))
+		return -EIO;
+	return 0;
+}
