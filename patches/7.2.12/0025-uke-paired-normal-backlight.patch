diff --git a/drivers/video/backlight/ktz8866.c b/drivers/video/backlight/ktz8866.c
index 80eb70e..849b61f 100644
--- a/drivers/video/backlight/ktz8866.c
+++ b/drivers/video/backlight/ktz8866.c
@@ -10,9 +10,12 @@
 #include <linux/gpio/consumer.h>
 #include <linux/i2c.h>
 #include <linux/module.h>
+#include <linux/mutex.h>
 #include <linux/of.h>
 #include <linux/regmap.h>
 
+#include "ktz8866-uke-levels.h"
+
 #define DEFAULT_BRIGHTNESS 1500
 #define MAX_BRIGHTNESS 2047
 #define REG_MAX 0x15
@@ -48,6 +51,11 @@ struct ktz8866 {
 	struct regmap *regmap;
 	bool led_on;
 	struct gpio_desc *enable_gpio;
+	struct ktz8866 *peer;
+	struct backlight_device *backlight;
+	struct mutex lock;
+	bool uke;
+	bool secondary;
 };
 
 static const struct regmap_config ktz8866_regmap_config = {
@@ -68,6 +76,224 @@ static int ktz8866_update_bits(struct ktz8866 *ktz, unsigned int reg,
 	return regmap_update_bits(ktz->regmap, reg, mask, val);
 }
 
+struct ktz8866_state {
+	unsigned int enable, lsb, msb;
+};
+
+static unsigned int ktz8866_uke_code(unsigned int level)
+{
+	return uke_normal_bl_remap[level * 1535 / MAX_BRIGHTNESS];
+}
+
+static int ktz8866_uke_level(unsigned int code)
+{
+	unsigned int level;
+
+	if (code > ktz8866_uke_code(MAX_BRIGHTNESS))
+		return -ERANGE;
+	if (!code)
+		return 0;
+	for (level = 1; level <= MAX_BRIGHTNESS; level++)
+		if (ktz8866_uke_code(level) > code)
+			return level - 1;
+	return MAX_BRIGHTNESS;
+}
+
+static int ktz8866_read_state(struct ktz8866 *ktz, struct ktz8866_state *state)
+{
+	int ret;
+
+	ret = regmap_read(ktz->regmap, BL_EN, &state->enable);
+	if (ret)
+		return ret;
+	/* A reset in progress is never a state that can be restored safely. */
+	if (state->enable & BIT(7))
+		return -EBUSY;
+	ret = regmap_read(ktz->regmap, BL_BRT_LSB, &state->lsb);
+	if (ret)
+		return ret;
+	return regmap_read(ktz->regmap, BL_BRT_MSB, &state->msb);
+}
+
+static int ktz8866_write_state(struct ktz8866 *ktz, const struct ktz8866_state *state)
+{
+	int ret;
+
+	ret = ktz8866_update_bits(ktz, BL_EN, BL_EN_BIT, state->enable & BL_EN_BIT);
+	if (ret)
+		return ret;
+	ret = ktz8866_write(ktz, BL_BRT_LSB, state->lsb);
+	if (ret)
+		return ret;
+	return ktz8866_write(ktz, BL_BRT_MSB, state->msb);
+}
+
+static int ktz8866_check_state(struct ktz8866 *ktz, const struct ktz8866_state *expected)
+{
+	struct ktz8866_state actual;
+	int ret = ktz8866_read_state(ktz, &actual);
+
+	if (ret)
+		return ret;
+	return actual.enable == expected->enable && actual.lsb == expected->lsb &&
+		actual.msb == expected->msb ? 0 : -EIO;
+}
+
+static int ktz8866_uke_brightness(struct ktz8866 *ktz)
+{
+	struct ktz8866_state primary, secondary;
+	int ret;
+
+	ret = ktz8866_read_state(ktz, &primary);
+	if (ret)
+		return ret;
+	ret = ktz8866_read_state(ktz->peer, &secondary);
+	if (ret)
+		return ret;
+	if ((primary.enable & BL_EN_BIT) != (secondary.enable & BL_EN_BIT) ||
+	    (primary.lsb & 7) != (secondary.lsb & 7) || primary.msb != secondary.msb)
+		return -EIO;
+	return primary.enable & BL_EN_BIT ?
+		ktz8866_uke_level((primary.msb << 3) | (primary.lsb & 7)) : 0;
+}
+
+static int ktz8866_uke_get_brightness(struct backlight_device *backlight_dev)
+{
+	struct ktz8866 *ktz = bl_get_data(backlight_dev);
+	int ret;
+
+	mutex_lock(&ktz->lock);
+	ret = ktz8866_uke_brightness(ktz);
+	mutex_unlock(&ktz->lock);
+	return ret;
+}
+
+static int ktz8866_uke_update_status(struct backlight_device *backlight_dev)
+{
+	struct ktz8866 *ktz = bl_get_data(backlight_dev);
+	struct ktz8866 *devices[] = { ktz, ktz->peer };
+	struct ktz8866_state old[2], next;
+	unsigned int level = backlight_get_brightness(backlight_dev), code;
+	int ret, rollback = 0, i;
+
+	if (level > MAX_BRIGHTNESS)
+		return -EINVAL;
+	code = ktz8866_uke_code(level);
+	mutex_lock(&ktz->lock);
+	for (i = 0; i < 2; i++) {
+		ret = ktz8866_read_state(devices[i], &old[i]);
+		if (ret)
+			goto unlock;
+	}
+	for (i = 0; i < 2; i++) {
+		next = old[i];
+		next.enable = (next.enable & ~BL_EN_BIT) | (code ? BL_EN_BIT : 0);
+		next.lsb = (next.lsb & ~7) | (code & 7);
+		next.msb = code >> 3;
+		ret = ktz8866_write_state(devices[i], &next);
+		if (!ret)
+			ret = ktz8866_check_state(devices[i], &next);
+		if (ret)
+			goto restore;
+	}
+	goto unlock;
+restore:
+	/* Separate I2C adapters cannot commit atomically; verify rollback of both. */
+	for (i = 1; i >= 0; i--) {
+		int error = ktz8866_write_state(devices[i], &old[i]);
+
+		if (!error)
+			error = ktz8866_check_state(devices[i], &old[i]);
+		if (error)
+			rollback = error;
+	}
+	if (rollback) {
+		dev_err(&ktz->client->dev, "paired brightness rollback failed: %d\n", rollback);
+		ret = rollback;
+	}
+unlock:
+	mutex_unlock(&ktz->lock);
+	return ret;
+}
+
+static const struct backlight_ops ktz8866_uke_backlight_ops = {
+	.update_status = ktz8866_uke_update_status,
+	.get_brightness = ktz8866_uke_get_brightness,
+};
+
+static void ktz8866_put_peer(void *data)
+{
+	put_device(data);
+}
+
+static int ktz8866_uke_probe(struct ktz8866 *ktz)
+{
+	struct backlight_properties props = { .type = BACKLIGHT_RAW,
+		.max_brightness = MAX_BRIGHTNESS, .scale = BACKLIGHT_SCALE_NON_LINEAR };
+	struct i2c_client *peer;
+	struct device_node *node;
+	unsigned int id, primary_cfg, peer_cfg;
+	int ret;
+
+	if (ktz->client->addr != 0x11)
+		return -EINVAL;
+	ret = regmap_read(ktz->regmap, DEVICE_ID, &id);
+	if (ret)
+		return ret;
+	if ((id & 0xf8) != 0x20)
+		return -ENODEV;
+	if (ktz->secondary)
+		return 0;
+	node = of_parse_phandle(ktz->client->dev.of_node, "xiaomi,secondary", 0);
+	if (!node)
+		return -EINVAL;
+	peer = of_find_i2c_device_by_node(node);
+	of_node_put(node);
+	if (!peer)
+		return -EPROBE_DEFER;
+	if (peer == ktz->client) {
+		put_device(&peer->dev);
+		return -EINVAL;
+	}
+	device_lock(&peer->dev);
+	if (!device_is_bound(&peer->dev)) {
+		device_unlock(&peer->dev);
+		put_device(&peer->dev);
+		return -EPROBE_DEFER;
+	}
+	ktz->peer = i2c_get_clientdata(peer);
+	if (!ktz->peer || !ktz->peer->secondary || peer->addr != 0x11) {
+		device_unlock(&peer->dev);
+		put_device(&peer->dev);
+		return -EINVAL;
+	}
+	ret = devm_add_action_or_reset(&ktz->client->dev, ktz8866_put_peer, &peer->dev);
+	if (ret) {
+		device_unlock(&peer->dev);
+		return ret;
+	}
+	if (!device_link_add(&ktz->client->dev, &peer->dev, DL_FLAG_AUTOREMOVE_CONSUMER)) {
+		device_unlock(&peer->dev);
+		return -ENOMEM;
+	}
+	device_unlock(&peer->dev);
+	ret = regmap_read(ktz->regmap, BL_CFG1, &primary_cfg);
+	if (ret)
+		return ret;
+	ret = regmap_read(ktz->peer->regmap, BL_CFG1, &peer_cfg);
+	if (ret)
+		return ret;
+	if ((primary_cfg & 0xd) != (peer_cfg & 0xd))
+		return -EINVAL;
+	ret = ktz8866_uke_brightness(ktz);
+	if (ret < 0)
+		return ret;
+	props.brightness = ret;
