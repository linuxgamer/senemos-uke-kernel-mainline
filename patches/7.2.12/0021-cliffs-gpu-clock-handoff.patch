diff --git a/drivers/clk/qcom/Kconfig b/drivers/clk/qcom/Kconfig
index c3554f8..adcfdcf 100644
--- a/drivers/clk/qcom/Kconfig
+++ b/drivers/clk/qcom/Kconfig
@@ -1504,6 +1504,14 @@ config SM_GCC_CLIFFS
 	  This is a v6.12 adaptation of the Uke-validated Android 6.1 driver.
 	  Say Y or M to enable peripheral clocks and resets, including USB.
 
+config SM_GPUCC_CLIFFS
+	tristate "Cliffs Graphics Clock Controller"
+	depends on ARM64 || COMPILE_TEST
+	select SM_GCC_CLIFFS
+	help
+	  Support the GPU clock provider used by Xiaomi Uke.
+	  Retain firmware clocks and voltage votes until consumer handoff.
+
 config SM_GPUCC_4450
 	tristate "SM4450 Graphics Clock Controller"
 	depends on ARM64 || COMPILE_TEST
