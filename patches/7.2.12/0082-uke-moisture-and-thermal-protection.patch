--- a/drivers/power/supply/qcom_battmgr_uke_control.h
+++ b/drivers/power/supply/qcom_battmgr_uke_control.h
@@ -52,6 +52,425 @@
 	return valid ? 0 : -EACCES;
 }
 
+struct qcom_battmgr_uke_protection {
+	u64 instance, received_ns;
+	u32 generation, firmware, source, enabled, moisture;
+};
+
+/* Fixed OEM USB properties only; a reported clear state is not a wet-test result. */
+static int qcom_battmgr_uke_protection_read(struct qcom_battmgr *battmgr,
+					 struct qcom_battmgr_uke_protection *result)
+{
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	u32 generation = qcom_battmgr_uke_generation(battmgr);
+	u64 began = ktime_get_boottime_ns();
+	unsigned long flags;
+	int ret;
+
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_MOISTURE_EN, 0);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_MOISTURE_STATUS, 0);
+	if (ret)
+		return ret;
+	spin_lock_irqsave(&tx->lock, flags);
+	if (!battmgr->service_up || tx->desynced || tx->suspended || tx->removing ||
+	    generation != tx->generation || ktime_get_boottime_ns() < began ||
+	    ktime_get_boottime_ns() - began > 5ULL * NSEC_PER_SEC ||
+	    battmgr->usb.moisture_enabled > 1 || battmgr->usb.moisture_status > 1) {
+		ret = -ESTALE;
+	} else {
+		*result = (struct qcom_battmgr_uke_protection) {
+			.instance = tx->instance_ns, .received_ns = ktime_get_boottime_ns(),
+			.generation = generation, .firmware = tx->firmware_generation,
+			.source = tx->source_generation, .enabled = battmgr->usb.moisture_enabled,
+			.moisture = battmgr->usb.moisture_status,
+		};
+		if (battmgr->protection.firmware != result->firmware ||
+		    battmgr->protection.source != result->source) {
+			battmgr->protection.inhibit_verified = false;
+			battmgr->protection.inhibit_owned = false;
+			battmgr->protection.dry_since_ns = 0;
+			battmgr->protection.dry_samples = 0;
+		}
+		battmgr->protection.received_ns = result->received_ns;
+		battmgr->protection.generation = result->generation;
+		battmgr->protection.firmware = result->firmware;
+		battmgr->protection.source = result->source;
+		battmgr->protection.enabled = result->enabled;
+		battmgr->protection.moisture = result->moisture;
+		if (result->moisture) {
+			battmgr->protection.wet_latched = true;
+			battmgr->protection.dry_since_ns = 0;
+			battmgr->protection.dry_samples = 0;
+		}
+	}
+	spin_unlock_irqrestore(&tx->lock, flags);
+	return ret;
+}
+
+static int qcom_battmgr_uke_external_guard(struct qcom_battmgr *battmgr)
+{
+	static const char * const names[] = { "charger", "connector", "connector2" };
+	struct iio_channel *channel;
+	enum iio_chan_type type;
+	unsigned int i;
+	int temperature, ret;
+
+	for (i = 0; i < ARRAY_SIZE(names); i++) {
+		if (battmgr->control.external_min[i] >= battmgr->control.external_max[i])
+			return -EACCES;
+		channel = iio_channel_get(battmgr->dev->parent, names[i]);
+		if (IS_ERR(channel))
+			return PTR_ERR(channel);
+		ret = iio_get_channel_type(channel, &type);
+		if (!ret && type != IIO_TEMP)
+			ret = -ENODATA;
+		if (!ret)
+			ret = iio_read_channel_processed(channel, &temperature);
+		iio_channel_release(channel);
+		if (ret)
+			return ret;
+		/* These processed channels are milli-Celsius, not battery deci-Celsius. */
+		if (temperature < battmgr->control.external_min[i] ||
+		    temperature >= battmgr->control.external_max[i])
+			return -ERANGE;
+	}
+	return 0;
+}
+
+static int qcom_battmgr_uke_protection_guard(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_uke_protection state;
+	int ret = qcom_battmgr_uke_protection_read(battmgr, &state);
+
+	if (ret)
+		return ret;
+	if (!state.enabled || state.moisture || battmgr->protection.wet_latched || battmgr->protection.faults)
+		return -EACCES;
+	return qcom_battmgr_uke_external_guard(battmgr);
+}
+
+static ssize_t uke_charge_protection_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	struct qcom_battmgr_uke_protection state;
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (!mutex_trylock(&battmgr->lock))
+		return -EBUSY;
+	ret = qcom_battmgr_uke_protection_read(battmgr, &state);
+	mutex_unlock(&battmgr->lock);
+	if (ret)
+		return ret;
+	return sysfs_emit(buf, "1 %llu %u %u %u %llu %u %u\n",
+		state.instance, state.generation, state.firmware, state.source,
+		state.received_ns, state.enabled, state.moisture);
+}
+static struct device_attribute dev_attr_uke_charge_protection =
+	__ATTR(uke_charge_protection, 0400, uke_charge_protection_show, NULL);
+
+static int qcom_battmgr_uke_moisture_enable(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_uke_protection before, after;
+	struct qcom_battmgr_property_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(BATTMGR_USB_PROPERTY_SET),
+		.property = cpu_to_le32(USB_MOISTURE_EN), .value = cpu_to_le32(1),
+	};
+	u32 generation = qcom_battmgr_uke_generation(battmgr);
+	int ret = qcom_battmgr_uke_control_check(battmgr);
+
+	if (ret)
+		return ret;
+	if (battmgr->control.moisture_uncertain)
+		return -EUCLEAN;
+	ret = qcom_battmgr_uke_external_guard(battmgr);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_USB_PROPERTY_GET, USB_ONLINE, 0);
+	if (ret)
+		return ret;
+	if (battmgr->usb.online)
+		return -EBUSY;
+	ret = qcom_battmgr_uke_protection_read(battmgr, &before);
+	if (ret)
+		return ret;
+	if (before.generation != generation)
+		return -ESTALE;
+	if (before.enabled)
+		return 0;
+	battmgr->control.moisture_generation = generation;
+	battmgr->control.moisture_enabling = true;
+	battmgr->control.moisture_uncertain = true;
+	ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+	battmgr->control.moisture_enabling = false;
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_uke_protection_read(battmgr, &after);
+	if (ret)
+		return ret;
+	if (!after.enabled || after.generation != generation ||
+	    after.instance != before.instance || after.firmware != before.firmware ||
+	    after.source != before.source)
+		return -EREMOTEIO;
+	battmgr->control.moisture_uncertain = false;
+	return 0;
+}
+
+static ssize_t uke_charge_moisture_enable_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!mutex_trylock(&battmgr->lock))
+		return -EBUSY;
+	ret = qcom_battmgr_uke_moisture_enable(battmgr);
+	mutex_unlock(&battmgr->lock);
+	return ret ? ret : (ssize_t)count;
+}
+static struct device_attribute dev_attr_uke_charge_moisture_enable =
+	__ATTR(uke_charge_moisture_enable, 0200, NULL, uke_charge_moisture_enable_store);
+
+static int qcom_battmgr_uke_input_suspend(struct qcom_battmgr *battmgr, bool write, bool suspend)
+{
+	struct qcom_battmgr_property_request request = {
+		.hdr.owner = cpu_to_le32(PMIC_GLINK_OWNER_BATTMGR),
+		.hdr.type = cpu_to_le32(PMIC_GLINK_REQ_RESP),
+		.hdr.opcode = cpu_to_le32(write ? UKE_INPUT_SUSPEND_SET : UKE_INPUT_SUSPEND_GET),
+		.property = cpu_to_le32(UKE_INPUT_SUSPEND_PROPERTY),
+		.value = cpu_to_le32(write && suspend),
+	};
+	int ret = qcom_battmgr_uke_control_check(battmgr);
+
+	if (ret)
+		return ret;
+	battmgr->protection.inhibit_verified = false;
+	if (write) {
+		battmgr->protection.inhibit_uncertain = true;
+		battmgr->protection.inhibit_verified = false;
+	}
+	battmgr->control.safety_request = true;
+	ret = qcom_battmgr_request(battmgr, &request, sizeof(request));
+	battmgr->control.safety_request = false;
+	if (!ret && !write) {
+		battmgr->protection.inhibit_readback_ns = ktime_get_boottime_ns();
+		battmgr->protection.inhibit_verified = battmgr->control.input_suspended &&
+			(battmgr->protection.wet_latched || battmgr->protection.faults);
+	}
+	return ret;
+}
+
+/* Bit 0: board thermal, bit 1: battery health/thermal, bit 2: voltage/current,
+ * bit 3: failed/missing/old measurements. Limits require periodic-guard evidence.
+ */
+static u32 qcom_battmgr_uke_charge_faults(struct qcom_battmgr *battmgr)
+{
+	const unsigned int properties[] = { BATT_HEALTH, BATT_PRESENT, BATT_TEMP, BATT_VOLT_NOW, BATT_CURR_NOW };
+	u64 began = ktime_get_boottime_ns();
+	s64 absolute_current;
+	u32 faults = 0;
+	unsigned int i;
+	int ret = qcom_battmgr_uke_external_guard(battmgr);
+
+	if (ret)
+		faults |= ret == -ERANGE ? 1 : 8;
+	for (i = 0; i < ARRAY_SIZE(properties); i++) {
+		ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, properties[i], 0);
+		if (ret)
+			return faults | 8;
+	}
+	if (!battmgr->info.present || battmgr->status.health != POWER_SUPPLY_HEALTH_GOOD ||
+	    (s32)battmgr->status.temperature < battmgr->control.temperature_min ||
+	    (s32)battmgr->status.temperature >= battmgr->control.temperature_max)
+		faults |= 2;
+	absolute_current = battmgr->status.current_now;
+	if (absolute_current < 0)
+		absolute_current = -absolute_current;
+	if (battmgr->status.voltage_now < battmgr->control.voltage_min_uv ||
+	    battmgr->status.voltage_now > battmgr->control.voltage_max_uv ||
+	    absolute_current > battmgr->control.current_abs_max_ua)
+		faults |= 4;
+	if (ktime_get_boottime_ns() < began || ktime_get_boottime_ns() - began > 5ULL * NSEC_PER_SEC)
+		faults |= 8;
+	return faults;
+}
+
+/* Never release another controller's inhibit or restore after an uncertain SET. */
+static int qcom_battmgr_uke_wet_guard_step(struct qcom_battmgr *battmgr)
+{
+	struct qcom_battmgr_uke_protection state;
+	u64 now = ktime_get_boottime_ns();
+	u32 faults;
+	int ret = qcom_battmgr_uke_control_check(battmgr);
+
+	if (ret)
+		return ret;
+	if (battmgr->protection.inhibit_uncertain)
+		return -EUCLEAN;
+	ret = qcom_battmgr_uke_protection_read(battmgr, &state);
+	if (ret)
+		return ret;
+	faults = qcom_battmgr_uke_charge_faults(battmgr);
+	if (!state.enabled)
+		faults |= 8;
+	battmgr->protection.faults |= faults;
+	if (!state.moisture && !battmgr->protection.wet_latched && !battmgr->protection.faults)
+		return 0;
+	ret = qcom_battmgr_uke_input_suspend(battmgr, false, false);
+	if (ret)
+		return ret;
+	if (state.moisture || faults) {
+		battmgr->protection.dry_since_ns = 0;
+		battmgr->protection.dry_samples = 0;
+		battmgr->protection.inhibit_verified = false;
+		if (!battmgr->control.input_suspended) {
+			ret = qcom_battmgr_uke_input_suspend(battmgr, true, true);
+			if (ret)
+				return ret;
+			ret = qcom_battmgr_uke_input_suspend(battmgr, false, false);
+			if (ret)
+				return ret;
+			if (!battmgr->control.input_suspended)
+				return -EREMOTEIO;
+			battmgr->protection.inhibit_owned = true;
+		}
+		battmgr->protection.inhibit_verified = true;
+		battmgr->protection.inhibit_uncertain = false;
+		return 0;
+	}
+	/* Repeated clear reports are required; this delay is not a drying guarantee. */
+	if (!battmgr->protection.dry_since_ns || now < battmgr->protection.dry_last_ns ||
+	    now - battmgr->protection.dry_last_ns > 5ULL * NSEC_PER_SEC) {
+		battmgr->protection.dry_since_ns = now;
+		battmgr->protection.dry_samples = 0;
+	}
+	battmgr->protection.dry_last_ns = now;
+	if (battmgr->protection.dry_samples < 3)
+		battmgr->protection.dry_samples++;
+	if (now < battmgr->protection.dry_since_ns ||
+	    now - battmgr->protection.dry_since_ns < 30ULL * NSEC_PER_SEC ||
+	    battmgr->protection.dry_samples < 3)
+		return 0;
+	ret = qcom_battmgr_uke_external_guard(battmgr);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_HEALTH, 0);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_PRESENT, 0);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_TEMP, 0);
+	if (ret)
+		return ret;
+	ret = qcom_battmgr_request_property(battmgr, BATTMGR_BAT_PROPERTY_GET, BATT_VOLT_NOW, 0);
+	if (ret)
+		return ret;
+	if (!battmgr->info.present || battmgr->status.health != POWER_SUPPLY_HEALTH_GOOD ||
+	    (s32)battmgr->status.temperature < battmgr->control.temperature_min ||
+	    (s32)battmgr->status.temperature >= battmgr->control.temperature_max ||
+	    battmgr->status.voltage_now < battmgr->control.voltage_min_uv ||
+	    battmgr->status.voltage_now > battmgr->control.voltage_max_uv)
+		return -ERANGE;
+	ret = qcom_battmgr_uke_protection_read(battmgr, &state);
+	if (ret)
+		return ret;
+	if (!state.enabled || state.moisture)
+		return -EACCES;
+	if (battmgr->protection.inhibit_owned) {
+		if (!battmgr->control.input_suspended)
+			return -EUCLEAN;
+		ret = qcom_battmgr_uke_input_suspend(battmgr, true, false);
+		if (ret)
+			return ret;
+		ret = qcom_battmgr_uke_input_suspend(battmgr, false, false);
+		if (ret)
+			return ret;
+		if (battmgr->control.input_suspended)
+			return -EREMOTEIO;
+	}
+	battmgr->protection.inhibit_owned = false;
+	battmgr->protection.inhibit_uncertain = false;
+	battmgr->protection.wet_latched = false;
+	battmgr->protection.faults = 0;
+	battmgr->protection.inhibit_verified = false;
+	battmgr->protection.dry_since_ns = 0;
+	battmgr->protection.dry_samples = 0;
+	return 0;
+}
+
+static int qcom_battmgr_uke_wet_guard(struct qcom_battmgr *battmgr)
+{
+	int ret = qcom_battmgr_uke_wet_guard_step(battmgr);
+
+	if (ret) {
+		battmgr->protection.dry_since_ns = 0;
+		battmgr->protection.dry_samples = 0;
+	}
+	return ret;
+}
+
+static ssize_t uke_charge_wet_guard_store(struct device *dev,
+		struct device_attribute *attr, const char *buf, size_t count)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	int ret;
+
+	if (!capable(CAP_SYS_ADMIN))
+		return -EPERM;
+	if (!sysfs_streq(buf, "1"))
+		return -EINVAL;
+	if (!mutex_trylock(&battmgr->lock))
+		return -EBUSY;
+	ret = qcom_battmgr_uke_wet_guard(battmgr);
+	mutex_unlock(&battmgr->lock);
+	return ret ? ret : (ssize_t)count;
+}
+static struct device_attribute dev_attr_uke_charge_wet_guard =
+	__ATTR(uke_charge_wet_guard, 0200, NULL, uke_charge_wet_guard_store);
+
+static ssize_t uke_charge_protection_state_show(struct device *dev,
+		struct device_attribute *attr, char *buf)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	u64 now = ktime_get_boottime_ns();
+	bool valid;
+	unsigned long flags;
+	ssize_t len;
+
+	mutex_lock(&battmgr->lock);
+	spin_lock_irqsave(&tx->lock, flags);
+	valid = battmgr->protection.received_ns && now >= battmgr->protection.received_ns &&
+		now - battmgr->protection.received_ns <= 5ULL * NSEC_PER_SEC &&
+		battmgr->protection.generation == tx->generation &&
+		battmgr->protection.firmware == tx->firmware_generation &&
+		battmgr->protection.source == tx->source_generation && battmgr->service_up &&
+		!tx->desynced && !tx->suspended && !tx->removing;
+	len = sysfs_emit(buf, "1 %llu %u %u %u %llu %u %u %u %u %u %llu %u\n",
+		tx->instance_ns, tx->generation, tx->firmware_generation, tx->source_generation,
+		battmgr->protection.received_ns, battmgr->protection.enabled,
+		battmgr->protection.moisture, valid, battmgr->protection.wet_latched,
+		battmgr->protection.inhibit_verified && valid &&
+		battmgr->protection.inhibit_readback_ns && now >= battmgr->protection.inhibit_readback_ns &&
+		now - battmgr->protection.inhibit_readback_ns <= 5ULL * NSEC_PER_SEC,
+		battmgr->protection.dry_since_ns, battmgr->protection.faults);
+	spin_unlock_irqrestore(&tx->lock, flags);
+	mutex_unlock(&battmgr->lock);
+	return len;
+}
+static DEVICE_ATTR_RO(uke_charge_protection_state);
