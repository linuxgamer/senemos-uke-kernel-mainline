diff --git a/drivers/clk/clk.c b/drivers/clk/clk.c
index 048adfa86a5d..d4ae8876929b 100644
--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -82,6 +82,8 @@ struct clk_core {
 	struct clk_core		*new_child;
 	unsigned long		flags;
 	bool			orphan;
+	bool			boot_enabled;
+	bool			need_sync;
 	bool			rpm_enabled;
 	unsigned int		enable_count;
 	unsigned int		prepare_count;
@@ -1442,6 +1444,88 @@ static void clk_core_disable_unprepare(struct clk_core *core)
 	clk_core_unprepare_lock(core);
 }
 
+/* Xiaomi clock hold/sync, opted into only by Uke clock providers. */
+static void clk_core_hold_state(struct clk_core *core)
+{
+	int ret;
+
+	if (!(core->flags & CLK_HOLD_STATE) || !core->boot_enabled ||
+	    core->need_sync || core->orphan)
+		return;
+
+	ret = clk_core_prepare_enable(core);
+	if (ret)
+		pr_err("clk: cannot hold boot clock %s: %d\n", core->name, ret);
+	else
+		core->need_sync = true;
+}
+
+static void clk_core_update_orphan_hold_state(struct clk_core *core)
+{
+	struct clk_core *child;
+
+	if (core->orphan)
+		return;
+	clk_core_hold_state(core);
+	hlist_for_each_entry(child, &core->children, child_node)
+		clk_core_update_orphan_hold_state(child);
+}
+
+/* Check the whole provider before releasing any of its startup references. */
+static bool clk_core_hold_pending(struct clk_core *core, struct device *dev)
+{
+	struct clk_core *child;
+
+	if (core->dev == dev && (core->flags & CLK_HOLD_STATE) &&
+	    core->boot_enabled && !core->need_sync)
+		return true;
+	hlist_for_each_entry(child, &core->children, child_node)
+		if (clk_core_hold_pending(child, dev))
+			return true;
+	return false;
+}
+
+static void clk_core_sync_subtree(struct clk_core *core, struct device *dev)
+{
+	struct clk_core *child;
+
+	hlist_for_each_entry(child, &core->children, child_node)
+		clk_core_sync_subtree(child, dev);
+	if (core->dev != dev || !(core->flags & CLK_HOLD_STATE))
+		return;
+
+	/* Clear before dropping the reference: repeat sync must be harmless. */
+	core->boot_enabled = false;
+	if (core->need_sync) {
+		core->need_sync = false;
+		clk_core_disable_unprepare(core);
+	}
+}
+
+int clk_sync_state(struct device *dev)
+{
+	struct clk_core *core;
+	int ret = -EAGAIN;
+
+	clk_prepare_lock();
+	hlist_for_each_entry(core, &clk_root_list, child_node)
+		if (clk_core_hold_pending(core, dev))
+			goto out;
+	hlist_for_each_entry(core, &clk_orphan_list, child_node)
+		if (clk_core_hold_pending(core, dev))
+			goto out;
+
+	hlist_for_each_entry(core, &clk_root_list, child_node)
+		clk_core_sync_subtree(core, dev);
+	hlist_for_each_entry(core, &clk_orphan_list, child_node)
+		clk_core_sync_subtree(core, dev);
+	ret = 0;
+out:
+	clk_prepare_unlock();
+	return ret;
+}
+EXPORT_SYMBOL_GPL(clk_sync_state);
+
 static void __init clk_unprepare_unused_subtree(struct clk_core *core)
 {
 	struct clk_core *child;
@@ -1451,6 +1535,9 @@ static void __init clk_unprepare_unused_subtree(struct clk_core *core)
 	hlist_for_each_entry(child, &core->children, child_node)
 		clk_unprepare_unused_subtree(child);
 
+	if (core->flags & CLK_HOLD_STATE)
+		return;
+
 	if (core->prepare_count)
 		return;
 
@@ -1477,6 +1564,9 @@ static void __init clk_disable_unused_subtree(struct clk_core *core)
 	hlist_for_each_entry(child, &core->children, child_node)
 		clk_disable_unused_subtree(child);
 
+	if (core->flags & CLK_HOLD_STATE)
+		return;
+
 	if (core->flags & CLK_OPS_PARENT_ENABLE)
 		clk_core_prepare_enable(core->parent);
 
@@ -2360,6 +2450,15 @@ static struct clk_core *clk_propagate_rate_change(struct clk_core *core,
 			fail_clk = core;
 	}
 
+	if (event == PRE_RATE_CHANGE && core->ops->pre_rate_change) {
+		ret = core->ops->pre_rate_change(core->hw, core->rate,
+					       core->new_rate);
+		if (ret)
+			fail_clk = core;
+	} else if (event == ABORT_RATE_CHANGE && core->ops->post_rate_change) {
+		core->ops->post_rate_change(core->hw, core->new_rate, core->rate);
+	}
+
 	hlist_for_each_entry(child, &core->children, child_node) {
 		/* Skip children who will be reparented to another clock */
 		if (child->new_parent && child->new_parent != core)
@@ -2454,6 +2553,9 @@ static void clk_change_rate(struct clk_core *core)
 	if (core->flags & CLK_RECALC_NEW_RATES)
 		(void)clk_calc_new_rates(core, core->new_rate);
 
+	if (core->ops->post_rate_change)
+		core->ops->post_rate_change(core->hw, old_rate, core->rate);
+
 	/*
 	 * Use safe iteration, as change_rate can actually swap parents
