+	[GCC_UFS_PHY_RX_SYMBOL_0_CLK_SRC] = &gcc_ufs_phy_rx_symbol_0_clk_src.clkr,
+	[GCC_UFS_PHY_RX_SYMBOL_1_CLK] = &gcc_ufs_phy_rx_symbol_1_clk.clkr,
+	[GCC_UFS_PHY_RX_SYMBOL_1_CLK_SRC] = &gcc_ufs_phy_rx_symbol_1_clk_src.clkr,
+	[GCC_UFS_PHY_TX_SYMBOL_0_CLK] = &gcc_ufs_phy_tx_symbol_0_clk.clkr,
+	[GCC_UFS_PHY_TX_SYMBOL_0_CLK_SRC] = &gcc_ufs_phy_tx_symbol_0_clk_src.clkr,
+	[GCC_UFS_PHY_UNIPRO_CORE_CLK] = &gcc_ufs_phy_unipro_core_clk.clkr,
+	[GCC_UFS_PHY_UNIPRO_CORE_CLK_SRC] = &gcc_ufs_phy_unipro_core_clk_src.clkr,
+	[GCC_UFS_PHY_UNIPRO_CORE_HW_CTL_CLK] = &gcc_ufs_phy_unipro_core_hw_ctl_clk.clkr,
+	[GCC_USB30_PRIM_MASTER_CLK] = &gcc_usb30_prim_master_clk.clkr,
+	[GCC_USB30_PRIM_MASTER_CLK_SRC] = &gcc_usb30_prim_master_clk_src.clkr,
+	[GCC_USB30_PRIM_MOCK_UTMI_CLK] = &gcc_usb30_prim_mock_utmi_clk.clkr,
+	[GCC_USB30_PRIM_MOCK_UTMI_CLK_SRC] = &gcc_usb30_prim_mock_utmi_clk_src.clkr,
+	[GCC_USB30_PRIM_MOCK_UTMI_POSTDIV_CLK_SRC] = &gcc_usb30_prim_mock_utmi_postdiv_clk_src.clkr,
+	[GCC_USB30_PRIM_SLEEP_CLK] = &gcc_usb30_prim_sleep_clk.clkr,
+	[GCC_USB3_PRIM_PHY_AUX_CLK] = &gcc_usb3_prim_phy_aux_clk.clkr,
+	[GCC_USB3_PRIM_PHY_AUX_CLK_SRC] = &gcc_usb3_prim_phy_aux_clk_src.clkr,
+	[GCC_USB3_PRIM_PHY_COM_AUX_CLK] = &gcc_usb3_prim_phy_com_aux_clk.clkr,
+	[GCC_USB3_PRIM_PHY_PIPE_CLK] = &gcc_usb3_prim_phy_pipe_clk.clkr,
+	[GCC_USB3_PRIM_PHY_PIPE_CLK_SRC] = &gcc_usb3_prim_phy_pipe_clk_src.clkr,
+	[GCC_VIDEO_AXI0_CLK] = &gcc_video_axi0_clk.clkr,
+	[GCC_VIDEO_AXI1_CLK] = &gcc_video_axi1_clk.clkr,
+};
+
+static const struct qcom_reset_map gcc_cliffs_resets[] = {
+	[GCC_CAMERA_BCR] = { 0x26000 },
+	[GCC_DISPLAY_BCR] = { 0x27000 },
+	[GCC_GPU_BCR] = { 0x71000 },
+	[GCC_PCIE_0_BCR] = { 0x6b000 },
+	[GCC_PCIE_0_LINK_DOWN_BCR] = { 0x6c014 },
+	[GCC_PCIE_0_NOCSR_COM_PHY_BCR] = { 0x6c020 },
+	[GCC_PCIE_0_PHY_BCR] = { 0x6c01c },
+	[GCC_PCIE_0_PHY_NOCSR_COM_PHY_BCR] = { 0x6c028 },
+	[GCC_PCIE_PHY_BCR] = { 0x6f000 },
+	[GCC_PCIE_PHY_CFG_AHB_BCR] = { 0x6f00c },
+	[GCC_PCIE_PHY_COM_BCR] = { 0x6f010 },
+	[GCC_PDM_BCR] = { 0x33000 },
+	[GCC_QUPV3_WRAPPER_0_BCR] = { 0x18000 },
+	[GCC_QUPV3_WRAPPER_1_BCR] = { 0x1e000 },
+	[GCC_QUSB2PHY_PRIM_BCR] = { 0x12000 },
+	[GCC_QUSB2PHY_SEC_BCR] = { 0x12004 },
+	[GCC_SDCC2_BCR] = { 0x14000 },
+	[GCC_UFS_PHY_BCR] = { 0x77000 },
+	[GCC_USB30_PRIM_BCR] = { 0x39000 },
+	[GCC_USB3_DP_PHY_PRIM_BCR] = { 0x50008 },
+	[GCC_USB3_DP_PHY_SEC_BCR] = { 0x50014 },
+	[GCC_USB3_PHY_PRIM_BCR] = { 0x50000 },
+	[GCC_USB3_PHY_SEC_BCR] = { 0x5000c },
+	[GCC_USB3PHY_PHY_PRIM_BCR] = { 0x50004 },
+	[GCC_USB3PHY_PHY_SEC_BCR] = { 0x50010 },
+	[GCC_VIDEO_AXI0_CLK_ARES] = { 0x32018, 2 },
+	[GCC_VIDEO_AXI1_CLK_ARES] = { 0x32024, 2 },
+	[GCC_VIDEO_BCR] = { 0x32000 },
+};
+
+
+static const struct regmap_config gcc_cliffs_regmap_config = {
+	.reg_bits = 32,
+	.reg_stride = 4,
+	.val_bits = 32,
+	.max_register = 0x1f41f0,
+	.fast_io = true,
+};
+
+static const struct qcom_cc_desc gcc_cliffs_desc = {
+	.config = &gcc_cliffs_regmap_config,
+	.clk_regulators = gcc_cliffs_regulators,
+	.num_clk_regulators = ARRAY_SIZE(gcc_cliffs_regulators),
+	.clks = gcc_cliffs_clocks,
+	.num_clks = ARRAY_SIZE(gcc_cliffs_clocks),
+	.resets = gcc_cliffs_resets,
+	.num_resets = ARRAY_SIZE(gcc_cliffs_resets),
+};
+
+static const struct of_device_id gcc_cliffs_match_table[] = {
+	{ .compatible = "qcom,cliffs-gcc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, gcc_cliffs_match_table);
+
+static bool gcc_cliffs_proxy_active;
+module_param_named(proxy_active, gcc_cliffs_proxy_active, bool, 0444);
+MODULE_PARM_DESC(proxy_active, "Vendor startup voltage vote awaits supplier sync_state");
+
+static void gcc_cliffs_vdd_release(void *data)
+{
+	struct device *dev = data;
+
+	if (gcc_cliffs_proxy_active) {
+		if (clk_vdd_proxy_unvote(dev, &gcc_cliffs_desc))
+			return;
+		gcc_cliffs_proxy_active = false;
+	}
+	clk_regulator_deinit(&gcc_cliffs_desc);
+}
+
+static int gcc_cliffs_probe(struct platform_device *pdev)
+{
+	struct regmap *regmap;
+	int ret;
+
+	ret = clk_regulator_init(&pdev->dev, &gcc_cliffs_desc);
+	if (ret)
+		return ret;
+
+	ret = devm_add_action_or_reset(&pdev->dev, gcc_cliffs_vdd_release, &pdev->dev);
+	if (ret)
+		return ret;
+
+	regmap = qcom_cc_map(pdev, &gcc_cliffs_desc);
+	if (IS_ERR(regmap))
+		return PTR_ERR(regmap);
+
+	/* USB data bring-up does not force camera/display/GPU/video gates. */
+	ret = clk_vdd_proxy_vote(&pdev->dev, &gcc_cliffs_desc);
+	if (ret)
+		return ret;
+
+	gcc_cliffs_proxy_active = true;
+	ret = qcom_cc_really_probe(&pdev->dev, &gcc_cliffs_desc, regmap);
+	if (ret) {
+		dev_err(&pdev->dev, "Failed to register GCC clocks\n");
+		return ret;
+	}
+
+	return ret;
+}
+
+static void gcc_cliffs_sync_state(struct device *dev)
+{
+	if (clk_sync_state(dev)) {
+		dev_warn(dev, "boot clocks still await handoff; retaining voltage vote\n");
+		return;
+	}
+	if (gcc_cliffs_proxy_active && !clk_vdd_proxy_unvote(dev, &gcc_cliffs_desc))
+		gcc_cliffs_proxy_active = false;
+}
+
+static struct platform_driver gcc_cliffs_driver = {
+	.probe = gcc_cliffs_probe,
+	.driver = {
+		.name = "gcc-cliffs",
+		.sync_state = gcc_cliffs_sync_state,
+		.suppress_bind_attrs = true,
+		.of_match_table = gcc_cliffs_match_table,
+	},
+};
+
+static int __init gcc_cliffs_init(void)
+{
+	return platform_driver_register(&gcc_cliffs_driver);
+}
+subsys_initcall(gcc_cliffs_init);
+
+static void __exit gcc_cliffs_exit(void)
+{
+	platform_driver_unregister(&gcc_cliffs_driver);
+}
+module_exit(gcc_cliffs_exit);
+
+MODULE_DESCRIPTION("QTI GCC CLIFFS Driver");
+MODULE_LICENSE("GPL");
diff --git a/drivers/clk/qcom/gdsc-regulator-uke.c b/drivers/clk/qcom/gdsc-regulator-uke.c
new file mode 100644
index 000000000000..037c8f9d8ef7
--- /dev/null
+++ b/drivers/clk/qcom/gdsc-regulator-uke.c
@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (c) 2016-2021, The Linux Foundation. All rights reserved.
+ * Copyright (c) 2022-2024, Qualcomm Innovation Center, Inc. All rights reserved.
+ *
+ * Minimal regulator-facing GDSC driver for Xiaomi Uke.
+ *
+ * Derived from Xiaomi's public gdsc-regulator.c.  The Uke USB controller
+ * only uses the GDSCR/CFG_GDSCR state machine and its CX parent supply;
+ * downstream mailbox, reset, clock, interconnect and debug extensions are
+ * deliberately not registered here.
+ */
+
+#include <linux/delay.h>
+#include <linux/io.h>
+#include <linux/module.h>
+#include <linux/of.h>
+#include <linux/platform_device.h>
+#include <linux/regmap.h>
+#include <linux/regulator/consumer.h>
+#include <linux/regulator/driver.h>
+#include <linux/regulator/machine.h>
+#include <linux/regulator/of_regulator.h>
+#include <linux/regulator/proxy-consumer.h>
+
+#define GDSCR_SW_COLLAPSE	BIT(0)
+#define GDSCR_HW_CONTROL	BIT(1)
+#define GDSCR_SW_OVERRIDE	BIT(2)
+#define GDSCR_RETAIN_FF		BIT(11)
+#define CFG_GDSCR			0x4
+#define CFG_GDSCR_POWER_DOWN	BIT(15)
+#define CFG_GDSCR_POWER_UP	BIT(16)
+#define GDSC_TIMEOUT_US		1500
+
+struct uke_gdsc {
+	struct regulator_desc desc;
+	struct regulator_dev *rdev;
+	struct regmap *regmap;
+	struct regulator *parent;
+	bool retain_regs;
+	bool parent_on;
+	int power_error;
+};
+
+static const struct regmap_config uke_gdsc_regmap_config = {
+	.reg_bits = 32,
+	.reg_stride = 4,
+	.val_bits = 32,
+	.max_register = CFG_GDSCR,
+};
+
+static int uke_gdsc_poll(struct uke_gdsc *gdsc, bool on)
+{
+	u32 val;
+	int ret;
+
+	ret = regmap_read_poll_timeout(gdsc->regmap, CFG_GDSCR, val,
+				on ? val & CFG_GDSCR_POWER_UP :
+				     val & CFG_GDSCR_POWER_DOWN,
+				     1, GDSC_TIMEOUT_US);
+	return ret;
+}
+
+static int uke_gdsc_parent_enable(struct uke_gdsc *gdsc)
+{
+	int ret;
+
+	if (gdsc->parent_on)
+		return 0;
+	ret = regulator_enable(gdsc->parent);
+	if (!ret)
+		gdsc->parent_on = true;
+	return ret;
+}
+
+static int uke_gdsc_parent_disable(struct uke_gdsc *gdsc)
+{
+	int ret;
+
+	if (!gdsc->parent_on)
+		return 0;
+	ret = regulator_disable(gdsc->parent);
+	if (!ret)
+		gdsc->parent_on = false;
+	return ret;
+}
+
+static int uke_gdsc_enable(struct regulator_dev *rdev)
+{
+	struct uke_gdsc *gdsc = rdev_get_drvdata(rdev);
+	u32 val;
+	int ret;
+
+	if (gdsc->power_error)
+		return gdsc->power_error;
+	ret = uke_gdsc_parent_enable(gdsc);
+	if (ret)
+		return ret;
+	ret = regmap_read(gdsc->regmap, 0, &val);
+	if (ret)
+		goto uncertain;
+	if (val & GDSCR_HW_CONTROL)
+		return -EBUSY;
+
+	ret = regmap_clear_bits(gdsc->regmap, 0, GDSCR_SW_COLLAPSE);
+	if (ret)
+		goto uncertain;
+	/* Xiaomi: allow eight XO cycles before reading completion. */
+	mb();
+	udelay(1);
+	ret = uke_gdsc_poll(gdsc, true);
+	if (ret)
+		goto uncertain;
+
+	if (gdsc->retain_regs) {
+		ret = regmap_set_bits(gdsc->regmap, 0, GDSCR_RETAIN_FF);
+		if (ret)
+			goto uncertain;
+	}
+	/* Clock re-enable / memory power-up, then staggered memory power-up. */
+	udelay(1);
+	udelay(1);
+	return 0;
+
+uncertain:
+	/* Do not drop CX or retry transitions after an ambiguous hardware error. */
+	gdsc->power_error = ret;
+	return ret;
+}
+
+static int uke_gdsc_disable(struct regulator_dev *rdev)
+{
+	struct uke_gdsc *gdsc = rdev_get_drvdata(rdev);
+	int ret;
+
+	if (gdsc->power_error)
+		return gdsc->power_error;
+	/* Xiaomi: staggered memory power-down before asserting collapse. */
+	udelay(1);
+	ret = regmap_set_bits(gdsc->regmap, 0, GDSCR_SW_COLLAPSE);
+	if (ret)
+		goto uncertain;
+	/* Complete the collapse write before waiting eight XO cycles. */
+	mb();
+	udelay(1);
+	ret = uke_gdsc_poll(gdsc, false);
+	if (ret)
+		goto uncertain;
+	return uke_gdsc_parent_disable(gdsc);
+
+uncertain:
+	gdsc->power_error = ret;
+	return ret;
+}
+
+static int uke_gdsc_is_enabled(struct regulator_dev *rdev)
+{
+	struct uke_gdsc *gdsc = rdev_get_drvdata(rdev);
+	u32 val;
+	int ret;
+
+	ret = regmap_read(gdsc->regmap, CFG_GDSCR, &val);
+	if (ret)
+		return ret;
+	return !!(val & CFG_GDSCR_POWER_UP);
+}
+
+static const struct regulator_ops uke_gdsc_ops = {
+	.enable = uke_gdsc_enable,
+	.disable = uke_gdsc_disable,
+	.is_enabled = uke_gdsc_is_enabled,
+};
+
+/* A failed probe must not power down a live or indeterminate domain. */
+static void uke_gdsc_put_parent(void *data)
+{
+	struct uke_gdsc *gdsc = data;
+
+	if (gdsc->parent_on) {
+		pr_err("Uke GDSC: retaining CX handle/vote for live or uncertain domain\n");
+		return;
+	}
+	regulator_put(gdsc->parent);
+}
+
+static int uke_gdsc_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct regulator_config config = {};
+	struct regulator_init_data *init_data;
+	struct uke_gdsc *gdsc;
+	struct resource *res;
+	void __iomem *base;
+	u32 val;
+	int ret;
+
+	gdsc = devm_kzalloc(dev, sizeof(*gdsc), GFP_KERNEL);
+	if (!gdsc)
+		return -ENOMEM;
+
+	res = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	if (!res || resource_size(res) < CFG_GDSCR + sizeof(u32))
+		return -EINVAL;
+	base = devm_ioremap_resource(dev, res);
+	if (IS_ERR(base))
+		return PTR_ERR(base);
+	gdsc->regmap = devm_regmap_init_mmio(dev, base, &uke_gdsc_regmap_config);
+	if (IS_ERR(gdsc->regmap))
+		return PTR_ERR(gdsc->regmap);
+
+	gdsc->parent = regulator_get(dev, "parent");
+	if (IS_ERR(gdsc->parent))
+		return dev_err_probe(dev, PTR_ERR(gdsc->parent),
+					 "failed to get GDSC parent supply\n");
+	ret = devm_add_action_or_reset(dev, uke_gdsc_put_parent, gdsc);
+	if (ret)
+		return ret;
+	gdsc->retain_regs = device_property_read_bool(dev, "qcom,retain-regs");
+
+	init_data = of_get_regulator_init_data(dev, dev->of_node, &gdsc->desc);
+	if (!init_data)
+		return -EINVAL;
+	gdsc->desc.name = init_data->constraints.name;
+	gdsc->desc.ops = &uke_gdsc_ops;
+	gdsc->desc.type = REGULATOR_VOLTAGE;
+	gdsc->desc.owner = THIS_MODULE;
+
+	/* Preserve the firmware collapse state while selecting the SW sequencer. */
+	ret = uke_gdsc_parent_enable(gdsc);
+	if (ret)
+		return ret;
+	ret = regmap_clear_bits(gdsc->regmap, 0,
+				GDSCR_HW_CONTROL | GDSCR_SW_OVERRIDE);
+	if (ret)
+		goto release_parent;
+	/* Finish selecting the hardware sequencer before checking boot state. */
+	mb();
+	ret = regmap_read(gdsc->regmap, 0, &val);
+	if (ret)
+		goto release_parent;
+	ret = uke_gdsc_poll(gdsc, !(val & GDSCR_SW_COLLAPSE));
+	if (ret)
+		goto release_parent;
+	/* A firmware-enabled domain needs a parent vote even before first use. */
+	if (val & GDSCR_SW_COLLAPSE) {
+		ret = uke_gdsc_parent_disable(gdsc);
+		if (ret)
+			goto release_parent;
+	} else if (gdsc->retain_regs) {
+		ret = regmap_set_bits(gdsc->regmap, 0, GDSCR_RETAIN_FF);
+		if (ret)
+			goto release_parent;
+	}
+
+	config.dev = dev;
+	config.init_data = init_data;
+	config.driver_data = gdsc;
+	config.of_node = dev->of_node;
+	gdsc->rdev = devm_regulator_register(dev, &gdsc->desc, &config);
+	if (IS_ERR(gdsc->rdev)) {
+		ret = PTR_ERR(gdsc->rdev);
+		goto release_parent;
+	}
+
+	ret = devm_regulator_proxy_consumer_register(dev, dev->of_node);
+	if (ret)
+		goto release_parent;
+	platform_set_drvdata(pdev, gdsc);
+	return 0;
+
+release_parent:
+	/* Release only after positively observing a collapsed domain. */
+	if (!gdsc->power_error &&
+	    !regmap_read(gdsc->regmap, 0, &val) &&
+	    (val & GDSCR_SW_COLLAPSE) && !uke_gdsc_poll(gdsc, false))
+		uke_gdsc_parent_disable(gdsc);
+	return ret;
+}
+
+static const struct of_device_id uke_gdsc_of_match[] = {
+	{ .compatible = "qcom,sm7675-usb-gdsc" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, uke_gdsc_of_match);
+
+static struct platform_driver uke_gdsc_driver = {
+	.probe = uke_gdsc_probe,
+	.driver = {
+		.name = "qcom-uke-usb-gdsc",
+		.suppress_bind_attrs = true,
+		.of_match_table = uke_gdsc_of_match,
+		.sync_state = regulator_proxy_consumer_sync_state,
+	},
+};
+module_platform_driver(uke_gdsc_driver);
+
+MODULE_DESCRIPTION("Xiaomi Uke USB GDSC regulator");
+MODULE_LICENSE("GPL");
