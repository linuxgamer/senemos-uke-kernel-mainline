+static int qcom_battmgr_uke_validate(unsigned int property, u32 value)
+{
+	switch (property) {
+	case BATT_PRESENT:
+		return value <= 1 ? 0 : -ENODATA;
+	case BATT_CAPACITY:
+		return value <= 10000 ? 0 : -ENODATA;
+	case BATT_SOH:
+		return value <= 100 ? 0 : -ENODATA;
+	case BATT_TEMP:
+		return (s32)value == INT_MIN || (s32)value == INT_MAX ? -ENODATA : 0;
+	case BATT_VOLT_OCV:
+	case BATT_VOLT_NOW:
+	case BATT_VOLT_MAX:
+	case BATT_CHG_FULL_DESIGN:
+	case BATT_CHG_FULL:
+	case BATT_CYCLE_COUNT:
+	case BATT_TTF_AVG:
+	case BATT_TTE_AVG:
+	case BATT_RESISTANCE:
+		return value && value <= INT_MAX ? 0 : -ENODATA;
+	default:
+		return 0;
+	}
+}
