+static u32 qcom_battmgr_uke_generation(struct qcom_battmgr *battmgr)
+{
+	unsigned long flags;
+	u32 generation;
+
+	spin_lock_irqsave(&battmgr->transaction.lock, flags);
+	generation = battmgr->transaction.generation;
+	spin_unlock_irqrestore(&battmgr->transaction.lock, flags);
+	return generation;
+}
+
+static int qcom_battmgr_uke_request(struct qcom_battmgr *battmgr, void *data, size_t len)
+{
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	const struct qcom_battmgr_property_request *request = data;
+	const struct pmic_glink_hdr *hdr = data;
+	unsigned long flags, left;
+	u32 generation, opcode = le32_to_cpu(hdr->opcode);
+	int ret;
+
+	lockdep_assert_held(&battmgr->lock);
+	spin_lock_irqsave(&tx->lock, flags);
+	if (tx->removing)
+		ret = -ENODEV;
+	else if (tx->suspended)
+		ret = -EHOSTDOWN;
+	else if (tx->desynced)
+		ret = -EPIPE;
+	else if (!battmgr->service_up)
+		ret = -EAGAIN;
+	else
+		ret = 0;
+	if (ret)
+		goto out_unlock;
+
+	if (opcode == BATTMGR_REQUEST_NOTIFICATION &&
+	    len != sizeof(struct qcom_battmgr_enable_request)) {
+		ret = -EINVAL;
+		goto out_unlock;
+	}
+	if (opcode != BATTMGR_REQUEST_NOTIFICATION &&
+	    (len != sizeof(*request) ||
+	     (opcode != BATTMGR_BAT_PROPERTY_GET && opcode != BATTMGR_USB_PROPERTY_GET &&
+	      opcode != BATTMGR_USB_PROPERTY_SET && opcode != BATTMGR_WLS_PROPERTY_GET))) {
+		ret = -EOPNOTSUPP;
+		goto out_unlock;
+	}
+
+	reinit_completion(&battmgr->ack);
+	battmgr->error = 0;
+	tx->raw_result = 0;
+	tx->response_len = 0;
+	tx->opcode = opcode;
+	tx->property = opcode == BATTMGR_REQUEST_NOTIFICATION ? 0 :
+		       le32_to_cpu(request->property);
+	generation = tx->generation;
+	tx->deadline = jiffies + HZ;
+	tx->pending = true;
+	spin_unlock_irqrestore(&tx->lock, flags);
+
+	ret = pmic_glink_send(battmgr->client, data, len);
+	if (ret < 0)
+		goto out_finish;
+	left = time_before(jiffies, tx->deadline) ? tx->deadline - jiffies : 0;
+	if (!left || !wait_for_completion_timeout(&battmgr->ack, left))
+		ret = -ETIMEDOUT;
+out_finish:
+	spin_lock_irqsave(&tx->lock, flags);
+	if (ret < 0) {
+		/* A send failure can also leave delivery ambiguous; never replay it. */
+		tx->desynced = true;
+	} else if (battmgr->error) {
+		ret = battmgr->error;
+	} else if (!battmgr->service_up || tx->generation != generation) {
+		ret = opcode == BATTMGR_USB_PROPERTY_SET ? -ESTALE : -EAGAIN;
+	} else if (!tx->response_len) {
+		ret = -EPROTO;
+		tx->desynced = true;
+	} else {
+		/* Receive copied the matching response; only this caller commits it. */
+		/* Enable payload semantics are unknown; only its envelope was observed. */
+		if (opcode != BATTMGR_REQUEST_NOTIFICATION)
+			qcom_battmgr_sm8350_callback(battmgr, &tx->response, tx->response_len);
+		ret = battmgr->error;
+	}
+	tx->pending = false;
+	battmgr->error = ret;
+out_unlock:
+	spin_unlock_irqrestore(&tx->lock, flags);
+	return ret;
+}
