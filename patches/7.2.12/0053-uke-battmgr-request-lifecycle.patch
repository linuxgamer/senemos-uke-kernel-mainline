+static void qcom_battmgr_uke_callback(struct qcom_battmgr *battmgr,
+				      const struct qcom_battmgr_message *resp, size_t len)
+{
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	u32 opcode = le32_to_cpu(resp->hdr.opcode);
+	u32 property, raw;
+	size_t expected;
+	unsigned long flags;
+
+	if (le32_to_cpu(resp->hdr.owner) != PMIC_GLINK_OWNER_BATTMGR)
+		return;
+	if (opcode == BATTMGR_NOTIFICATION) {
+		if (le32_to_cpu(resp->hdr.type) != PMIC_GLINK_NOTIFY ||
+		    len != sizeof(resp->hdr) + sizeof(resp->notification))
+			return;
+		spin_lock_irqsave(&tx->lock, flags);
+		if (!battmgr->service_up || tx->removing || tx->suspended) {
+			spin_unlock_irqrestore(&tx->lock, flags);
+			return;
+		}
+		raw = le32_to_cpu(resp->notification) & 0xff;
+		if (raw == NOTIF_USB_PROPERTY || raw == NOTIF_BAT_INFO) {
+			tx->generation++;
+			if (raw == NOTIF_USB_PROPERTY)
+				tx->source_generation++;
+		}
+		spin_unlock_irqrestore(&tx->lock, flags);
+		qcom_battmgr_notification(battmgr, resp, len);
+		return;
+	}
+	if (le32_to_cpu(resp->hdr.type) != PMIC_GLINK_REQ_RESP &&
+	    !(opcode == BATTMGR_REQUEST_NOTIFICATION &&
+	      le32_to_cpu(resp->hdr.type) == PMIC_GLINK_NOTIFY))
+		return;
+
+	spin_lock_irqsave(&tx->lock, flags);
+	if (!tx->pending || tx->response_len || tx->desynced || tx->removing ||
+	    tx->suspended || !battmgr->service_up || opcode != tx->opcode ||
+	    time_after_eq(jiffies, tx->deadline))
+		goto out;
+	if (opcode == BATTMGR_REQUEST_NOTIFICATION) {
+		/* Serialize its reply without interpreting an undocumented payload. */
+		if (len > sizeof(*resp)) {
+			battmgr->error = -EPROTO;
+			tx->desynced = true;
+		} else {
+			memcpy(&tx->response.hdr, &resp->hdr, sizeof(resp->hdr));
+			tx->response_len = sizeof(resp->hdr);
+			tx->receipt_ns = ktime_get_boottime_ns();
+		}
+		complete(&battmgr->ack);
+		goto out;
+	}
+	if (len < sizeof(resp->hdr) + sizeof(resp->intval.property))
+		goto out;
+	property = le32_to_cpu(resp->intval.property);
+	if (property != tx->property)
+		goto out;
+	expected = sizeof(resp->hdr) + sizeof(resp->intval);
+	if (opcode == BATTMGR_BAT_PROPERTY_GET &&
+	    property == (u32)qcom_battmgr_uke_battery_property(BATT_MODEL_NAME, true))
+		expected = sizeof(resp->hdr) + sizeof(resp->strval);
+	if (len != expected) {
+		/* Model-name requests can receive a normal integer error response. */
+		if (expected != sizeof(resp->hdr) + sizeof(resp->strval) ||
+		    len != sizeof(resp->hdr) + sizeof(resp->intval) ||
+		    !le32_to_cpu(resp->intval.result)) {
+			battmgr->error = -EPROTO;
+			tx->desynced = true;
+			complete(&battmgr->ack);
+			goto out;
+		}
+	}
+	if (len == sizeof(resp->hdr) + sizeof(resp->intval)) {
+		tx->raw_result = le32_to_cpu(resp->intval.result);
+		if (tx->raw_result)
+			battmgr->error = -EREMOTEIO;
+	}
+	memcpy(&tx->response, resp, len);
+	tx->response_len = len;
+	tx->receipt_ns = ktime_get_boottime_ns();
 	complete(&battmgr->ack);
+out:
+	spin_unlock_irqrestore(&tx->lock, flags);
 }
 
