+static ssize_t uke_battmgr_state_show(struct device *dev,
+				    struct device_attribute *attr, char *buf)
+{
+	struct qcom_battmgr *battmgr = dev_get_drvdata(dev);
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	unsigned long flags;
+	ssize_t len;
+
+	spin_lock_irqsave(&tx->lock, flags);
+	len = sysfs_emit(buf, "1 %u %u %u %u %u %u %u %d %u %llu %llu\n",
+			tx->generation, tx->firmware_generation, tx->source_generation,
+			battmgr->service_up, tx->desynced, tx->suspended, tx->removing,
+			battmgr->error, tx->raw_result, tx->receipt_ns, tx->instance_ns);
+	spin_unlock_irqrestore(&tx->lock, flags);
+	return len;
+}
