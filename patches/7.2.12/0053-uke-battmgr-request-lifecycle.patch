+static void qcom_battmgr_uke_stop(void *data)
+{
+	struct qcom_battmgr *battmgr = data;
+	struct qcom_battmgr_uke_transaction *tx = &battmgr->transaction;
+	unsigned long flags;
+
+	spin_lock_irqsave(&tx->lock, flags);
+	tx->removing = true;
+	tx->generation++;
+	WRITE_ONCE(battmgr->service_up, false);
+	if (tx->pending) {
+		battmgr->error = -ENODEV;
+		tx->desynced = true;
+		complete(&battmgr->ack);
+	}
+	spin_unlock_irqrestore(&tx->lock, flags);
+	cancel_work_sync(&battmgr->enable_work);
+	mutex_lock(&battmgr->lock);
+	mutex_unlock(&battmgr->lock);
+}
