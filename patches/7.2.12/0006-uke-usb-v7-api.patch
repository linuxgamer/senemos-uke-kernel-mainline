@@ -607,6 +610,49 @@ struct dwc3_glue_ops dwc3_qcom_glue_ops = {
 	.pre_run_stop	= dwc3_qcom_run_stop_notifier,
 };
 
+/* Uke retains firmware-owned USB power during the initial handoff. */
+static void dwc3_qcom_uke_power_off(void *data)
+{
+	struct dwc3_qcom *qcom = data;
+
+	regulator_disable(qcom->gdsc);
+}
+
+static int dwc3_qcom_uke_prepare(struct dwc3_qcom *qcom)
+{
+	int i, ret;
+
+	qcom->gdsc = devm_regulator_get(qcom->dev, "gdsc");
+	if (IS_ERR(qcom->gdsc))
+		return dev_err_probe(qcom->dev, PTR_ERR(qcom->gdsc), "Missing USB GDSC\n");
+	ret = regulator_enable(qcom->gdsc);
+	if (ret)
+		return ret;
+	ret = devm_add_action_or_reset(qcom->dev, dwc3_qcom_uke_power_off, qcom);
+	if (ret)
+		return ret;
+
+	for (i = 0; i < qcom->num_clocks; i++) {
+		const char *name = qcom->clks[i].id;
+		u32 rate = 0;
+
+		if (!name)
+			continue;
+		if (!strcmp(name, "core_clk"))
+			device_property_read_u32(qcom->dev, "qcom,core-clk-rate-disconnected", &rate);
+		else if (!strcmp(name, "sleep_clk"))
+			rate = 32000;
+		else if (!strcmp(name, "utmi_clk"))
+			rate = 19200000;
+		if (!rate)
+			continue;
+		ret = clk_set_rate(qcom->clks[i].clk, rate);
+		if (ret)
+			return dev_err_probe(qcom->dev, ret, "Failed USB clock rate\n");
+	}
+	return 0;
+}
+
