 {
 	struct dwc3_probe_data	probe_data = {};
@@ -623,6 +669,7 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 		return -ENOMEM;
 
 	qcom->dev = &pdev->dev;
+	qcom->uke = of_device_is_compatible(dev->of_node, "qcom,sm7675-dwc3");
 
 	qcom->resets = devm_reset_control_array_get_optional_exclusive(dev);
 	if (IS_ERR(qcom->resets)) {
@@ -635,18 +682,18 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 		return dev_err_probe(dev, ret, "failed to get clocks\n");
 	qcom->num_clocks = ret;
 
-	ret = reset_control_assert(qcom->resets);
-	if (ret) {
-		dev_err(&pdev->dev, "failed to assert resets, err=%d\n", ret);
-		return ret;
-	}
-
-	usleep_range(10, 1000);
-
-	ret = reset_control_deassert(qcom->resets);
-	if (ret) {
-		dev_err(&pdev->dev, "failed to deassert resets, err=%d\n", ret);
-		return ret;
+	if (qcom->uke) {
+		ret = dwc3_qcom_uke_prepare(qcom);
+		if (ret)
+			return ret;
+	} else {
+		ret = reset_control_assert(qcom->resets);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to assert resets\n");
+		usleep_range(10, 1000);
+		ret = reset_control_deassert(qcom->resets);
+		if (ret)
+			return dev_err_probe(dev, ret, "Failed to deassert resets\n");
 	}
 
 	ret = clk_bulk_prepare_enable(qcom->num_clocks, qcom->clks);
@@ -658,6 +705,10 @@ static int dwc3_qcom_probe(struct platform_device *pdev)
 		ret = -EINVAL;
 		goto clk_disable;
 	}
+	if (resource_size(r) < SDM845_QSCRATCH_BASE_OFFSET + SDM845_QSCRATCH_SIZE) {
+		ret = -EINVAL;
+		goto clk_disable;
+	}
 	res = *r;
 	res.end = res.start + SDM845_QSCRATCH_BASE_OFFSET;
 
@@ -840,6 +891,7 @@ static const struct dev_pm_ops dwc3_qcom_dev_pm_ops = {
 
 static const struct of_device_id dwc3_qcom_of_match[] = {
 	{ .compatible = "qcom,snps-dwc3" },
+	{ .compatible = "qcom,sm7675-dwc3" },
 	{ }
 };
 MODULE_DEVICE_TABLE(of, dwc3_qcom_of_match);
