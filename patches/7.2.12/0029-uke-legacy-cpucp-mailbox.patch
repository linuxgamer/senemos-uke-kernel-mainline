From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] mailbox: qcom: admit the exact Uke legacy CPUCP transport

Uke OEM uses two channels, one shared transmit doorbell and two 4-KiB
receive domains. Its resources cannot be accessed through the modern
CPUCP register layout. Retain the exact OEM transaction and ownership
semantics with machine/resource refusal before any register access.
Modern X1E/Nord operations remain unchanged. This supplies a mailbox,
not vendor SCMI protocol 0x80 or CPU frequency/power qualification.

--- a/drivers/mailbox/qcom-cpucp-mbox.c
+++ b/drivers/mailbox/qcom-cpucp-mbox.c
@@ -1,6 +1,8 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /*
  * Copyright (c) 2024, Qualcomm Innovation Center, Inc. All rights reserved.
+ * Copyright (c) 2020-2021, The Linux Foundation. All rights reserved.
+ * Copyright (c) 2022-2023 Qualcomm Innovation Center, Inc. All rights reserved.
  */
 
 #include <linux/bitops.h>
@@ -25,12 +27,22 @@
 #define APSS_CPUCP_RX_MBOX_EN			0x4c00
 #define APSS_CPUCP_RX_MBOX_CMD_MASK		GENMASK_ULL(63, 0)
 
+#define UKE_CPUCP_CHANNELS			2
+#define UKE_CPUCP_SEND_IRQ			0xc
+#define UKE_CPUCP_SEND_BIT			BIT(28)
+#define UKE_CPUCP_CLEAR_IRQ			0x308
+#define UKE_CPUCP_STATUS_IRQ			0x30c
+#define UKE_CPUCP_RX_BIT				BIT(3)
+#define UKE_CPUCP_DOMAIN_STRIDE			0x1000
+
 /**
  * struct qcom_cpucp_mbox_data - Per-hardware mailbox configuration data
  * @num_chans:			Number of IPC channels supported by this hardware
+ * @uke_legacy:			Use the exact Uke OEM two-channel doorbell layout
  */
 struct qcom_cpucp_mbox_data {
 	int num_chans;
+	bool uke_legacy;
 };
 
 /**
@@ -45,6 +57,80 @@
-	struct mbox_controller mbox;
+	struct mbox_controller mbox;
-	void __iomem *tx_base;
+	void __iomem *tx_base;
 	void __iomem *rx_base;
+	int irq;
+};
+
+static bool qcom_cpucp_uke_resources(struct platform_device *pdev)
+{
+	struct resource *tx = platform_get_resource(pdev, IORESOURCE_MEM, 0);
+	struct resource *rx = platform_get_resource(pdev, IORESOURCE_MEM, 1);
+
+	return of_machine_is_compatible("xiaomi,uke") && tx && rx &&
+		tx->start == 0x17400000 && resource_size(tx) == 0x10 &&
+		rx->start == 0x17d90000 && resource_size(rx) == 0x2000;
+}
+
+static irqreturn_t qcom_cpucp_uke_irq_fn(int irq, void *data)
+{
+	struct qcom_cpucp_mbox *cpucp = data;
+	unsigned long flags;
+	int i;
+
+	for (i = 0; i < UKE_CPUCP_CHANNELS; i++) {
+		struct mbox_chan *chan = &cpucp->chans[i];
+		void __iomem *domain = cpucp->rx_base + i * UKE_CPUCP_DOMAIN_STRIDE;
+		bool claimed;
+
+		if (!(readl(domain + UKE_CPUCP_STATUS_IRQ) & UKE_CPUCP_RX_BIT))
+			continue;
+		spin_lock_irqsave(&chan->lock, flags);
+		claimed = chan->con_priv;
+		writel(UKE_CPUCP_RX_BIT, domain + UKE_CPUCP_CLEAR_IRQ);
+		mb();
+		spin_unlock_irqrestore(&chan->lock, flags);
+		/* SCMI notification handling can re-enter the mailbox TX path. */
+		if (claimed)
+			mbox_chan_received_data(chan, NULL);
+	}
+
+	return IRQ_HANDLED;
+}
+
+static int qcom_cpucp_uke_startup(struct mbox_chan *chan)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&chan->lock, flags);
+	chan->con_priv = chan->mbox;
+	spin_unlock_irqrestore(&chan->lock, flags);
+	return 0;
+}
+
+static void qcom_cpucp_uke_shutdown(struct mbox_chan *chan)
+{
+	struct qcom_cpucp_mbox *cpucp =
+		container_of(chan->mbox, struct qcom_cpucp_mbox, mbox);
+	unsigned long flags;
+
+	spin_lock_irqsave(&chan->lock, flags);
+	chan->con_priv = NULL;
+	spin_unlock_irqrestore(&chan->lock, flags);
+	synchronize_irq(cpucp->irq);
+}
+
+static int qcom_cpucp_uke_send_data(struct mbox_chan *chan, void *data)
+{
+	struct qcom_cpucp_mbox *cpucp =
+		container_of(chan->mbox, struct qcom_cpucp_mbox, mbox);
+
+	writel(UKE_CPUCP_SEND_BIT, cpucp->tx_base + UKE_CPUCP_SEND_IRQ);
+	return 0;
+}
+
+static const struct mbox_chan_ops qcom_cpucp_uke_ops = {
+	.startup = qcom_cpucp_uke_startup,
+	.shutdown = qcom_cpucp_uke_shutdown,
+	.send_data = qcom_cpucp_uke_send_data,
 };
-
+
 static inline int channel_number(struct mbox_chan *chan)
@@ -147,6 +233,8 @@
 	data = of_device_get_match_data(dev);
 	if (!data)
 		return dev_err_probe(dev, -EINVAL, "No match data found\n");
+	if (data->uke_legacy && !qcom_cpucp_uke_resources(pdev))
+		return dev_err_probe(dev, -EINVAL, "Uke CPUCP resource contract differs\n");
 
 	cpucp = devm_kzalloc(dev, sizeof(*cpucp), GFP_KERNEL);
 	if (!cpucp)
@@ -156,38 +244,47 @@
 	if (!cpucp->chans)
 		return -ENOMEM;
 
-	cpucp->rx_base = devm_of_iomap(dev, dev->of_node, 0, NULL);
+	cpucp->rx_base = devm_of_iomap(dev, dev->of_node, data->uke_legacy ? 1 : 0, NULL);
 	if (IS_ERR(cpucp->rx_base))
 		return PTR_ERR(cpucp->rx_base);
 
-	cpucp->tx_base = devm_of_iomap(dev, dev->of_node, 1, NULL);
+	cpucp->tx_base = devm_of_iomap(dev, dev->of_node, data->uke_legacy ? 0 : 1, NULL);
 	if (IS_ERR(cpucp->tx_base))
 		return PTR_ERR(cpucp->tx_base);
 
-	writeq(0, cpucp->rx_base + APSS_CPUCP_RX_MBOX_EN);
-	writeq(0, cpucp->rx_base + APSS_CPUCP_RX_MBOX_CLEAR);
-	writeq(0, cpucp->rx_base + APSS_CPUCP_RX_MBOX_MAP);
+	if (!data->uke_legacy) {
+		writeq(0, cpucp->rx_base + APSS_CPUCP_RX_MBOX_EN);
+		writeq(0, cpucp->rx_base + APSS_CPUCP_RX_MBOX_CLEAR);
+		writeq(0, cpucp->rx_base + APSS_CPUCP_RX_MBOX_MAP);
+	}
 
 	irq = platform_get_irq(pdev, 0);
 	if (irq < 0)
 		return irq;
+	cpucp->irq = irq;
 
-	ret = devm_request_irq(dev, irq, qcom_cpucp_mbox_irq_fn,
-			       IRQF_TRIGGER_HIGH | IRQF_NO_SUSPEND, "apss_cpucp_mbox", cpucp);
+	ret = devm_request_irq(dev, irq,
+			       data->uke_legacy ? qcom_cpucp_uke_irq_fn : qcom_cpucp_mbox_irq_fn,
+			       IRQF_TRIGGER_HIGH | IRQF_NO_SUSPEND |
+			       (data->uke_legacy ? IRQF_NO_AUTOEN : 0), "apss_cpucp_mbox", cpucp);
 	if (ret < 0)
 		return dev_err_probe(dev, ret, "Failed to register irq: %d\n", irq);
 
-	writeq(APSS_CPUCP_RX_MBOX_CMD_MASK, cpucp->rx_base + APSS_CPUCP_RX_MBOX_MAP);
+	if (!data->uke_legacy)
+		writeq(APSS_CPUCP_RX_MBOX_CMD_MASK, cpucp->rx_base + APSS_CPUCP_RX_MBOX_MAP);
 
 	mbox = &cpucp->mbox;
 	mbox->dev = dev;
 	mbox->num_chans = data->num_chans;
 	mbox->chans = cpucp->chans;
-	mbox->ops = &qcom_cpucp_mbox_chan_ops;
+	mbox->ops = data->uke_legacy ? &qcom_cpucp_uke_ops : &qcom_cpucp_mbox_chan_ops;
 
 	ret = devm_mbox_controller_register(dev, mbox);
 	if (ret)
-		return dev_err_probe(dev, ret, "Failed to create mailbox\n");
+		return dev_err_probe(dev, ret, "Failed to create mailbox\n");
+	/* Legacy RX must not run before mailbox channel locks are initialized. */
+	if (data->uke_legacy)
+		enable_irq(irq);
-
+
-	return 0;
+	return 0;
 }
@@ -200,7 +297,13 @@
 	.num_chans = 16,
 };
 
+static const struct qcom_cpucp_mbox_data qcom_uke_mbox_data = {
+	.num_chans = UKE_CPUCP_CHANNELS,
+	.uke_legacy = true,
+};
+
 static const struct of_device_id qcom_cpucp_mbox_of_match[] = {
+	{ .compatible = "qcom,cpucp", .data = &qcom_uke_mbox_data },
 	{ .compatible = "qcom,nord-cpucp-mbox", .data = &qcom_nord_mbox_data },
 	{ .compatible = "qcom,x1e80100-cpucp-mbox", .data = &qcom_x1e80100_mbox_data },
 	{}
