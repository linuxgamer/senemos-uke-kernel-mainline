 	ops->is_master = dpu_encoder_phys_vid_is_master;
 	ops->atomic_mode_set = dpu_encoder_phys_vid_atomic_mode_set;
+	ops->seamless_mode_set = dpu_encoder_phys_vid_seamless_mode_set;
 	ops->enable = dpu_encoder_phys_vid_enable;
