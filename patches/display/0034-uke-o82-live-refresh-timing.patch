@@ -2944,6 +2947,44 @@ int msm_dsi_host_cmd_broadcast(struct mipi_dsi_host *master_host,
 	return dsi_host_cmd_broadcast(master_host, slave_host, msg, 1, false);
 }
 
+int msm_dsi_host_cmd_pen_clear(struct mipi_dsi_host *master_host,
+		struct mipi_dsi_host *slave_host, const struct mipi_dsi_msg msgs[3])
+{
+	static const u8 payloads[3][2] = {
+		{ 0xff, 0x10 }, { 0xfb, 0x01 }, { 0xb2, 0x80 },
+	};
+	struct msm_dsi_host *master, *slave;
+	unsigned int i;
+	int ret;
+
+	if (!master_host || !slave_host || !msgs)
+		return -EINVAL;
+	master = to_msm_dsi_host(master_host);
+	slave = to_msm_dsi_host(slave_host);
+	if (!msm_dsi_host_uke_dfps_pending(master_host) ||
+	    !msm_dsi_host_uke_dfps_pending(slave_host) ||
+	    !drm_mode_equal(master->mode, slave->mode) ||
+	    !drm_mode_equal(master->uke_dfps_mode, slave->uke_dfps_mode) ||
+	    !dsi_uke_o82_refresh_modes(master, master->mode) ||
+	    !dsi_uke_o82_refresh_modes(slave, slave->mode) ||
+	    !dsi_uke_o82_refresh_modes(master, master->uke_dfps_mode) ||
+	    !dsi_uke_o82_refresh_modes(slave, slave->uke_dfps_mode) ||
+	    !qcom_uke_o82_live_change(master->mode, master->uke_dfps_mode) ||
+	    drm_mode_vrefresh(slave->mode) != 60 ||
+	    drm_mode_vrefresh(slave->uke_dfps_mode) == 120)
+		return -EOPNOTSUPP;
+	for (i = 0; i < ARRAY_SIZE(payloads); i++)
+		if (msgs[i].type != MIPI_DSI_DCS_LONG_WRITE || msgs[i].channel ||
+		    msgs[i].flags || msgs[i].rx_buf || msgs[i].rx_len ||
+		    msgs[i].tx_len != sizeof(payloads[i]) || !msgs[i].tx_buf ||
+		    memcmp(msgs[i].tx_buf, payloads[i], sizeof(payloads[i])))
+			return -EINVAL;
+	mutex_lock(&slave->cmd_mutex);
+	ret = dsi_host_cmd_broadcast(master_host, slave_host, msgs, ARRAY_SIZE(payloads), false);
+	mutex_unlock(&slave->cmd_mutex);
+	return ret;
+}
+
 int msm_dsi_host_cmd_tp_fps(struct mipi_dsi_host *master_host,
 			  struct mipi_dsi_host *slave_host,
 			  const struct mipi_dsi_msg msgs[4])
@@ -2951,17 +2992,29 @@ int msm_dsi_host_cmd_tp_fps(struct mipi_dsi_host *master_host,
 	static const u8 payloads[4][2] = {
 		{ 0xff, 0x10 }, { 0xfb, 0x01 }, { 0xb2, 0x91 }, { 0xb3, 0x40 },
 	};
-	struct msm_dsi_host *slave;
+	struct msm_dsi_host *master, *slave;
+	const struct drm_display_mode *target;
 	u8 selected[4][2];
 	int group;
 	int i, ret;
 
 	if (!master_host || !slave_host || !msgs)
 		return -EINVAL;
+	master = to_msm_dsi_host(master_host);
 	slave = to_msm_dsi_host(slave_host);
+	target = slave->mode;
+	if (master->uke_dfps_staged || slave->uke_dfps_staged) {
+		if (!master->uke_dfps_staged || !slave->uke_dfps_staged ||
+		    !qcom_uke_o82_live_change(master->mode, master->uke_dfps_mode) ||
+		    !dsi_uke_o82_refresh_modes(master, master->uke_dfps_mode) ||
+		    !dsi_uke_o82_refresh_modes(slave, slave->uke_dfps_mode) ||
+		    !drm_mode_equal(master->uke_dfps_mode, slave->uke_dfps_mode))
+			return -EOPNOTSUPP;
+		target = slave->uke_dfps_mode;
+	}
 	memcpy(selected, payloads, sizeof(selected));
-	if (dsi_uke_o82_refresh_modes(slave, slave->mode)) {
-		group = qcom_uke_o82_mode_group(slave->mode);
+	if (dsi_uke_o82_refresh_modes(slave, target)) {
+		group = qcom_uke_o82_mode_group(target);
 		if (group == 1) {
 			selected[2][1] = 0x00;
 			selected[3][1] = 0x00;
@@ -3493,6 +3546,124 @@ int msm_dsi_host_set_display_mode(struct mipi_dsi_host *host,
 	return ret;
 }
 
+/* MiCode 44275c404a67 and Nabu 0b3226fc8f3c: 6G timing shadow DB. */
+#define DSI_UKE_TIMING_DB_TRIGGER (0x01e4 - DSI_6G_REG_SHIFT)
+#define DSI_UKE_TIMING_DB_MODE    (0x01e8 - DSI_6G_REG_SHIFT)
+
+int msm_dsi_host_uke_dfps_queue(struct mipi_dsi_host *host,
+		const struct drm_display_mode *old, const struct drm_display_mode *new_mode)
+{
+	struct msm_dsi_host *h = to_msm_dsi_host(host);
+	struct drm_display_mode *pending = drm_mode_duplicate(h->dev, new_mode);
+	int ret = 0;
+
+	if (!pending)
+		return -ENOMEM;
+	mutex_lock(&h->dev_mutex);
+	if (!h->power_on || !h->enabled || READ_ONCE(h->cmd_dma_blocked) ||
+	    h->uke_dfps_mode || !h->mode || !drm_mode_equal(h->mode, old) ||
+	    !dsi_uke_o82_refresh_modes(h, old) || !dsi_uke_o82_refresh_modes(h, new_mode) ||
+	    !qcom_uke_o82_live_change(old, new_mode)) {
+		ret = -EOPNOTSUPP;
+	} else {
+		h->uke_dfps_mode = pending;
+		pending = NULL;
+	}
+	mutex_unlock(&h->dev_mutex);
+	if (pending)
+		drm_mode_destroy(h->dev, pending);
+	return ret;
+}
+
+bool msm_dsi_host_uke_dfps_pending(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *h = to_msm_dsi_host(host);
+	bool pending;
+
+	mutex_lock(&h->dev_mutex);
+	pending = h->uke_dfps_mode && !h->uke_dfps_staged &&
+		h->power_on && h->enabled && !READ_ONCE(h->cmd_dma_blocked);
+	mutex_unlock(&h->dev_mutex);
+	return pending;
+}
+
+void msm_dsi_host_uke_dfps_cancel(struct mipi_dsi_host *host)
+{
+	struct msm_dsi_host *h = to_msm_dsi_host(host);
+
+	mutex_lock(&h->dev_mutex);
+	if (h->uke_dfps_mode && !h->uke_dfps_staged) {
+		drm_mode_destroy(h->dev, h->uke_dfps_mode);
+		h->uke_dfps_mode = NULL;
+	}
+	mutex_unlock(&h->dev_mutex);
+}
+
+int msm_dsi_host_uke_dfps_pair(struct mipi_dsi_host *host0,
+		struct mipi_dsi_host *host1, bool complete)
+{
+	struct msm_dsi_host *hosts[] = { to_msm_dsi_host(host0), to_msm_dsi_host(host1) };
+	unsigned int i;
+	int ret = -EPIPE;
+
+	/* Clock-master DSI0 first, independent of the DRM bridge-master link. */
+	if (hosts[0]->id != DSI_0 || hosts[1]->id != DSI_1)
+		return -EINVAL;
+	mutex_lock(&hosts[0]->dev_mutex);
+	mutex_lock_nested(&hosts[1]->dev_mutex, SINGLE_DEPTH_NESTING);
+	mutex_lock(&hosts[1]->cmd_mutex);
+	mutex_lock_nested(&hosts[0]->cmd_mutex, SINGLE_DEPTH_NESTING);
+	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+		struct msm_dsi_host *h = hosts[i];
+
+		if (!h->power_on || !h->enabled || READ_ONCE(h->cmd_dma_blocked) ||
+		    !h->uke_dfps_mode || h->uke_dfps_staged != complete ||
+		    !dsi_uke_o82_refresh_modes(h, h->mode) ||
+		    !dsi_uke_o82_refresh_modes(h, h->uke_dfps_mode) ||
+		    !qcom_uke_o82_live_change(h->mode, h->uke_dfps_mode))
+			goto unlock;
+	}
+	if (!hosts[0]->vm || hosts[0]->vm != hosts[1]->vm ||
+	    !drm_mode_equal(hosts[0]->mode, hosts[1]->mode) ||
+	    !drm_mode_equal(hosts[0]->uke_dfps_mode, hosts[1]->uke_dfps_mode))
+		goto unlock;
+	/* Both links are validated and held before the first MMIO write. */
+	for (i = 0; i < ARRAY_SIZE(hosts); i++)
+		dsi_write(hosts[i], DSI_UKE_TIMING_DB_MODE, !complete);
+	wmb();
+	for (i = 0; i < ARRAY_SIZE(hosts); i++) {
+		struct msm_dsi_host *h = hosts[i];
+
+		if (complete) {
+			/* Atomic commit observed a vblank after the DPU timing flush. */
+			drm_mode_destroy(h->dev, h->mode);
+			h->mode = h->uke_dfps_mode;
+			h->uke_dfps_mode = NULL;
+		} else {
+			struct drm_display_mode *active = h->mode;
+
+			/* VFP alone changes: retain active area, sync, DSC and PHY. */
+			h->mode = h->uke_dfps_mode;
+			dsi_write(h, REG_DSI_TOTAL, dsi_uke_o82_total(h));
+			h->mode = active;
+		}
+		h->uke_dfps_staged = !complete;
+	}
+	wmb();
+	if (!complete) {
+		for (i = 0; i < ARRAY_SIZE(hosts); i++)
+			dsi_write(hosts[i], DSI_UKE_TIMING_DB_TRIGGER, 1);
+		wmb();
+	}
+	ret = 0;
+unlock:
+	mutex_unlock(&hosts[0]->cmd_mutex);
+	mutex_unlock(&hosts[1]->cmd_mutex);
+	mutex_unlock(&hosts[1]->dev_mutex);
+	mutex_unlock(&hosts[0]->dev_mutex);
+	return ret;
+}
+
 enum drm_mode_status msm_dsi_host_check_dsc(struct mipi_dsi_host *host,
 					    const struct drm_display_mode *mode)
 {
diff --git a/drivers/gpu/drm/msm/dsi/dsi_manager.c b/drivers/gpu/drm/msm/dsi/dsi_manager.c
index 4e6b453..8a2aa5d 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -30,9 +30,13 @@ struct msm_dsi_manager {
 	bool is_bonded_dsi;
 	bool is_sync_needed;
 	int master_dsi_link_id;
+	bool uke_dfps_failed;
+	struct drm_panel *uke_dfps_panel;
+	const struct qcom_uke_o82_dfps_ops *uke_dfps_ops;
 };
 
 static struct msm_dsi_manager msm_dsim_glb;
+static DEFINE_MUTEX(uke_dfps_panel_lock);
 
 #define IS_BONDED_DSI()		(msm_dsim_glb.is_bonded_dsi)
 #define IS_SYNC_NEEDED()	(msm_dsim_glb.is_sync_needed)
@@ -492,6 +496,10 @@ static void dsi_mgr_bridge_mode_set(struct drm_bridge *bridge,
 	if (is_bonded_dsi && !IS_MASTER_DSI_LINK(id))
 		return;
 
+	/* Queued live timing is owned by the commit tail, not a power modeset. */
+	if (msm_dsi_manager_uke_dfps_pending(bridge->encoder))
+		return;
+
 	msm_dsi_host_set_display_mode(host, adjusted_mode);
 	if (is_bonded_dsi && other_dsi)
 		msm_dsi_host_set_display_mode(other_dsi->host, adjusted_mode);
@@ -560,6 +568,149 @@ static const struct drm_bridge_funcs dsi_mgr_bridge_funcs = {
 	.mode_valid = dsi_mgr_bridge_mode_valid,
 };
 
+int qcom_uke_dsi_dfps_register(struct mipi_dsi_device *dsi,
+		struct drm_panel *panel, const struct qcom_uke_o82_dfps_ops *ops)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	int ret = 0;
+
+	if (!dsi || !panel || !master || dsi->host != master->host ||
+	    !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
+	    !of_machine_is_compatible("xiaomi,uke") ||
+	    !of_machine_is_compatible("qcom,sm7675") ||
+	    !of_device_is_compatible(dsi->dev.of_node, "xiaomi,o82-42-02-0b") ||
+	    !of_property_read_bool(dsi->dev.of_node, "xiaomi,oem-refresh-modes") ||
+	    (ops && (!ops->check || !ops->apply)))
+		return -EOPNOTSUPP;
+	mutex_lock(&uke_dfps_panel_lock);
+	if (msm_dsim_glb.uke_dfps_panel && msm_dsim_glb.uke_dfps_panel != panel) {
+		ret = -EBUSY;
+	} else {
+		/* Unregister waits for the last callback before panel removal. */
+		msm_dsim_glb.uke_dfps_panel = ops ? panel : NULL;
+		msm_dsim_glb.uke_dfps_ops = ops;
+	}
+	mutex_unlock(&uke_dfps_panel_lock);
+	return ret;
+}
+EXPORT_SYMBOL_GPL(qcom_uke_dsi_dfps_register);
+
+int msm_dsi_manager_uke_dfps_panel(struct drm_encoder *encoder,
+		const struct drm_display_mode *old, const struct drm_display_mode *new,
+		bool before)
+{
+	struct drm_bridge *bridge = drm_bridge_chain_get_first_bridge(encoder);
+	struct dsi_bridge *b;
+	int ret = -EOPNOTSUPP;
+
+	if (!bridge || bridge->funcs != &dsi_mgr_bridge_funcs)
+		goto out;
+	b = to_dsi_bridge(bridge);
+	mutex_lock(&uke_dfps_panel_lock);
+	if (msm_dsim_glb.uke_dfps_panel == b->o82_panel &&
+	    msm_dsim_glb.uke_dfps_ops && !msm_dsi_manager_uke_dfps_failed())
+		ret = msm_dsim_glb.uke_dfps_ops->apply(b->o82_panel, old, new, before);
+	mutex_unlock(&uke_dfps_panel_lock);
+out:
+	drm_bridge_put(bridge);
+	return ret;
+}
+
+bool msm_dsi_manager_uke_dfps_failed(void)
+{
+	return READ_ONCE(msm_dsim_glb.uke_dfps_failed);
+}
+
+void msm_dsi_manager_uke_dfps_fail(void)
+{
+	/* No teardown or reprobe after an unproved live timing latch. */
+	WRITE_ONCE(msm_dsim_glb.uke_dfps_failed, true);
+}
+
+bool msm_dsi_manager_uke_dfps_pending(struct drm_encoder *encoder)
+{
+	struct drm_bridge *bridge = drm_bridge_chain_get_first_bridge(encoder);
+	struct msm_dsi *master, *slave;
+	struct dsi_bridge *b;
+	bool pending = false;
+
+	if (!bridge || bridge->funcs != &dsi_mgr_bridge_funcs ||
+	    !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
+	    msm_dsi_manager_uke_dfps_failed())
+		goto out;
+	b = to_dsi_bridge(bridge);
+	if (!IS_MASTER_DSI_LINK(b->id))
+		goto out;
+	master = dsi_mgr_get_dsi(b->id);
+	slave = dsi_mgr_get_other_dsi(b->id);
+	pending = master && slave && msm_dsi_host_uke_dfps_pending(master->host) &&
+		msm_dsi_host_uke_dfps_pending(slave->host);
+out:
+	drm_bridge_put(bridge);
+	return pending;
+}
+
+bool msm_dsi_manager_uke_dfps_prepare(struct drm_encoder *encoder,
+		const struct drm_display_mode *old, const struct drm_display_mode *new)
+{
+	struct drm_bridge *bridge = drm_bridge_chain_get_first_bridge(encoder);
+	struct dsi_bridge *b;
+	struct msm_dsi *master, *slave;
+	bool prepared = false;
+
+	if (!bridge || bridge->funcs != &dsi_mgr_bridge_funcs ||
+	    !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
+	    msm_dsi_manager_uke_dfps_failed() || !qcom_uke_o82_live_change(old, new))
+		goto out;
+	b = to_dsi_bridge(bridge);
+	if (!b->o82_panel || !b->o82_panel->prepared || !b->powered ||
+	    !b->video_enabled || !IS_MASTER_DSI_LINK(b->id))
+		goto out;
+	mutex_lock(&uke_dfps_panel_lock);
+	if (msm_dsim_glb.uke_dfps_panel != b->o82_panel ||
+	    !msm_dsim_glb.uke_dfps_ops ||
+	    !msm_dsim_glb.uke_dfps_ops->check(b->o82_panel, old, new)) {
+		mutex_unlock(&uke_dfps_panel_lock);
+		goto out;
+	}
+	mutex_unlock(&uke_dfps_panel_lock);
+	master = dsi_mgr_get_dsi(b->id);
+	slave = dsi_mgr_get_other_dsi(b->id);
+	if (!master || !slave)
+		goto out;
+	if (msm_dsi_host_uke_dfps_queue(master->host, old, new))
+		goto out;
+	if (msm_dsi_host_uke_dfps_queue(slave->host, old, new)) {
+		/* Nothing was written; the ordinary full modeset is still safe. */
+		msm_dsi_host_uke_dfps_cancel(master->host);
+		goto out;
+	}
+	prepared = true;
+out:
+	drm_bridge_put(bridge);
+	return prepared;
+}
+
+int msm_dsi_manager_uke_dfps_stage(void)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+
+	if (!master || !slave)
+		return -EPIPE;
+	return msm_dsi_host_uke_dfps_pair(master->host, slave->host, false);
+}
+
+int msm_dsi_manager_uke_dfps_complete(void)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+
+	if (!master || !slave)
+		return -EPIPE;
+	return msm_dsi_host_uke_dfps_pair(master->host, slave->host, true);
+}
