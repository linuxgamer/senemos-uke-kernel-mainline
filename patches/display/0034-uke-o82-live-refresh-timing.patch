@@ -310,7 +312,8 @@ static bool dsi_uke_o82_powered_profile(struct msm_dsi_host *msm_host)
 
 static u32 dsi_uke_o82_total(struct msm_dsi_host *msm_host)
 {
-	const struct drm_display_mode *mode = msm_host->mode;
