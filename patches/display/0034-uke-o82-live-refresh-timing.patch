 	return 0;
 }
 
+int qcom_uke_dsi_pen_clear_batch(struct mipi_dsi_device *dsi,
+		const struct mipi_dsi_msg *msgs)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_CLOCK_MASTER);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_CLOCK_SLAVE);
+
+	if (!dsi || !msgs || !master || !slave || dsi->host != master->host ||
+	    !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
+	    msm_dsi_manager_uke_dfps_failed())
+		return -EOPNOTSUPP;
+	return msm_dsi_host_cmd_pen_clear(master->host, slave->host, msgs);
+}
+EXPORT_SYMBOL_GPL(qcom_uke_dsi_pen_clear_batch);
