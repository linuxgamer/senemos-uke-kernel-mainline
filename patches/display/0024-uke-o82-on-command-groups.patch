From: MCC45TR <mcc45tr@users.noreply.github.com>
Subject: [PATCH] drm/msm/dsi: preserve OEM O82 LP ON command groups

Follow MiCode display 44275c404a677d9d9e5230fedd1af2ef02fc7b9a and
display DT 4a3e1c391130237c5e8c2b250d1c94f3e25b9b11 (GPL-2.0-only).
Use bounded synchronous ON chunks before video in the isolated PB120 profile.
Preserve the OEM forced-terminal size rule and existing paired DMA handling.
Retain quarantined resources during ordinary bridge unwind and re-enable.
No optical output or arbitrary teardown recovery claim is made.

--- a/drivers/gpu/drm/msm/dsi/dsi_host.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_host.c
@@ -2652,7 +2652,8 @@
 
 static int dsi_host_cmd_broadcast(struct mipi_dsi_host *master_host,
 				  struct mipi_dsi_host *slave_host,
-				  const struct mipi_dsi_msg *msg, unsigned int count)
+				  const struct mipi_dsi_msg *msg, unsigned int count,
+				  bool on_batch)
 {
 	struct msm_dsi_host *master = to_msm_dsi_host(master_host);
 	struct msm_dsi_host *slave = to_msm_dsi_host(slave_host);
@@ -2677,7 +2678,8 @@
 		ret = -EIO;
 		goto unlock;
 	}
-	if (count == 4 && (!master->enabled || !slave->enabled ||
+	if ((count > 1 || on_batch) &&
+	    ((on_batch ? master->enabled || slave->enabled : !master->enabled || !slave->enabled) ||
 	    !master->mode || !slave->mode ||
 	    master->lanes != 4 || slave->lanes != 4 ||
 	    master->format != MIPI_DSI_FMT_RGB101010 ||
@@ -2689,6 +2691,22 @@
 		ret = -EOPNOTSUPP;
 		goto unlock;
 	}
+	if (on_batch &&
+	    (dsi_read(master, REG_DSI_ACTIVE_V) != 0x08ec0094 ||
+	     dsi_read(slave, REG_DSI_ACTIVE_V) != 0x08ec0094 ||
+	     !(dsi_read(master, REG_DSI_CTRL) & DSI_CTRL_ENABLE) ||
+	     !(dsi_read(slave, REG_DSI_CTRL) & DSI_CTRL_ENABLE) ||
+	     ((dsi_read(master, REG_DSI_CTRL) | dsi_read(slave, REG_DSI_CTRL)) &
+	      DSI_CTRL_VID_MODE_EN) ||
+	     dsi_read(master, UKE_DSI_DMA_SCHEDULE_CTRL) ||
+	     dsi_read(slave, UKE_DSI_DMA_SCHEDULE_CTRL) ||
+	     dsi_read(master, UKE_DSI_DMA_SCHEDULE_CTRL2) ||
+	     dsi_read(slave, UKE_DSI_DMA_SCHEDULE_CTRL2) ||
+	     ((dsi_read(master, REG_DSI_STATUS0) | dsi_read(slave, REG_DSI_STATUS0)) &
+	      DSI_STATUS0_CMD_MODE_DMA_BUSY))) {
+		ret = -EBUSY;
+		goto unlock;
+	}
 	ret = msm_dsi_host_xfer_prepare(master_host, msg);
 	if (ret)
 		goto unlock;
@@ -2697,7 +2715,7 @@
 		goto restore_master;
 
 	/* Both TX buffers use the same KMS VM; the peer can read this IOVA. */
-	if (count == 1) {
+	if (count == 1 && !on_batch) {
 		ret = dsi_cmds2buf_tx(slave, msg, false, master);
 	} else {
 		for (i = 0; i < count; i++) {
@@ -2732,7 +2750,7 @@
 			       struct mipi_dsi_host *slave_host,
 			       const struct mipi_dsi_msg *msg)
 {
-	return dsi_host_cmd_broadcast(master_host, slave_host, msg, 1);
+	return dsi_host_cmd_broadcast(master_host, slave_host, msg, 1, false);
 }
 
 int msm_dsi_host_cmd_tp_fps(struct mipi_dsi_host *master_host,
@@ -2755,7 +2773,7 @@
 		    memcmp(msgs[i].tx_buf, payloads[i], sizeof(payloads[i])))
 			return -EINVAL;
 	mutex_lock(&slave->cmd_mutex);
-	ret = dsi_host_cmd_broadcast(master_host, slave_host, msgs, ARRAY_SIZE(payloads));
+	ret = dsi_host_cmd_broadcast(master_host, slave_host, msgs, ARRAY_SIZE(payloads), false);
 	mutex_unlock(&slave->cmd_mutex);
 	if (!ret)
 		dev_info_once(&slave->pdev->dev,
@@ -2763,6 +2781,32 @@
 	return ret;
 }
 
+int msm_dsi_host_cmd_on_batch(struct mipi_dsi_host *master_host,
+			    struct mipi_dsi_host *slave_host,
+			    const struct mipi_dsi_msg *msgs, unsigned int count)
+{
+	struct msm_dsi_host *slave;
+	unsigned int i, bytes = 0;
+	int ret;
+
+	if (!master_host || !slave_host || !msgs || !count || count > 31)
+		return -EINVAL;
+	for (i = 0; i < count; i++) {
+		if (msgs[i].type != MIPI_DSI_DCS_LONG_WRITE || msgs[i].channel ||
+		    msgs[i].flags != MIPI_DSI_MSG_USE_LPM || msgs[i].rx_buf || msgs[i].rx_len ||
+		    !msgs[i].tx_len || msgs[i].tx_len > 17 || !msgs[i].tx_buf)
+			return -EINVAL;
+		bytes += ALIGN(msgs[i].tx_len + 4, 4);
+	}
+	if (bytes > 248)
+		return -EINVAL;
+	slave = to_msm_dsi_host(slave_host);
+	mutex_lock(&slave->cmd_mutex);
+	ret = dsi_host_cmd_broadcast(master_host, slave_host, msgs, count, true);
+	mutex_unlock(&slave->cmd_mutex);
+	return ret;
+}
+
 int msm_dsi_host_cmd_tx(struct mipi_dsi_host *host,
 				const struct mipi_dsi_msg *msg)
 {
@@ -3031,15 +3075,25 @@
 	return ret;
 }
 
+bool msm_dsi_host_dma_blocked(struct mipi_dsi_host *host)
+{
+	return READ_ONCE(to_msm_dsi_host(host)->cmd_dma_blocked);
+}
+
 int msm_dsi_host_disable(struct mipi_dsi_host *host)
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 	bool serialize = dsi_uke_misr_scope(msm_host);
+	int ret = 0;
 
 	if (serialize) {
 		mutex_lock(&msm_host->dev_mutex);
 		mutex_lock(&msm_host->cmd_mutex);
 	}
+	if (READ_ONCE(msm_host->cmd_dma_blocked)) {
+		ret = -EIO;
+		goto unlock;
+	}
 
 	msm_host->enabled = false;
 	dsi_op_mode_config(msm_host,
@@ -3050,12 +3104,13 @@
 	 * Reset to disable video engine so that we can send off cmd.
 	 */
 	dsi_sw_reset(msm_host);
+unlock:
 	if (serialize) {
 		mutex_unlock(&msm_host->cmd_mutex);
 		mutex_unlock(&msm_host->dev_mutex);
 	}
 
-	return 0;
+	return ret;
 }
 
 static void msm_dsi_sfpb_config(struct msm_dsi_host *msm_host, bool enable)
@@ -3141,8 +3196,13 @@
 {
 	struct msm_dsi_host *msm_host = to_msm_dsi_host(host);
 	const struct msm_dsi_cfg_handler *cfg_hnd = msm_host->cfg_hnd;
+	int ret = 0;
 
 	mutex_lock(&msm_host->dev_mutex);
+	if (READ_ONCE(msm_host->cmd_dma_blocked)) {
+		ret = -EIO;
+		goto unlock_ret;
+	}
 	if (!msm_host->power_on) {
 		DBG("dsi host already off");
 		goto unlock_ret;
@@ -3166,7 +3226,7 @@
 
 unlock_ret:
 	mutex_unlock(&msm_host->dev_mutex);
-	return 0;
+	return ret;
 }
 
 int msm_dsi_host_set_display_mode(struct mipi_dsi_host *host,
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -282,21 +282,27 @@
 	return ret;
 }
 
-static void dsi_mgr_bridge_power_off(struct drm_bridge *bridge)
+static int dsi_mgr_bridge_power_off(struct drm_bridge *bridge)
 {
 	int id = dsi_mgr_bridge_get_id(bridge);
 	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
 	struct msm_dsi *msm_dsi1 = dsi_mgr_get_dsi(DSI_1);
 	struct mipi_dsi_host *host = msm_dsi->host;
 	bool is_bonded_dsi = IS_BONDED_DSI();
+	int ret;
 
 	msm_dsi_host_disable_irq(host);
 	if (is_bonded_dsi && msm_dsi1) {
 		msm_dsi_host_disable_irq(msm_dsi1->host);
-		msm_dsi_host_power_off(msm_dsi1->host);
+		ret = msm_dsi_host_power_off(msm_dsi1->host);
+		if (ret)
+			return ret;
 	}
-	msm_dsi_host_power_off(host);
+	ret = msm_dsi_host_power_off(host);
+	if (ret)
+		return ret;
 	dsi_mgr_phy_disable(id);
+	return 0;
 }
 
 static int dsi_mgr_bridge_enable_hosts(struct drm_bridge *bridge)
@@ -337,6 +343,8 @@
 	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
 	int ret;
 
+	if (msm_dsi_host_dma_blocked(msm_dsi->host))
+		return;
 	if (IS_BONDED_DSI() && !IS_MASTER_DSI_LINK(id))
 		return;
 
@@ -415,6 +423,8 @@
 
 	DBG("id=%d", id);
 
+	if (msm_dsi_host_dma_blocked(host))
+		return;
 	/*
 	 * Do nothing with the host if it is slave-DSI in case of bonded DSI.
 	 * It is safe to call dsi_mgr_phy_disable() here because a single PHY
@@ -427,7 +437,8 @@
 		if (dsi_bridge->powered) {
 			dsi_mgr_bridge_disable(bridge, commit);
 			msm_dsi_phy_pll_save_state(msm_dsi->phy);
-			dsi_mgr_bridge_power_off(bridge);
+			if (dsi_mgr_bridge_power_off(bridge))
+				return;
 			dsi_bridge->powered = false;
 		}
 		return;
@@ -609,6 +620,23 @@
 }
 EXPORT_SYMBOL_GPL(qcom_uke_dsi_tp_fps_batch);
 
+int qcom_uke_dsi_on_batch(struct mipi_dsi_device *dsi,
+			 const struct mipi_dsi_msg *msgs, unsigned int count)
+{
+	struct msm_dsi *master = dsi_mgr_get_dsi(DSI_0);
+	struct msm_dsi *slave = dsi_mgr_get_dsi(DSI_1);
+
+	if (!dsi || !msgs || !dsi->host || !master || !slave ||
+	    !master->host || !slave->host ||
+	    dsi->host != master->host || !IS_BONDED_DSI() || !IS_SYNC_NEEDED() ||
+	    IS_ERR_OR_NULL(dsi_mgr_o82_panel(master)) ||
+	    !of_device_is_compatible(dsi->dev.of_node, "xiaomi,o82-42-02-0b") ||
+	    !of_property_read_bool(dsi->dev.of_node, "xiaomi,initial-120hz-only"))
+		return -EOPNOTSUPP;
+	return msm_dsi_host_cmd_on_batch(master->host, slave->host, msgs, count);
+}
+EXPORT_SYMBOL_GPL(qcom_uke_dsi_on_batch);
+
 int msm_dsi_manager_cmd_xfer(int id, const struct mipi_dsi_msg *msg)
 {
 	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
