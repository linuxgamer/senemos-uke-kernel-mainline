 #include "drm/drm_bridge_connector.h"
 #include <drm/drm_panel.h>
+#include <drm/drm_atomic.h>
 #include <drm/uke-o82-mode.h>
+#include <linux/hdmi.h>
 #include <linux/of_graph.h>
 #include <linux/debugfs.h>
 #include <linux/seq_file.h>
@@ -604,6 +606,33 @@ static void dsi_mgr_bridge_debugfs_init(struct drm_bridge *bridge,
 				    &dsi_mgr_output_bits_fops);
 }
 
+static int dsi_mgr_bridge_atomic_check(struct drm_bridge *bridge,
+		struct drm_bridge_state *bridge_state,
+		struct drm_crtc_state *crtc_state,
+		struct drm_connector_state *conn_state)
+{
+	struct drm_connector_state *old;
+	const struct hdr_output_metadata *hdr;
+	struct drm_property_blob *metadata = conn_state->hdr_output_metadata;
+
+	if (!to_dsi_bridge(bridge)->o82_panel)
+		return 0;
+	if (conn_state->abm_level > 4)
+		return -EINVAL;
+	if (conn_state->abm_level && metadata) {
+		if (metadata->length != sizeof(*hdr))
+			return -EINVAL;
+		hdr = metadata->data;
+		if (hdr->metadata_type || hdr->hdmi_metadata_type1.metadata_type ||
+		    hdr->hdmi_metadata_type1.eotf != HDMI_EOTF_TRADITIONAL_GAMMA_SDR)
+			return -EOPNOTSUPP;
+	}
+	old = drm_atomic_get_old_connector_state(conn_state->state, conn_state->connector);
+	if (!old || old->abm_level != conn_state->abm_level)
+		crtc_state->mode_changed = true;
+	return 0;
+}
