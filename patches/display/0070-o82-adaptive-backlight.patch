diff --git a/drivers/gpu/drm/drm_connector.c b/drivers/gpu/drm/drm_connector.c
index f0faccc..bdbf4a9 100644
--- a/drivers/gpu/drm/drm_connector.c
+++ b/drivers/gpu/drm/drm_connector.c
@@ -2962,6 +2962,35 @@ int drm_connector_attach_colorspace_property(struct drm_connector *connector)
 }
 EXPORT_SYMBOL(drm_connector_attach_colorspace_property);
 
+/**
+ * drm_connector_attach_abm_property - attach atomic backlight adaptation control
+ * @connector: internal connector with a content-adaptive backlight implementation
+ *
+ * The driver applies the requested tier during a full modeset. Zero disables
+ * adaptation; the remaining tiers trade color accuracy for power saving.
+ *
+ * Return: zero on success, negative errno on allocation failure.
+ */
+int drm_connector_attach_abm_property(struct drm_connector *connector)
+{
+	static const struct drm_prop_enum_list levels[] = {
+		{ 0, "off" }, { 1, "min" }, { 2, "bias min" },
+		{ 3, "bias max" }, { 4, "max" },
+	};
+	struct drm_property *property;
+
+	if (connector->abm_level_property)
+		return 0;
+	property = drm_property_create_enum(connector->dev, DRM_MODE_PROP_ATOMIC,
+			"adaptive backlight modulation", levels, ARRAY_SIZE(levels));
+	if (!property)
+		return -ENOMEM;
+	connector->abm_level_property = property;
+	drm_object_attach_property(&connector->base, property, 0);
+	return 0;
+}
+EXPORT_SYMBOL(drm_connector_attach_abm_property);
