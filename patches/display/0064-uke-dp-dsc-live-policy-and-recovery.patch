+static int msm_dp_display_dsc_health(struct msm_dp_display_private *dp)
+{
+	u8 status[DP_LINK_STATUS_SIZE], value, count[2];
+	int ret;
+
+	dp->panel->dsc_counter_valid = false;
+	ret = drm_dp_dpcd_read_link_status(dp->aux, status);
+	if (ret)
+		return ret;
+	if (!drm_dp_channel_eq_ok(status, dp->link->link_params.num_lanes))
+		return -ENOLINK;
+	ret = drm_dp_dpcd_read_byte(dp->aux, DP_DSC_ENABLE, &value);
+	if (ret)
+		return ret;
+	if (!(value & DP_DECOMPRESSION_EN))
+		return -EIO;
+	ret = drm_dp_dpcd_read_byte(dp->aux, DP_FEC_CONFIGURATION, &value);
+	if (ret)
+		return ret;
+	if (!(value & DP_FEC_READY))
+		return -EIO;
+	if (!(dp->panel->fec_cap & DP_FEC_UNCORR_BLK_ERROR_COUNT_CAP) ||
+	    (value & DP_FEC_ERR_COUNT_SEL_MASK) != DP_FEC_UNCORR_BLK_ERROR_COUNT)
+		return 0;
+	ret = drm_dp_dpcd_read_data(dp->aux, DP_FEC_ERROR_COUNT_LSB, count, sizeof(count));
+	if (ret)
+		return ret;
+	if (!(count[1] & DP_FEC_ERR_COUNT_VALID))
+		return 0;
+	dp->panel->dsc_counter_valid = true;
+	dp->panel->dsc_uncorrected = count[0] | ((count[1] & DP_FEC_ERROR_COUNT_MASK) << 8);
+	return dp->panel->dsc_uncorrected ? -EILSEQ : 0;
+}
+
+static void msm_dp_display_dsc_health_work(struct work_struct *work)
+{
+	struct msm_dp_display_private *dp = container_of(to_delayed_work(work),
+		struct msm_dp_display_private, dsc_health_work);
+	int ret;
+
+	scoped_guard(mutex, &dp->plugged_lock) {
+		if (!dp->dsc_control_bound || !dp->plugged || !dp->panel->dsc_active ||
+		    !dp->msm_dp_display.active_stream_cnt || dp->panel->dsc_failed)
+			return;
+		ret = msm_dp_display_dsc_health(dp);
+		if (!ret) {
+			schedule_delayed_work(&dp->dsc_health_work, HZ);
+			return;
+		}
+		dp->panel->dsc_last_error = ret;
+	}
+	msm_dp_display_set_link_failure(&dp->msm_dp_display, true);
+}
