From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] arm64: select the isolated Uke native display graph

The normal firmware-framebuffer path remains unchanged. This additional patch
is applied only by the native candidate preparer after the normal ABL hook.
Keep the bootloader-selected memory, reservations and panel selector; restore
the output buffer capacity before applying the source-compiled display overlay.
Reject an incompatible graph before OF scans it. This is not physical support
evidence and must not be added to the normal release series.

--- a/arch/arm64/kernel/uke-abl.c
+++ b/arch/arm64/kernel/uke-abl.c
@@ -1069,5 +1069,7 @@
  */
 static unsigned char uke_fdt[UKE_FDT_CAPACITY] __ro_after_init __aligned(8);
+#include "uke-abl-native.h"
+#include "uke-native-display.h"
 #include "uke-lights.h"
 
 void *__init uke_abl_prepare_fdt(void *input, int size, phys_addr_t *physical)
@@ -1080,6 +1082,14 @@
 	ret = uke_abl_transform(uke_fdt, sizeof(uke_fdt), input, size,
 			      uke_ufs_overlay, sizeof(uke_ufs_overlay),
 			      uke_usb_overlay, sizeof(uke_usb_overlay));
+	if (ret > 0) {
+		ret = fdt_open_into(uke_fdt, uke_fdt, sizeof(uke_fdt));
+		if (!ret)
+			ret = uke_abl_native_select(uke_fdt, uke_native_panels,
+						    ARRAY_SIZE(uke_native_panels));
+		if (!ret)
+			ret = 1;
+	}
 	if (ret < 0) {
 		pr_crit("Uke ABL DT adaptation rejected (%d); refusing incomplete board graph\n", ret);
 		while (true)
@@ -1102,7 +1112,7 @@
 		pr_warn("Uke lights: OEM graph not admitted; light controls unavailable\n");
 	}
 	*physical = __pa_symbol(uke_fdt);
-	pr_info("Uke ABL DT: selected RAM preserved; UFS, selected USB profile and simplefb prepared\n");
+	pr_info("Uke ABL DT: selected RAM preserved; native display and selected USB profile prepared\n");
 	return uke_fdt;
 }
 
