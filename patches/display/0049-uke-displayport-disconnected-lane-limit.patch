From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Date: Sat, 24 Oct 2026 18:40:00 +0000
Subject: [PATCH] drm/msm/dp: add a disconnected Uke link lane ceiling

Allow root to limit link training to one, two or four lanes before attachment.
Serialize policy changes with sink discovery and refuse a plugged, active or
starting stream. Preserve the four-lane default and always clip against sink,
source and LTTPR limits. Expose the policy separately from actual wire state.

This is a software upper bound, not a Type-C pin-assignment override. It does
not increase the source link-rate ceiling or change USB/PD routing. A firmware
negotiation limited to two lanes cannot be converted to four by this policy.

diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -1255,18 +1255,59 @@
 	guard(mutex)(&dp->plugged_lock);
 	active = READ_ONCE(dp->msm_dp_display.power_on);
 	return sysfs_emit(buf,
-		"version=1 active=%u lanes=%u rate_khz=%u bpp=%u max_lanes=%u max_rate_khz=%u source_max_lanes=%u sink_max_lanes=%u dpcd_revision=0x%02x vsc_supported=%u hw_revision=0x%x hdr_requested=%u mst_driver=0\n",
+		"version=1 active=%u lanes=%u rate_khz=%u bpp=%u max_lanes=%u max_rate_khz=%u source_max_lanes=%u sink_max_lanes=%u dpcd_revision=0x%02x vsc_supported=%u hw_revision=0x%x hdr_requested=%u mst_driver=0 lane_limit=%u\n",
 		active, active ? READ_ONCE(dp->link->link_params.num_lanes) : 0,
 		active ? READ_ONCE(dp->link->link_params.rate) : 0,
 		active ? READ_ONCE(panel->msm_dp_mode.bpp) : 0,
 		panel->link_info.num_lanes, panel->link_info.rate,
 		dp->link->max_dp_lanes, drm_dp_max_lane_count(panel->dpcd), panel->dpcd[DP_DPCD_REV],
-		panel->vsc_sdp_supported, panel->hw_revision, READ_ONCE(panel->hdr_active));
+		panel->vsc_sdp_supported, panel->hw_revision, READ_ONCE(panel->hdr_active),
+		panel->lane_limit);
 }
 static DEVICE_ATTR_RO(uke_dp_stream_state);
 
+static int msm_dp_display_set_lane_limit(struct msm_dp_display_private *dp,
+				       unsigned int lanes)
+{
+	guard(mutex)(&dp->plugged_lock);
+	if ((lanes != 1 && lanes != 2 && lanes != 4) || lanes > dp->link->max_dp_lanes)
+		return -EINVAL;
+	/* A policy change must not race sink discovery or disturb a live stream. */
+	if (dp->plugged || READ_ONCE(dp->msm_dp_display.power_on) ||
+	    READ_ONCE(dp->stream_pm_active) || READ_ONCE(dp->stream_link_attempted))
+		return -EBUSY;
+	WRITE_ONCE(dp->panel->lane_limit, lanes);
+	return 0;
+}
+
+static ssize_t uke_dp_lane_limit_show(struct device *dev,
+				     struct device_attribute *attr, char *buf)
+{
+	struct msm_dp_display_private *dp = dev_get_dp_display_private(dev);
+
+	guard(mutex)(&dp->plugged_lock);
+	return sysfs_emit(buf, "%u\n", dp->panel->lane_limit);
+}
+
+static ssize_t uke_dp_lane_limit_store(struct device *dev,
+				      struct device_attribute *attr,
+				      const char *buf, size_t count)
+{
+	struct msm_dp_display_private *dp = dev_get_dp_display_private(dev);
+	unsigned int lanes;
+	int ret;
+
+	ret = kstrtouint(buf, 0, &lanes);
+	if (ret)
+		return ret;
+	ret = msm_dp_display_set_lane_limit(dp, lanes);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(uke_dp_lane_limit);
+
 static struct attribute *uke_dp_stream_attrs[] = {
 	&dev_attr_uke_dp_stream_state.attr,
+	&dev_attr_uke_dp_lane_limit.attr,
 	NULL,
 };
 static const struct attribute_group uke_dp_stream_group = {
diff --git a/drivers/gpu/drm/msm/dp/dp_panel.c b/drivers/gpu/drm/msm/dp/dp_panel.c
--- a/drivers/gpu/drm/msm/dp/dp_panel.c
+++ b/drivers/gpu/drm/msm/dp/dp_panel.c
@@ -193,6 +193,7 @@
 	/* Limit data lanes from data-lanes of endpoint property of dtsi */
 	if (link_info->num_lanes > link->max_dp_lanes)
 		link_info->num_lanes = link->max_dp_lanes;
+	link_info->num_lanes = min(link_info->num_lanes, msm_dp_panel->lane_limit);
 
 	/* Limit data lanes from LTTPR capabilities, if any */
 	if (max_lttpr_lanes && max_lttpr_lanes < link_info->num_lanes)
@@ -750,6 +751,7 @@
 
 	msm_dp_panel = &panel->msm_dp_panel;
 	msm_dp_panel->max_bw_code = DP_LINK_BW_8_1;
+	msm_dp_panel->lane_limit = 4;
 
 	return msm_dp_panel;
 }
diff --git a/drivers/gpu/drm/msm/dp/dp_panel.h b/drivers/gpu/drm/msm/dp/dp_panel.h
--- a/drivers/gpu/drm/msm/dp/dp_panel.h
+++ b/drivers/gpu/drm/msm/dp/dp_panel.h
@@ -42,6 +42,7 @@
 	u32 hw_revision;
 
 	u32 max_bw_code;
+	u32 lane_limit;
 };
 
 int msm_dp_panel_init_panel_info(struct msm_dp_panel *msm_dp_panel,
diff --git a/Documentation/ABI/testing/sysfs-platform-uke-dp b/Documentation/ABI/testing/sysfs-platform-uke-dp
new file mode 100644
--- /dev/null
+++ b/Documentation/ABI/testing/sysfs-platform-uke-dp
@@ -0,0 +1,23 @@
+What:           /sys/bus/platform/devices/.../uke_dp_lane_limit
+Date:           October 2026
+Contact:        Senemos Maintainers
+Description:
+                Uke DisplayPort software link-training ceiling, in lanes.
+                Valid values are 1, 2 and 4, up to the source's DT capacity.
+                The default is 4. This setting is not persistent across probe
+                or reboot and does not change the advertised physical source
+                capacity. It never raises the source link-rate ceiling.
+
+                A root write is accepted only while no DP sink is plugged and
+                no stream is active or starting. Otherwise it fails with EBUSY.
+                The same mutex serializes writes with HPD capability discovery.
+                A later attachment clips the lane count against sink DPCD,
+                source capacity, this ceiling and any LTTPR limit. Writing this
+                attribute performs no AUX, PHY, mux, Type-C or USB transaction.
+
+                This is not a USB-C pin-assignment override. A two-lane firmware
+                negotiation remains at most two lanes even with a ceiling of
+                four; reducing link training to one lane does not create a new
+                three-pair USB mode. Actual active parameters are separately
+                reported by uke_dp_stream_state. A successful policy write is
+                not physical link or image acceptance.
