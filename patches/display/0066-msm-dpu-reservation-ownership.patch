From: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] drm/msm/dpu: retain coherent resource ownership across color updates

Only reserve a new display topology when the encoder is programmed again.
Request a modeset for a newly required DSPP through the existing DPU check,
without overriding userspace's allow_modeset permission. Retain the Uke
DFPS quarantine and MST checks. Clear CWB, CDM, DSC and DSPP pointers when a
new reservation does not assign their blocks, so later setup/cleanup cannot
program another CRTC's resources.

Adapted from Dmitry Baryshkov's GPL-2.0-only v5 SMMU fixes, patches 5-9:
https://patchew.org/linux/20261024-fd-kms-fix-smmu-v5-0-a5b0b284aead@oss.qualcomm.com/
The Linux 7.3 adaptation preserves the existing Uke timing/DSC changes.
Deferred scanout retirement is separate; this patch does not establish a
causal correction for every historical display fault.

Upstream-Status: Pending [Linux 7.3 adaptation of the linked resource fixes]
Signed-off-by: MCC45TR <75160848+MCC45TR@users.noreply.github.com>
---
--- a/drivers/gpu/drm/msm/msm_atomic.c
+++ b/drivers/gpu/drm/msm/msm_atomic.c
@@ -380,26 +380,11 @@
 {
 	struct msm_drm_private *priv = dev->dev_private;
 	struct msm_kms *kms = priv->kms;
-	struct drm_crtc_state *old_crtc_state, *new_crtc_state;
-	struct drm_crtc *crtc;
-	int i, ret = 0;
+	int ret = 0;
 
 	if (msm_uke_dfps_failed())
 		return -EIO;
 
-	/*
-	 * FIXME: stop setting allow_modeset and move this check to the DPU
-	 * driver.
-	 */
-	for_each_oldnew_crtc_in_state(state, crtc, old_crtc_state,
-				      new_crtc_state, i) {
-		if ((old_crtc_state->ctm && !new_crtc_state->ctm) ||
-		    (!old_crtc_state->ctm && new_crtc_state->ctm)) {
-			new_crtc_state->mode_changed = true;
-			state->allow_modeset = true;
-		}
-	}
-
 	if (kms && kms->funcs && kms->funcs->check_mode_changed)
 		ret = kms->funcs->check_mode_changed(kms, state);
 	if (ret)
--- a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc.c
@@ -1498,8 +1498,8 @@
 
 		cstate->mixers[i].hw_lm = to_dpu_hw_mixer(hw_lm[i]);
 		cstate->mixers[i].lm_ctl = to_dpu_hw_ctl(hw_ctl[ctl_idx]);
-		if (i < num_dspp)
-			cstate->mixers[i].hw_dspp = to_dpu_hw_dspp(hw_dspp[i]);
+		cstate->mixers[i].hw_dspp = i < num_dspp ?
+			to_dpu_hw_dspp(hw_dspp[i]) : NULL;
 	}
 
 	cstate->num_mixers = num_lm;
@@ -1507,6 +1507,26 @@
 	return 0;
 }
 
+static bool dpu_crtc_needs_dspp(const struct drm_crtc_state *crtc_state)
+{
+	return crtc_state->ctm || crtc_state->gamma_lut;
+}
+
+static bool dpu_crtc_has_dspp(const struct drm_crtc_state *crtc_state)
+{
+	const struct dpu_crtc_state *cstate = to_dpu_crtc_state(crtc_state);
+	unsigned int i;
+
+	if (!cstate->num_mixers)
+		return false;
+
+	for (i = 0; i < cstate->num_mixers; i++)
+		if (!cstate->mixers[i].hw_dspp)
+			return false;
+
+	return true;
+}
+
 /**
  * dpu_crtc_check_mode_changed: check if full modeset is required
  * @old_crtc_state:	Previous CRTC state
@@ -1524,6 +1544,11 @@
 
 	DRM_DEBUG_ATOMIC("%d\n", crtc->base.id);
 
+	/* Reserve new DSPPs only when the encoder is reprogrammed too. */
+	if (dpu_crtc_needs_dspp(new_crtc_state) &&
+	    !dpu_crtc_has_dspp(old_crtc_state))
+		new_crtc_state->mode_changed = true;
+
 	/* there might be cases where encoder needs a modeset too */
 	drm_for_each_encoder_mask(drm_enc, crtc->dev, new_crtc_state->encoder_mask) {
 		if (dpu_encoder_needs_modeset(drm_enc, new_crtc_state->state))
@@ -1563,8 +1588,7 @@
 	}
 
 	/* don't reallocate resources if only ACTIVE has beeen changed */
-	if (crtc_state->mode_changed || crtc_state->connectors_changed ||
-	    crtc_state->color_mgmt_changed) {
+	if (crtc_state->mode_changed || crtc_state->connectors_changed) {
 		rc = dpu_crtc_assign_resources(crtc, crtc_state);
 		if (rc < 0)
 			return rc;
