From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Date: Sun, 25 Oct 2026 18:16:00 +0000
Subject: [PATCH] drm/msm/dp: retain the downstream HDMI clock budget

A DP-to-HDMI receiver can expose an HDMI monitor whose TMDS limit is lower
than the DP payload limit. Check both budgets during bpc selection and before
stream enable. DSC on the upstream leg must not admit an out-of-budget RGB
HDMI mode. An unknown HDMI limit preserves existing behavior; native DP sinks
retain their current DP-only budget. Six-bit source samples still consume an
eight-bit HDMI transport.

diff --git a/drivers/gpu/drm/msm/dp/dp_ctrl.c b/drivers/gpu/drm/msm/dp/dp_ctrl.c
index 7b9de12..7324af5 100644
--- a/drivers/gpu/drm/msm/dp/dp_ctrl.c
+++ b/drivers/gpu/drm/msm/dp/dp_ctrl.c
@@ -2630,6 +2630,11 @@ int msm_dp_ctrl_on_stream(struct msm_dp_ctrl *msm_dp_ctrl, struct msm_dp_panel *
 	ctrl = container_of(msm_dp_ctrl, struct msm_dp_ctrl_private, msm_dp_ctrl);
 
 	pixel_rate_orig = panel->msm_dp_mode.drm_mode.clock;
+	if (state && panel->connector->display_info.is_hdmi &&
+	    !msm_dp_utils_tmds_fits(pixel_rate_orig, panel->msm_dp_mode.bpp,
+			panel->connector->display_info.max_tmds_clock,
+			panel->msm_dp_mode.out_fmt_is_yuv_420))
+		return -ENOSPC;
 	if (state && !msm_dp_utils_link_fits(pixel_rate_orig, panel->msm_dp_mode.bpp,
 			ctrl->link->link_params.rate, ctrl->link->link_params.num_lanes,
 			panel->msm_dp_mode.out_fmt_is_yuv_420))
diff --git a/drivers/gpu/drm/msm/dp/dp_display.c b/drivers/gpu/drm/msm/dp/dp_display.c
index ab438f9..e022fde 100644
--- a/drivers/gpu/drm/msm/dp/dp_display.c
+++ b/drivers/gpu/drm/msm/dp/dp_display.c
@@ -1530,7 +1530,8 @@ int msm_dp_display_atomic_check(struct msm_dp *display,
 	bpp = msm_dp_utils_select_bpp(info->bpc, conn_state->max_requested_bpc ?: 8,
 			mode->clock, dp->panel->link_info.rate, dp->panel->link_info.num_lanes,
 			yuv420, state->hdr_enabled &&
-			state->hdr_sdp.db[2] != HDMI_EOTF_TRADITIONAL_GAMMA_SDR);
+			state->hdr_sdp.db[2] != HDMI_EOTF_TRADITIONAL_GAMMA_SDR,
+			info->is_hdmi ? info->max_tmds_clock : 0);
 	if (bpp < 0)
 		return bpp;
 	state->bpp = bpp;
diff --git a/drivers/gpu/drm/msm/dp/dp_utils.c b/drivers/gpu/drm/msm/dp/dp_utils.c
index d8c8b51..8a0fe67 100644
--- a/drivers/gpu/drm/msm/dp/dp_utils.c
+++ b/drivers/gpu/drm/msm/dp/dp_utils.c
@@ -103,9 +103,20 @@ bool msm_dp_utils_link_fits(unsigned int clock, unsigned int bpp,
 	return clock && bpp && rate && lanes && required <= available;
 }
 
+bool msm_dp_utils_tmds_fits(unsigned int clock, unsigned int bpp,
+			    unsigned int max_tmds_clock, bool yuv420)
+{
+	/* An RGB/4:4:4 HDMI link uses at least eight bits per component. */
+	u64 required = (u64)clock * max(bpp, 24U);
+	u64 available = (u64)max_tmds_clock * 24 * (yuv420 ? 2 : 1);
+
+	return clock && bpp && (!max_tmds_clock || required <= available);
+}
+
 int msm_dp_utils_select_bpp(unsigned int bpc, unsigned int max_bpc,
 			    unsigned int clock, unsigned int rate,
-			    unsigned int lanes, bool yuv420, bool hdr)
+			    unsigned int lanes, bool yuv420, bool hdr,
+			    unsigned int max_tmds_clock)
 {
 	unsigned int bpp;
 
@@ -115,7 +126,8 @@ int msm_dp_utils_select_bpp(unsigned int bpc, unsigned int max_bpc,
 	if (bpc < (hdr ? 10 : 6))
 		return -EINVAL;
 	for (bpp = bpc * 3; bpp >= (hdr ? 30 : 18); bpp -= 6)
-		if (msm_dp_utils_link_fits(clock, bpp, rate, lanes, yuv420))
+		if (msm_dp_utils_link_fits(clock, bpp, rate, lanes, yuv420) &&
+		    msm_dp_utils_tmds_fits(clock, bpp, max_tmds_clock, yuv420))
 			return bpp;
 	return -ENOSPC;
 }
diff --git a/drivers/gpu/drm/msm/dp/dp_utils.h b/drivers/gpu/drm/msm/dp/dp_utils.h
index eead1a6..9ab208e 100644
--- a/drivers/gpu/drm/msm/dp/dp_utils.h
+++ b/drivers/gpu/drm/msm/dp/dp_utils.h
@@ -37,9 +37,12 @@ void msm_dp_utils_pack_sdp_header(const struct dp_sdp_header *sdp_header,
 
 bool msm_dp_utils_link_fits(unsigned int clock, unsigned int bpp,
 			    unsigned int rate, unsigned int lanes, bool yuv420);
+bool msm_dp_utils_tmds_fits(unsigned int clock, unsigned int bpp,
+			    unsigned int max_tmds_clock, bool yuv420);
 int msm_dp_utils_select_bpp(unsigned int bpc, unsigned int max_bpc,
 			    unsigned int clock, unsigned int rate,
-			    unsigned int lanes, bool yuv420, bool hdr);
+			    unsigned int lanes, bool yuv420, bool hdr,
+			    unsigned int max_tmds_clock);
 int msm_dp_utils_pack_vsc_sdp(struct dp_sdp *sdp, enum drm_colorspace colorspace,
 			      unsigned int bpc, bool yuv420);
 int msm_dp_utils_pack_hdr_sdp(const struct drm_connector_state *conn_state,
