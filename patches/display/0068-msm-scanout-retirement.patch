diff --git a/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc_retire.c b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc_retire.c
new file mode 100644
index 0000000..54c4612
--- /dev/null
+++ b/drivers/gpu/drm/msm/disp/dpu1/dpu_crtc_retire.c
@@ -0,0 +1,329 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Deferred old-plane ownership; storage belongs to the old CRTC state. */
+#include <drm/drm_atomic.h>
+#include <drm/drm_atomic_helper.h>
+#include <drm/drm_crtc_helper.h>
+#include <drm/drm_modeset_helper_vtables.h>
+#include <drm/drm_plane_helper.h>
+#include <drm/drm_print.h>
+#include <drm/drm_vblank.h>
+#include <drm/drm_vblank_work.h>
+#include "dpu_crtc.h"
+
+static void dpu_crtc_retire_release(struct dpu_crtc_retire_work *work)
+{
+	struct drm_atomic_commit *state = work->state;
+	struct drm_crtc *crtc = work->crtc;
+	struct drm_plane_state *old;
+	struct drm_plane *plane;
+	int i;
+
+	work->state = NULL;
+	for_each_old_plane_in_state(state, plane, old, i) {
+		const struct drm_plane_helper_funcs *funcs = plane->helper_private;
+
+		if (old->fb && old->crtc == crtc && funcs->cleanup_fb)
+			funcs->cleanup_fb(plane, old);
+	}
+	drm_atomic_commit_put(state);
+}
+
+static void dpu_crtc_retire_work(struct kthread_work *base)
+{
+	struct dpu_crtc_retire_work *work = container_of(to_drm_vblank_work(base),
+						struct dpu_crtc_retire_work, work);
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(work->crtc)->retire;
+	unsigned long flags;
+	bool owned;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	owned = !list_empty(&work->node);
+	if (owned) {
+		list_del_init(&work->node);
+		work->scheduled = false;
+	}
+	spin_unlock_irqrestore(&pending->lock, flags);
+	if (owned)
+		dpu_crtc_retire_release(work);
+}
+
+void dpu_crtc_retire_init(struct drm_crtc *crtc)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+
+	spin_lock_init(&pending->lock);
+	INIT_LIST_HEAD(&pending->pending);
+	pending->off = true;
+}
+
+static void dpu_crtc_retire_quarantine(struct dpu_crtc_retire *pending)
+{
+	unsigned long flags;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	pending->quarantined = true;
+	spin_unlock_irqrestore(&pending->lock, flags);
+}
+
+void dpu_crtc_retire_prepare(struct drm_crtc *crtc,
+			     struct drm_atomic_commit *state)
+{
+	struct drm_crtc_state *old = drm_atomic_get_old_crtc_state(state, crtc);
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	struct dpu_crtc_retire_work *work;
+	unsigned long flags;
+
+	if (WARN_ON_ONCE(!old)) {
+		dpu_crtc_retire_quarantine(pending);
+		return;
+	}
+	work = &to_dpu_crtc_state(old)->retire;
+	if (WARN_ON_ONCE(work->prepared || work->state)) {
+		dpu_crtc_retire_quarantine(pending);
+		return;
+	}
+	INIT_LIST_HEAD(&work->node);
+	drm_vblank_work_init(&work->work, crtc, dpu_crtc_retire_work);
+	work->crtc = crtc;
+	work->scheduled = false;
+	work->prepared = true;
+	work->submitted = false;
+	spin_lock_irqsave(&pending->lock, flags);
+	work->epoch = pending->epoch;
+	work->flush = pending->flushed + 1;
+	spin_unlock_irqrestore(&pending->lock, flags);
+}
+
+static void dpu_crtc_retire_schedule(struct dpu_crtc_retire *pending,
+				    struct dpu_crtc_retire_work *work)
+{
+	int ret;
+
+	if (work->scheduled)
+		return;
+	ret = drm_vblank_work_schedule(&work->work, pending->vblank, false);
+	if (ret == 1)
+		work->scheduled = true;
+	else
+		pending->failed = true;
+}
+
+void dpu_crtc_retire_cleanup(struct drm_crtc *crtc,
+			     struct drm_atomic_commit *state)
+{
+	struct drm_crtc_state *old = drm_atomic_get_old_crtc_state(state, crtc);
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	struct dpu_crtc_retire_work *work;
+	unsigned long flags;
+	bool release = false;
+
+	if (WARN_ON_ONCE(!old)) {
+		dpu_crtc_retire_quarantine(pending);
+		drm_atomic_commit_get(state);
+		return;
+	}
+	work = &to_dpu_crtc_state(old)->retire;
+	if (WARN_ON_ONCE(work->submitted))
+		return;
+	if (WARN_ON_ONCE(!work->prepared || work->crtc != crtc)) {
+		dpu_crtc_retire_quarantine(pending);
+		drm_atomic_commit_get(state);
+		return;
+	}
+	work->submitted = true;
+	work->state = drm_atomic_commit_get(state);
+	spin_lock_irqsave(&pending->lock, flags);
+	if (pending->epoch != work->epoch || pending->off) {
+		release = true;
+	} else if (pending->stopping || pending->quarantined) {
+		/* Unproved teardown: keep the state and pins until recovery. */
+		pending->failed = true;
+	} else if (pending->flushed >= work->flush &&
+		   !pending->failed && pending->one_shot) {
+		release = true;
+	} else {
+		list_add_tail(&work->node, &pending->pending);
+		if (pending->flushed >= work->flush && !pending->failed)
+			dpu_crtc_retire_schedule(pending, work);
+	}
+	spin_unlock_irqrestore(&pending->lock, flags);
+	if (release)
+		dpu_crtc_retire_release(work);
+}
+
+void dpu_crtc_retire_flush(struct drm_crtc *crtc, bool valid, bool one_shot)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	struct dpu_crtc_retire_work *work, *next;
+	LIST_HEAD(release);
+	unsigned long flags;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	if (!valid || pending->stopping || pending->quarantined) {
+		pending->failed = true;
+		if (!valid)
+			pending->quarantined = true;
+		spin_unlock_irqrestore(&pending->lock, flags);
+		return;
+	}
+	pending->failed = false;
+	pending->flushed++;
+	pending->one_shot = one_shot;
+	pending->vblank = drm_crtc_vblank_count(crtc) + 1;
+	list_for_each_entry_safe(work, next, &pending->pending, node) {
+		if (work->scheduled || work->flush > pending->flushed)
+			continue;
+		if (one_shot)
+			list_move_tail(&work->node, &release);
+		else
+			dpu_crtc_retire_schedule(pending, work);
+	}
+	spin_unlock_irqrestore(&pending->lock, flags);
+	list_for_each_entry_safe(work, next, &release, node) {
+		list_del_init(&work->node);
+		dpu_crtc_retire_release(work);
+	}
+}
+
+static void dpu_crtc_retire_drain(struct drm_crtc *crtc, bool stopped)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	struct dpu_crtc_retire_work *work;
+	unsigned long flags;
+	bool ready;
+
+	for (;;) {
+		spin_lock_irqsave(&pending->lock, flags);
+		work = list_first_entry_or_null(&pending->pending,
+					      struct dpu_crtc_retire_work, node);
+		if (work)
+			list_del_init(&work->node);
+		spin_unlock_irqrestore(&pending->lock, flags);
+		if (!work)
+			break;
+		if (work->scheduled)
+			drm_vblank_work_cancel_sync(&work->work);
+		work->scheduled = false;
+		if (stopped)
+			dpu_crtc_retire_release(work);
+		else
+			drm_warn(crtc->dev,
+				"Retaining old scanout after unproved teardown\n");
+	}
+	spin_lock_irqsave(&pending->lock, flags);
+	ready = pending->vblank_ready;
+	spin_unlock_irqrestore(&pending->lock, flags);
+	/* Partial KMS initialization can unwind before DRM creates its workers. */
+	if (ready)
+		drm_vblank_work_flush_all(crtc);
+}
+
+void dpu_crtc_retire_vblank_on(struct drm_crtc *crtc)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	unsigned long flags;
+
+	drm_crtc_vblank_on(crtc);
+	spin_lock_irqsave(&pending->lock, flags);
+	pending->off = false;
+	pending->vblank_ready = true;
+	spin_unlock_irqrestore(&pending->lock, flags);
+}
+
+void dpu_crtc_retire_vblank_off(struct drm_crtc *crtc, bool stopped)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	unsigned long flags;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	if (stopped) {
+		pending->off = true;
+		pending->epoch++;
+		pending->failed = false;
+	} else {
+		pending->off = false;
+		pending->failed = true;
+		pending->quarantined = true;
+	}
+	spin_unlock_irqrestore(&pending->lock, flags);
+	dpu_crtc_retire_drain(crtc, stopped);
+	drm_crtc_vblank_off(crtc);
+}
+
+void dpu_crtc_retire_fini(struct drm_crtc *crtc)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	unsigned long flags;
+	bool stopped;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	pending->stopping = true;
+	stopped = pending->off;
+	spin_unlock_irqrestore(&pending->lock, flags);
+	dpu_crtc_retire_drain(crtc, stopped);
+}
+
+int dpu_crtc_retire_check(struct drm_crtc *crtc,
+			  struct drm_crtc_state *state)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	unsigned long flags;
+	bool failed, blocked;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	failed = pending->failed;
+	blocked = pending->stopping || pending->quarantined;
+	spin_unlock_irqrestore(&pending->lock, flags);
+	return blocked || (failed && !drm_atomic_crtc_needs_modeset(state)) ?
+		-EIO : 0;
+}
+
+bool dpu_crtc_retire_quarantined(struct drm_crtc *crtc)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	unsigned long flags;
+	bool blocked;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	blocked = pending->stopping || pending->quarantined;
+	spin_unlock_irqrestore(&pending->lock, flags);
+	return blocked;
+}
+
+bool dpu_crtc_retire_failed(struct drm_crtc *crtc)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	unsigned long flags;
+	bool failed;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	failed = pending->failed;
+	spin_unlock_irqrestore(&pending->lock, flags);
+	return failed;
+}
+
+void dpu_crtc_retire_wait_status(struct drm_crtc *crtc, int error)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	unsigned long flags;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	if (error) {
+		pending->failed = true;
+		/* Hardware ownership is unknown; a cleared software count is no proof. */
+		pending->quarantined = true;
+	}
+	spin_unlock_irqrestore(&pending->lock, flags);
+}
+
+bool dpu_crtc_retire_stopped(struct drm_crtc *crtc)
+{
+	struct dpu_crtc_retire *pending = &to_dpu_crtc(crtc)->retire;
+	unsigned long flags;
+	bool stopped;
+
+	spin_lock_irqsave(&pending->lock, flags);
+	stopped = pending->off;
+	spin_unlock_irqrestore(&pending->lock, flags);
+	return stopped;
