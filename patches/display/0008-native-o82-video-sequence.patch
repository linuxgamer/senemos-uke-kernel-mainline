From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH] drm/msm/dsi: start O82 video after panel ON and PPS

Xiaomi Uke display 44275c404a677d9d9e5230fedd1af2ef02fc7b9a,
msm/dsi/dsi_display.c:9189-9255 (GPL-2.0-only), sends panel ON and PPS
before enabling the video engine. The O82 panel requires the host powered
before its prepare callback. Upstream's DSI manager also enables video in
pre_enable, so that flag currently starts video before O82 reset/ON/PPS.

For the exact Uke/SM7675 and O82 compatible pair, retain host/PHY power and
IRQs in pre_enable, but defer video to enable after successful panel prepare.
Stop video in reverse link order before panel unprepare, and power off only
hosts actually powered by this bridge. Other panels retain the existing
pre_enable/post_disable path. Keep this native-only candidate separate from
the normal framebuffer profile; the ordering gap is source evidence, not a
confirmed explanation of the current physical black screen.

--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -4,6 +4,8 @@
  */
 
 #include "drm/drm_bridge_connector.h"
+#include <drm/drm_panel.h>
+#include <linux/of_graph.h>
 
 #include "msm_kms.h"
 #include "dsi.h"
@@ -198,6 +200,9 @@
 struct dsi_bridge {
 	struct drm_bridge base;
 	int id;
+	struct drm_panel *o82_panel;
+	bool powered;
+	bool video_enabled;
 };
 
 #define to_dsi_bridge(x) container_of(x, struct dsi_bridge, base)
@@ -275,8 +280,7 @@
 	dsi_mgr_phy_disable(id);
 }
 
-static void dsi_mgr_bridge_pre_enable(struct drm_bridge *bridge,
-				      struct drm_atomic_commit *commit)
+static int dsi_mgr_bridge_enable_hosts(struct drm_bridge *bridge)
 {
 	int id = dsi_mgr_bridge_get_id(bridge);
 	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
@@ -284,18 +289,6 @@
 	bool is_bonded_dsi = IS_BONDED_DSI();
 	int ret;
 
-	DBG("id=%d", id);
-
-	/* Do nothing with the host if it is slave-DSI in case of bonded DSI */
-	if (is_bonded_dsi && !IS_MASTER_DSI_LINK(id))
-		return;
-
-	ret = dsi_mgr_bridge_power_on(bridge);
-	if (ret) {
-		dev_err(&msm_dsi->pdev->dev, "Power on failed: %d\n", ret);
-		return;
-	}
-
 	ret = msm_dsi_host_enable(host);
 	if (ret) {
 		pr_err("%s: enable host %d failed, %d\n", __func__, id, ret);
@@ -310,12 +303,75 @@
 		}
 	}
 
-	return;
+	return 0;
 
 host1_en_fail:
 	msm_dsi_host_disable(host);
 host_en_fail:
-	dsi_mgr_bridge_power_off(bridge);
+	return ret;
+}
+
+static void dsi_mgr_bridge_pre_enable(struct drm_bridge *bridge,
+				      struct drm_atomic_commit *commit)
+{
+	struct dsi_bridge *dsi_bridge = to_dsi_bridge(bridge);
+	int id = dsi_mgr_bridge_get_id(bridge);
+	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
+	int ret;
+
+	if (IS_BONDED_DSI() && !IS_MASTER_DSI_LINK(id))
+		return;
+
+	ret = dsi_mgr_bridge_power_on(bridge);
+	if (ret) {
+		dev_err(&msm_dsi->pdev->dev, "Power on failed: %d\n", ret);
+		return;
+	}
+
+	if (dsi_bridge->o82_panel) {
+		/* O82 reset, ON commands and PPS must precede video traffic. */
+		dsi_bridge->powered = true;
+		return;
+	}
+
+	if (dsi_mgr_bridge_enable_hosts(bridge))
+		dsi_mgr_bridge_power_off(bridge);
+}
+
+static void dsi_mgr_bridge_enable(struct drm_bridge *bridge,
+				      struct drm_atomic_commit *commit)
+{
+	struct dsi_bridge *dsi_bridge = to_dsi_bridge(bridge);
+
+	if (!dsi_bridge->o82_panel || !dsi_bridge->powered ||
+	    !dsi_bridge->o82_panel->prepared)
+		return;
+
+	if (!dsi_mgr_bridge_enable_hosts(bridge))
+		dsi_bridge->video_enabled = true;
+}
+
+static void dsi_mgr_bridge_disable(struct drm_bridge *bridge,
+				      struct drm_atomic_commit *commit)
+{
+	struct dsi_bridge *dsi_bridge = to_dsi_bridge(bridge);
+	int id = dsi_mgr_bridge_get_id(bridge);
+	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
+	struct msm_dsi *msm_dsi1 = dsi_mgr_get_dsi(DSI_1);
+	int ret;
+
+	if (!dsi_bridge->video_enabled)
+		return;
+
+	if (IS_BONDED_DSI() && msm_dsi1) {
+		ret = msm_dsi_host_disable(msm_dsi1->host);
+		if (ret)
+			pr_err("%s: host1 disable failed, %d\n", __func__, ret);
+	}
+	ret = msm_dsi_host_disable(msm_dsi->host);
+	if (ret)
+		pr_err("%s: host %d disable failed, %d\n", __func__, id, ret);
+	dsi_bridge->video_enabled = false;
 }
 
 void msm_dsi_manager_tpg_enable(void)
@@ -333,7 +386,8 @@
 
 static void dsi_mgr_bridge_post_disable(struct drm_bridge *bridge,
 					struct drm_atomic_commit *commit)
 {
+	struct dsi_bridge *dsi_bridge = to_dsi_bridge(bridge);
 	int id = dsi_mgr_bridge_get_id(bridge);
 	struct msm_dsi *msm_dsi = dsi_mgr_get_dsi(id);
 	struct msm_dsi *msm_dsi1 = dsi_mgr_get_dsi(DSI_1);
@@ -350,6 +404,16 @@
 	if (is_bonded_dsi && !IS_MASTER_DSI_LINK(id))
 		goto disable_phy;
 
+	if (dsi_bridge->o82_panel) {
+		if (dsi_bridge->powered) {
+			dsi_mgr_bridge_disable(bridge, commit);
+			msm_dsi_phy_pll_save_state(msm_dsi->phy);
+			dsi_mgr_bridge_power_off(bridge);
+			dsi_bridge->powered = false;
+		}
+		return;
+	}
+
 	ret = msm_dsi_host_disable(host);
 	if (ret)
 		pr_err("%s: host %d disable failed, %d\n", __func__, id, ret);
@@ -447,14 +511,34 @@
 static const struct drm_bridge_funcs dsi_mgr_bridge_funcs = {
 	.atomic_create_state = drm_atomic_helper_bridge_create_state,
 	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
 	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
 	.attach = dsi_mgr_bridge_attach,
 	.atomic_pre_enable = dsi_mgr_bridge_pre_enable,
+	.atomic_enable = dsi_mgr_bridge_enable,
+	.atomic_disable = dsi_mgr_bridge_disable,
 	.atomic_post_disable = dsi_mgr_bridge_post_disable,
 	.mode_set = dsi_mgr_bridge_mode_set,
 	.mode_valid = dsi_mgr_bridge_mode_valid,
 };
 
+static struct drm_panel *dsi_mgr_o82_panel(struct msm_dsi *msm_dsi)
+{
+	struct device_node *node;
+	struct drm_panel *panel = NULL;
+
+	if (!of_machine_is_compatible("xiaomi,uke") ||
+	    !of_machine_is_compatible("qcom,sm7675") ||
+	    !(msm_dsi_host_get_mode_flags(msm_dsi->host) & MIPI_DSI_MODE_VIDEO))
+		return NULL;
+
+	node = of_graph_get_remote_node(msm_dsi->pdev->dev.of_node, 1, -1);
+	if (of_device_is_compatible(node, "xiaomi,o82-36-02-0a") ||
+	    of_device_is_compatible(node, "xiaomi,o82-42-02-0b"))
+		panel = of_drm_find_panel(node);
+	of_node_put(node);
+	return panel;
+}
+
 /* initialize bridge */
 int msm_dsi_manager_connector_init(struct msm_dsi *msm_dsi,
 				   struct drm_encoder *encoder)
@@ -468,6 +552,9 @@
 		return PTR_ERR(dsi_bridge);
 
 	dsi_bridge->id = msm_dsi->id;
+	dsi_bridge->o82_panel = dsi_mgr_o82_panel(msm_dsi);
+	if (IS_ERR(dsi_bridge->o82_panel))
+		return PTR_ERR(dsi_bridge->o82_panel);
 
 	bridge = &dsi_bridge->base;
 
--
2.53.0
