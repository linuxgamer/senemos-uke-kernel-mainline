index b0cff54..003a475 100644
--- a/drivers/gpu/drm/msm/dsi/dsi_manager.c
+++ b/drivers/gpu/drm/msm/dsi/dsi_manager.c
@@ -7,6 +7,8 @@
 #include <drm/drm_panel.h>
 #include <drm/uke-o82-mode.h>
 #include <linux/of_graph.h>
+#include <linux/debugfs.h>
+#include <linux/seq_file.h>
 #include <linux/qcom-uke-display.h>
 
 #include "msm_kms.h"
@@ -573,7 +575,37 @@ static int dsi_mgr_bridge_attach(struct drm_bridge *bridge,
 				 bridge, flags);
 }
 
+static int dsi_mgr_output_bits_show(struct seq_file *seq, void *unused)
+{
+	struct dsi_bridge *bridge = seq->private;
+	struct msm_dsi *dsi = dsi_mgr_get_dsi(bridge->id);
+	const struct drm_dsc_config *dsc;
+	bool active = READ_ONCE(bridge->video_enabled);
+	unsigned int bpc = 0, wire_bpp_x16 = 0;
+
+	dsc = dsi ? msm_dsi_host_get_dsc_config(dsi->host) : NULL;
+	if (active && dsc) {
+		bpc = dsc->bits_per_component;
+		wire_bpp_x16 = dsc->bits_per_pixel;
+	}
+	seq_printf(seq, "version=1 active=%u bpc=%u bpp=%u dsc_bpp_x16=%u\n",
+		   active, bpc, bpc * 3, wire_bpp_x16);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(dsi_mgr_output_bits);
+
+static void dsi_mgr_bridge_debugfs_init(struct drm_bridge *bridge,
+				      struct dentry *root)
+{
+	struct dsi_bridge *dsi_bridge = to_dsi_bridge(bridge);
+
+	if (dsi_bridge->o82_panel)
+		debugfs_create_file("output_bits", 0444, root, dsi_bridge,
+				    &dsi_mgr_output_bits_fops);
+}
+
 static const struct drm_bridge_funcs dsi_mgr_bridge_funcs = {
+	.debugfs_init = dsi_mgr_bridge_debugfs_init,
 	.atomic_create_state = drm_atomic_helper_bridge_create_state,
 	.atomic_destroy_state = drm_atomic_helper_bridge_destroy_state,
 	.atomic_duplicate_state = drm_atomic_helper_bridge_duplicate_state,
