 };
 
+static int msm_dp_output_bits_show(struct seq_file *seq, void *unused)
+{
+	struct msm_dp_debug_private *debug = seq->private;
+	bool active = READ_ONCE(debug->display->power_on);
+	unsigned int bpp = active ? READ_ONCE(debug->panel->msm_dp_mode.bpp) : 0;
+
+	seq_printf(seq, "version=1 active=%u bpc=%u bpp=%u dsc_bpp_x16=0\n",
+		   active, bpp / 3, bpp);
+	return 0;
+}
+DEFINE_SHOW_ATTRIBUTE(msm_dp_output_bits);
+
