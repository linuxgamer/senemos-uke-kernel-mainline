+static int msm_dp_ctrl_fec_enable(struct msm_dp_ctrl_private *ctrl,
+				  struct msm_dp_panel *panel)
+{
+	u8 status;
+	unsigned int i;
+	int ret;
+	u32 value;
+
+	if (!ctrl->fec_prepared)
+		return 0;
+	for (i = 0; i < 3; i++) {
+		value = msm_dp_read_link(ctrl, REG_DP_MAINLINK_CTRL);
+		msm_dp_write_link(ctrl, REG_DP_MAINLINK_CTRL,
+			value | BIT(12) | BIT(22) | BIT(23) | BIT(24) | BIT(25));
+		usleep_range(900, 1000);
+		ret = drm_dp_dpcd_read_byte(ctrl->aux, DP_FEC_STATUS, &status);
+		if (ret)
+			return ret;
+		if (!(status & DP_FEC_DECODE_EN_DETECTED))
+			continue;
+		ret = drm_dp_dpcd_write_byte(ctrl->aux, DP_DSC_ENABLE, DP_DECOMPRESSION_EN);
+		if (!ret)
+			WRITE_ONCE(panel->dsc_active, true);
+		return ret;
+	}
+	return -ETIMEDOUT;
+}
+
+static int msm_dp_ctrl_fec_disable(struct msm_dp_ctrl_private *ctrl,
+				    struct msm_dp_panel *panel)
+{
+	int ret, first_error;
+
+	WRITE_ONCE(panel->dsc_active, false);
+	if (!ctrl->fec_prepared)
+		return 0;
+	if (ctrl->link_clks_on)
+		msm_dp_write_link(ctrl, REG_DP_MAINLINK_CTRL,
+			msm_dp_read_link(ctrl, REG_DP_MAINLINK_CTRL) & ~BIT(12));
+	ret = drm_dp_dpcd_write_byte(ctrl->aux, DP_DSC_ENABLE, 0);
+	first_error = ret;
+	if (ret && msm_dp_aux_is_link_connected(ctrl->aux))
+		drm_dbg_dp(ctrl->drm_dev, "DSC receiver disable failed: %d\n", ret);
+	ret = drm_dp_dpcd_write_byte(ctrl->aux, DP_FEC_CONFIGURATION, 0);
+	if (ret && msm_dp_aux_is_link_connected(ctrl->aux))
+		drm_dbg_dp(ctrl->drm_dev, "FEC receiver disable failed: %d\n", ret);
+	ctrl->fec_prepared = first_error || ret;
+	return first_error ? first_error : ret;
+}
