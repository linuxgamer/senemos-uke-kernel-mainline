+void msm_dp_panel_config_dsc(struct msm_dp_panel *msm_dp_panel)
+{
+	struct msm_dp_panel_private *panel =
+		container_of(msm_dp_panel, struct msm_dp_panel_private, msm_dp_panel);
+	const struct msm_dp_dsc_config *config = &msm_dp_panel->dsc;
+	struct drm_dsc_picture_parameter_set pps;
+	struct dp_sdp_header header;
+	u8 parity[28] = {}, *payload = (u8 *)&pps, *hb = (u8 *)&header;
+	u8 header_parity[4];
+	unsigned int i;
+	u32 flush;
+
+	BUILD_BUG_ON(REG_DP_PPS_DATA + MSM_DP_DSC_RGB_PPS_BYTES > MMSS_DP_AUDIO_CFG);
+	msm_dp_panel_clear_dsc_dto(msm_dp_panel);
+	msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, 0);
+	if (!config->dsc.bits_per_pixel)
+		return;
+	drm_dsc_pps_payload_pack(&pps, &config->dsc);
+	drm_dsc_dp_pps_header_init(&header);
+	for (i = 0; i < 4; i++)
+		header_parity[i] = msm_dp_utils_calculate_parity(hb[i]);
+	/* Only 88 RGB PPS bytes have registers; the reserved packet tail is padded. */
+	for (i = 0; i < MSM_DP_DSC_RGB_PPS_BYTES / 4; i++)
+		parity[i] = msm_dp_dsc_word_parity(get_unaligned_le32(payload + i * 4));
+	msm_dp_write_link(panel, REG_DP_PPS_HEADER, get_unaligned_le32(hb));
+	msm_dp_write_link(panel, REG_DP_PPS_HEADER_PARITY, get_unaligned_le32(header_parity));
+	for (i = 0; i < sizeof(parity) / 4; i++)
+		msm_dp_write_link(panel, REG_DP_PPS_PARITY + i * 4,
+				  get_unaligned_le32(parity + i * 4));
+	for (i = 0; i < MSM_DP_DSC_RGB_PPS_BYTES / 4; i++)
+		msm_dp_write_link(panel, REG_DP_PPS_DATA + i * 4,
+				  get_unaligned_le32(payload + i * 4));
+	msm_dp_write_p0(panel, MMSS_DP_DSC_DTO_COUNT, config->dto_count);
+	/* 8 compressed bpp on the two-pixel RGB interface uses the OEM 1/3 DTO. */
+	msm_dp_write_p0(panel, MMSS_DP_DSC_DTO, BIT(0) | BIT(3) | (1 << 8) | (3 << 16));
+	msm_dp_write_link(panel, REG_DP_COMPRESSION_MODE_CTRL, config->compression_ctrl);
+	flush = msm_dp_read_link(panel, REG_DP_SDP_FLUSH);
+	msm_dp_write_link(panel, REG_DP_SDP_FLUSH, flush | BIT(2));
+}
