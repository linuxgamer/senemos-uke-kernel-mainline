# Uke/SM7675 source-build candidate. Hardware acceptance remains untested.
CONFIG_ARCH_QCOM=y
CONFIG_PINCTRL_CLIFFS=y
CONFIG_PINCTRL_PALAWAN_LPASS_LPI=m
CONFIG_SM_GCC_CLIFFS=y
CONFIG_SM_GPUCC_CLIFFS=m
CONFIG_BACKLIGHT_KTZ8866=m
# The built-in firmware DRM driver must reach the optional backlight helpers.
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_QCOM_GDSC_REGULATOR_UKE=y
CONFIG_INTERCONNECT_QCOM_CLIFFS_USB=y
CONFIG_QCOM_RPMH=y
CONFIG_QCOM_RPMH_UKE=y
CONFIG_REGULATOR_QCOM_RPMH_UKE=y
CONFIG_SPMI=y
CONFIG_SPMI_MSM_PMIC_ARB=y
CONFIG_MFD_SPMI_PMIC=y
CONFIG_QCOM_SCM=y
CONFIG_QCOM_SMEM=y
CONFIG_PSTORE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_CONSOLE=y
# Expose standard pm_test stages and suspend timing for controlled bring-up.
# This does not enable automatic sleep or select an unqualified deep state.
CONFIG_SUSPEND=y
CONFIG_PM_DEBUG=y
CONFIG_PM_SLEEP_DEBUG=y
CONFIG_I2C_QCOM_GENI=m
CONFIG_QCOM_GPI_DMA=m
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=m
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_QCOM=m
CONFIG_USB_PHY_QCOM_UKE=m
CONFIG_USB_REPEATER=y
CONFIG_USB_REPEATER_QCOM_UKE=m
CONFIG_USB_WCD939X_UKE=y
CONFIG_RESET_CONTROLLER=y
CONFIG_USB_G_SERIAL=m
CONFIG_USB_F_ACM=m
CONFIG_USB_F_SERIAL=m
CONFIG_FB=y
# CONFIG_FB_SIMPLE is not set
CONFIG_FB_EFI=y
CONFIG_SYSFB_SIMPLEFB=y
# Firmware scanout for software Wayland; this does not enable Adreno rendering.
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_INPUT_UINPUT=m
# BlueZ HID-over-GATT publishes Bluetooth LE input through UHID.
CONFIG_UHID=m
CONFIG_HIDRAW=y
CONFIG_HID_BATTERY_STRENGTH=y
CONFIG_BT_RFCOMM=m
CONFIG_BT_RFCOMM_TTY=y
# CONFIG_FRAMEBUFFER_CONSOLE_DEFERRED_TAKEOVER is not set
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FONTS=y
CONFIG_FONT_TER16x32=y
CONFIG_MAGIC_SYSRQ=y
CONFIG_PRINTK_TIME=y
CONFIG_LOG_BUF_SHIFT=21

CONFIG_INPUT_QCOM_SMP2P_SWITCH=m

CONFIG_SND_SOC_UKE=m
CONFIG_SND_SOC_FS19XX=m
CONFIG_PINCTRL_SM8650_LPASS_LPI=m
CONFIG_SND_SEQUENCER=m

CONFIG_FM19511_UKE=m
CONFIG_RC_CORE=m
CONFIG_RC_DEVICES=y
CONFIG_LIRC=y
CONFIG_IR_SPI=m
