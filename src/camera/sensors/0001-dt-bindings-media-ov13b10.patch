From: Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
Subject: [PATCH 1/2] dt-bindings: media: describe the OV13B10 sensor

Describe the existing driver's 19.2 MHz clock, three supplies and two/four
CSI-2 lanes with a 560 MHz link frequency. The generic example is separate
from any Uke board wiring, fitted-sensor identity or calibration claim.
Include the binding in the sensor's existing maintainer entry.

---
 .../bindings/media/i2c/ovti,ov13b10.yaml           |  107 ++++++++++++++++++++
 MAINTAINERS                                        |    1 
 2 files changed, 108 insertions(+)
diff --git a/Documentation/devicetree/bindings/media/i2c/ovti,ov13b10.yaml b/Documentation/devicetree/bindings/media/i2c/ovti,ov13b10.yaml
new file mode 100644
index 0000000..cf8a2cb
--- /dev/null
+++ b/Documentation/devicetree/bindings/media/i2c/ovti,ov13b10.yaml
@@ -0,0 +1,107 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/media/i2c/ovti,ov13b10.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: OmniVision OV13B10 image sensor
+
+maintainers:
+  - Senemos Maintainers <75160848+MCC45TR@users.noreply.github.com>
+
+description:
+  CMOS image sensor using a two-lane or four-lane MIPI CSI-2 D-PHY interface.
+  The driver requires a 19.2 MHz external clock and a 560 MHz link frequency.
+
+allOf:
+  - $ref: /schemas/media/video-interface-devices.yaml#
+
+properties:
+  compatible:
+    const: ovti,ov13b10
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    maxItems: 1
+    description: External sensor clock, operating at 19.2 MHz.
+
+  avdd-supply:
+    description: Analog circuit supply.
+
+  dovdd-supply:
+    description: Digital I/O supply.
+
+  dvdd-supply:
+    description: Digital core supply.
+
+  reset-gpios:
+    maxItems: 1
+    description: Active-low XSHUTDOWN signal.
+
+  port:
+    $ref: /schemas/graph.yaml#/$defs/port-base
+    additionalProperties: false
+    properties:
+      endpoint:
+        $ref: /schemas/media/video-interfaces.yaml#
+        additionalProperties: false
+        properties:
+          data-lanes:
+            oneOf:
+              - items:
+                  - const: 1
+                  - const: 2
+              - items:
+                  - const: 1
+                  - const: 2
+                  - const: 3
+                  - const: 4
+          link-frequencies:
+            items:
+              - const: 560000000
+          remote-endpoint: true
+        required:
+          - data-lanes
+          - link-frequencies
+          - remote-endpoint
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - avdd-supply
+  - dovdd-supply
+  - dvdd-supply
+  - port
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    i2c {
+        #address-cells = <1>;
+        #size-cells = <0>;
+
+        camera@36 {
+            compatible = "ovti,ov13b10";
+            reg = <0x36>;
+            clocks = <&sensor_clock>;
+            avdd-supply = <&sensor_analog>;
+            dovdd-supply = <&sensor_io>;
+            dvdd-supply = <&sensor_core>;
+            reset-gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
+
+            port {
+                endpoint {
+                    remote-endpoint = <&csi_input>;
+                    data-lanes = <1 2 3 4>;
+                    link-frequencies = /bits/ 64 <560000000>;
+                };
+            };
+        };
+    };
+...
diff --git a/MAINTAINERS b/MAINTAINERS
index 95cd976..9b93cda 100644
--- a/MAINTAINERS
+++ b/MAINTAINERS
@@ -19963,6 +19963,7 @@ M:	Arec Kao <arec.kao@intel.com>
 L:	linux-media@vger.kernel.org
 S:	Maintained
 T:	git git://linuxtv.org/media.git
